import FreeProducts.AVLvsVL.Coproducts.NonPolyhedralPartner
import FreeProducts.AVLvsVL.Classical.Projectivity

/-!
# Equivalences for preservation of Archimedeanity by coproducts

For finitely generated Archimedean lattices, projectivity characterizes agreement
of ordinary and Archimedean coproducts with every finitely generated Archimedean partner.
For arbitrary Archimedean lattices, the corresponding condition is local projectivity.
-/

universe u

namespace VectorLattice

variable (X : Type u) [AddCommGroup X] [Lattice X]
  [IsOrderedAddMonoid X] [VectorLattice X]

open ConeRepresentation

/-- If free products with all finitely generated Archimedean partners stay Archimedean, every
cone representing the lattice is polyhedral. -/
private lemma polyhedral_of_archimedean_free_products [IsVLArchimedean X]
    (h : ∀ (Y : Type u) [AddCommGroup Y] [Lattice Y]
      [IsOrderedAddMonoid Y] [VectorLattice Y] [IsVLArchimedean Y],
      IsFinitelyGenerated Y → HasArchimedeanFreeProduct X Y) :
    ∀ (k : ℕ) (K : ClosedCone k), Nonempty (VecLatEquiv X (ConeFunctions K)) →
      IsClosedPolyhedralCone K.carrier := by
  rintro k K ⟨eK⟩
  by_contra hK
  obtain ⟨D, hstrict⟩ := exists_partner_strict_productRelationsIdeal K hK
  let Y := ULift.{u} (ConeFunctions D)
  let eY : VecLatEquiv Y (ConeFunctions D) := uliftEquiv _
  let : IsVLArchimedean Y :=
    archimedean_of_injective eY.toVecLatHom eY.toLinearEquiv.injective
  have hY : IsFinitelyGenerated Y := finitely_generated_of_surjective (ConeFunctions D)
    ⟨k + 1, coordinate D, generated_range_coordinate D⟩ eY.symm.toVecLatHom
    eY.toLinearEquiv.symm.surjective
  obtain ⟨P⟩ := nonempty_freeProduct (binaryFamily X Y)
  have hP : IsVLArchimedean P.Carrier := h Y hY P
  have hc := (binary_cone_product_archimedean_iff P K D eK eY).mp hP
  exact hstrict.not_ge ((vanishingIdeal_le_productRelationsIdeal_iff K D).mpr hc)

/-- A lattice represented on a polyhedral cone has an Archimedean ordinary free product with
every finitely generated Archimedean partner. -/
private lemma archimedean_free_product_of_polyhedral {n : ℕ} (C : ClosedCone n)
    (e : VecLatEquiv X (ConeFunctions C)) (hC : IsClosedPolyhedralCone C.carrier)
    (Y : Type u) [AddCommGroup Y] [Lattice Y] [IsOrderedAddMonoid Y]
    [VectorLattice Y] [IsVLArchimedean Y] (hY : IsFinitelyGenerated Y) :
    HasArchimedeanFreeProduct X Y := by
  change ∀ P : FreeProduct (binaryFamily X Y), IsVLArchimedean P.Carrier
  obtain ⟨k, v, hv⟩ := hY
  obtain ⟨D, eD, _⟩ := exists_cone_representation Y v hv
  intro P
  exact (binary_cone_product_archimedean_iff (E := binaryFamily X Y) P C D e eD).mpr
    (hasPolyhedralCover_of_polyhedral C D hC)

/-- For finitely generated Archimedean lattices, preservation of
Archimedeanity, free embeddability, projectivity, finite presentation,
and polyhedrality of every representing cone are equivalent. -/
theorem finitely_generated_archimedean_tfae [IsVLArchimedean X]
    (hX : IsFinitelyGenerated X) :
    List.TFAE [
      (∀ (Y : Type u) [AddCommGroup Y] [Lattice Y]
        [IsOrderedAddMonoid Y] [VectorLattice Y] [IsVLArchimedean Y],
        IsFinitelyGenerated Y → HasArchimedeanFreeProduct X Y),
      (∃ (α : Type u) (T : VecLatHom X (FVL α)), Function.Injective T),
      IsProjective X,
      IsFinitelyPresented X,
      (∀ (n : ℕ) (C : ClosedCone n),
        Nonempty (VecLatEquiv X (ConeFunctions C)) →
          IsClosedPolyhedralCone C.carrier)
    ] := by
  have hclassical := finitely_generated_projective_tfae X hX
  obtain ⟨n, g, hg⟩ := hX
  obtain ⟨C, e, _⟩ := exists_cone_representation X g hg
  tfae_have 2 ↔ 3 := hclassical.out 1 2
  tfae_have 3 ↔ 4 := hclassical.out 2 3
  tfae_have 4 ↔ 5 := hclassical.out 3 4
  tfae_have 1 ↔ 5 := by
    constructor
    · exact polyhedral_of_archimedean_free_products X
    · intro h Y _ _ _ _ _ hY
      exact archimedean_free_product_of_polyhedral X C e (h n C ⟨e⟩) Y hY
  tfae_finish

/-- The sublattice generated by a finite family is finitely generated as a vector lattice in
its own right. -/
private lemma finitely_generated_generated {n : ℕ} (g : Fin n → X) :
    IsFinitelyGenerated (VectorSublattice.generated (Set.range g)) := by
  let S := VectorSublattice.generated (Set.range g)
  let v (i : Fin n) : S := ⟨g i, VectorSublattice.subset_generated _ ⟨i, rfl⟩⟩
  refine ⟨n, v, le_antisymm (fun _ _ ↦ VectorSublattice.mem_top) (fun x _ ↦ ?_)⟩
  obtain ⟨e, he⟩ : ∃ e : LLexpr n, LLexpr.eval g e = x.val :=
    (LLexpr.generated_range_eq_combinations g).le x.property
  have hv : LLexpr.eval v e = x := by
    apply Subtype.ext
    change S.subtype (LLexpr.eval v e) = x.val
    rw [LLexpr.map_eval]
    exact he
  exact hv ▸ (LLexpr.generated_range_eq_combinations v).ge ⟨e, rfl⟩

section FinitePieces

variable {I : Type u} {E : I → Type u}
  [∀ i, AddCommGroup (E i)] [∀ i, Lattice (E i)]
  [∀ i, IsOrderedAddMonoid (E i)] [∀ i, VectorLattice (E i)]

/-- The canonical factor inclusions generate every element of the ordinary free product. -/
private lemma mem_generated_inclusions (P : FreeProduct E) (x : P.Carrier) :
    x ∈ VectorSublattice.generated (Set.range (fun z : Σ i, E i ↦ P.inclusion z.1 z.2)) := by
  let G := VectorSublattice.generated (Set.range (fun z : Σ i, E i ↦ P.inclusion z.1 z.2))
  let T : ∀ i, VecLatHom (E i) G := fun i ↦
    { LinearMap.codRestrict G.toSubmodule (P.inclusion i).toLinearMap
        (fun y ↦ VectorSublattice.subset_generated _ ⟨⟨i, y⟩, rfl⟩) with
      map_sup' := fun a b ↦ Subtype.ext ((P.inclusion i).map_sup' a b)
      map_inf' := fun a b ↦ Subtype.ext ((P.inclusion i).map_inf' a b) }
  obtain ⟨U, hU, _⟩ := P.universal G T
  have hcomp : G.subtype.comp U = VecLatHom.id := freeProduct_hom_ext P _ _
    (fun i y ↦ congrArg (fun z : G ↦ (z : P.Carrier)) (hU i y))
  have hx : (U x : P.Carrier) = x := DFunLike.congr_fun hcomp x
  exact hx ▸ (U x).property

/-- Every element of an ordinary free product is a finite lattice expression in included
factor elements. -/
private lemma exists_inclusion_expression (P : FreeProduct E) (x : P.Carrier) :
    ∃ (n : ℕ) (a : Fin n → Σ i, E i) (e : LLexpr n),
      LLexpr.eval (fun k ↦ P.inclusion (a k).1 (a k).2) e = x := by
  have hx := mem_generated_inclusions P x
  change x ∈ (VectorSublattice.generated
    (Set.range (fun z : Σ i, E i ↦ P.inclusion z.1 z.2)) : Set P.Carrier) at hx
  rw [LLexpr.generated_eq_iUnion_combinations] at hx
  simp only [Set.mem_iUnion, LLexpr.combinations, Set.mem_range] at hx
  obtain ⟨n, y, e, he⟩ := hx
  choose a ha using fun k : Fin n ↦ (y k).property
  exact ⟨n, a, e, (congrArg (fun v : Fin n → P.Carrier ↦ LLexpr.eval v e)
    (funext ha)).trans he⟩


/-- Any finite selection of factor elements is contained in a family of finitely generated
factor sublattices. -/
private lemma finite_sublattices_containing {n : ℕ} (a : Fin n → Sigma E) :
    ∃ S : ∀ i, VectorSublattice (E i),
      (∀ i, IsFinitelyGenerated (S i)) ∧ ∀ j, (a j).2 ∈ S (a j).1 := by
  classical
  let g (i : I) (j : Fin n) : E i := if h : (a j).1 = i then h ▸ (a j).2 else 0
  let S (i : I) := VectorSublattice.generated (Set.range (g i))
  refine ⟨S, fun i ↦ finitely_generated_generated (E i) (g i), fun j ↦ ?_⟩
  apply VectorSublattice.subset_generated
  exact ⟨j, by simp only [g, dite_eq_left rfl]⟩

/-- Any two free-product elements lie in an embedded free product of finitely generated factor
sublattices. -/
private lemma pair_in_finite_subproduct (P : FreeProduct E) (x y : P.Carrier) :
    ∃ (S : ∀ i, VectorSublattice (E i)), (∀ i, IsFinitelyGenerated (S i)) ∧
      ∃ (Q : FreeProduct (fun i ↦ S i)) (T : VecLatHom Q.Carrier P.Carrier),
        Function.Injective T ∧ x ∈ Set.range T ∧ y ∈ Set.range T := by
  obtain ⟨n, a, e, he⟩ := exists_inclusion_expression P x
  obtain ⟨m, b, f, hf⟩ := exists_inclusion_expression P y
  obtain ⟨S, hS, hab⟩ := finite_sublattices_containing (Fin.append a b)
  have ha (i : Fin n) : (a i).2 ∈ S (a i).1 := by
    exact Eq.mp (congrArg (fun z : Sigma E ↦ z.2 ∈ S z.1) (Fin.append_left a b i))
      (hab (i.castAdd m))
  have hb (j : Fin m) : (b j).2 ∈ S (b j).1 := by
    exact Eq.mp (congrArg (fun z : Sigma E ↦ z.2 ∈ S z.1) (Fin.append_right a b j))
      (hab (j.natAdd n))
  obtain ⟨Q⟩ := nonempty_freeProduct (fun i ↦ S i)
  obtain ⟨T, hT, _⟩ := Q.universal P.Carrier (fun i ↦ (P.inclusion i).comp (S i).subtype)
  refine ⟨S, hS, Q, T,
    Q.induced_injective P (fun i ↦ (S i).subtype) (fun _ ↦ Subtype.val_injective) T hT,
    ?_, ?_⟩
  · refine ⟨LLexpr.eval (fun i ↦ Q.inclusion (a i).1 ⟨(a i).2, ha i⟩) e, ?_⟩
    rw [LLexpr.map_eval]
    exact (congrArg (fun v ↦ LLexpr.eval v e) (funext fun i ↦ hT (a i).1
      ⟨(a i).2, ha i⟩)).trans he
  · refine ⟨LLexpr.eval (fun i ↦ Q.inclusion (b i).1 ⟨(b i).2, hb i⟩) f, ?_⟩
    rw [LLexpr.map_eval]
    exact (congrArg (fun v ↦ LLexpr.eval v f) (funext fun i ↦ hT (b i).1
      ⟨(b i).2, hb i⟩)).trans hf

end FinitePieces

/-- The ordinary free product of two finitely generated Archimedean lattices is Archimedean if
the first factor is projective. -/
private lemma archimedean_binary_product_of_projective
    {E : ULift.{u} Bool → Type u} [∀ i, AddCommGroup (E i)] [∀ i, Lattice (E i)]
    [∀ i, IsOrderedAddMonoid (E i)] [∀ i, VectorLattice (E i)]
    [∀ i, IsVLArchimedean (E i)] (P : FreeProduct E)
    (hleft : IsFinitelyGenerated (E ⟨false⟩)) (hright : IsFinitelyGenerated (E ⟨true⟩))
    (hproj : IsProjective (E ⟨false⟩)) : IsVLArchimedean P.Carrier := by
  have hpoly := ((finitely_generated_archimedean_tfae (E ⟨false⟩) hleft).out 3 5).mp hproj
  obtain ⟨n, g, hg⟩ := hleft
  obtain ⟨m, v, hv⟩ := hright
  obtain ⟨C, eC, _⟩ := exists_cone_representation (E ⟨false⟩) g hg
  obtain ⟨D, eD, _⟩ := exists_cone_representation (E ⟨true⟩) v hv
  exact (binary_cone_product_archimedean_iff P C D eC eD).mpr
    (hasPolyhedralCover_of_polyhedral C D (hpoly n C ⟨eC⟩))

/-- The property of having an Archimedean free product with a fixed partner passes to vector
sublattices. -/
private lemma archimedean_free_product_subtype (Y : Type u)
    [AddCommGroup Y] [Lattice Y] [IsOrderedAddMonoid Y] [VectorLattice Y]
    (h : HasArchimedeanFreeProduct X Y) (S : VectorSublattice X) :
    HasArchimedeanFreeProduct S Y := by
  change ∀ Q : FreeProduct (binaryFamily S Y), IsVLArchimedean Q.Carrier
  intro Q
  obtain ⟨P⟩ := nonempty_freeProduct (binaryFamily X Y)
  let : IsVLArchimedean P.Carrier := h P
  let T : ∀ i, VecLatHom (binaryFamily S Y i) (binaryFamily X Y i) := fun
    | ⟨false⟩ => S.subtype
    | ⟨true⟩ => VecLatHom.id
  obtain ⟨U, hU, _⟩ := Q.universal P.Carrier (fun i ↦ (P.inclusion i).comp (T i))
  apply archimedean_of_injective U
  apply Q.induced_injective P T _ U hU
  rintro ⟨_ | _⟩
  · exact Subtype.val_injective
  · exact Function.injective_id

/-- An Archimedean lattice preserves Archimedeanity under free products
exactly when every finitely generated vector sublattice is projective. -/
theorem archimedean_freeProducts_iff_locally_projective [IsVLArchimedean X] :
    (∀ (Y : Type u) [AddCommGroup Y] [Lattice Y]
      [IsOrderedAddMonoid Y] [VectorLattice Y] [IsVLArchimedean Y],
      HasArchimedeanFreeProduct X Y) ↔
    ∀ S : VectorSublattice X, IsFinitelyGenerated S → IsProjective S := by
  constructor
  · intro h S hS
    let : IsVLArchimedean S := archimedean_of_injective S.subtype Subtype.val_injective
    have hprod : ∀ (Y : Type u) [AddCommGroup Y] [Lattice Y]
        [IsOrderedAddMonoid Y] [VectorLattice Y] [IsVLArchimedean Y],
        IsFinitelyGenerated Y → HasArchimedeanFreeProduct S Y :=
      fun Y _ _ _ _ _ _ ↦ archimedean_free_product_subtype X Y (h Y) S
    exact ((finitely_generated_archimedean_tfae S hS).out 1 3).mp hprod
  · intro h Y _ _ _ _ _
    change ∀ P : FreeProduct (binaryFamily X Y), IsVLArchimedean P.Carrier
    intro P
    constructor
    intro x y hxy
    obtain ⟨S, hS, Q, T, hTi, ⟨a, rfl⟩, ⟨b, rfl⟩⟩ := pair_in_finite_subproduct P x y
    let : ∀ i, IsVLArchimedean (S i) := fun i ↦
      archimedean_of_injective (S i).subtype Subtype.val_injective
    let : IsVLArchimedean Q.Carrier := archimedean_binary_product_of_projective Q
      (hS ⟨false⟩) (hS ⟨true⟩) (h (S ⟨false⟩) (hS ⟨false⟩))
    have ha : a ≤ 0 := IsVLArchimedean.le_zero_of_forall_nsmul_le (y := b) (fun n ↦
      T.le_of_map_le hTi (by simpa only [map_nsmul] using hxy n))
    simpa only [map_zero] using T.monotone ha

end VectorLattice
