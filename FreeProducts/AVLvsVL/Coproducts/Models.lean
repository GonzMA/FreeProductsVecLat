import FreeProducts.AVLvsVL.Classical.Duality
import FreeProducts.Archimedean.Embeddings

/-!
# Cone models of ordinary and Archimedean coproducts

The ordinary vector lattice coproduct is a quotient by the two factors’ relations.
The Archimedean coproduct is the restriction lattice on the product cone, with inclusions
given by pullback along the projections.
-/

universe u

namespace VectorLattice

variable (X : Type u) [AddCommGroup X] [Lattice X]
  [IsOrderedAddMonoid X] [VectorLattice X]

open ConeRepresentation

/-- Every ordinary vector lattice free product of the two factors
is Archimedean. -/
def HasArchimedeanFreeProduct (Y : Type u) [AddCommGroup Y] [Lattice Y]
    [IsOrderedAddMonoid Y] [VectorLattice Y] : Prop :=
  let E : ULift.{u} Bool → Type u := fun i ↦ Bool.rec X Y i.down
  letI instGroup : ∀ i, AddCommGroup (E i) := fun ⟨b⟩ ↦
    match b with
    | false => (inferInstance : AddCommGroup X)
    | true => (inferInstance : AddCommGroup Y)
  letI instLattice : ∀ i, Lattice (E i) := fun ⟨b⟩ ↦
    match b with
    | false => (inferInstance : Lattice X)
    | true => (inferInstance : Lattice Y)
  letI instOrder : ∀ i, @IsOrderedAddMonoid (E i)
      (instGroup i).toAddCommMonoid (instLattice i).toPartialOrder.toPreorder := fun ⟨b⟩ ↦
    match b with
    | false => (inferInstance : IsOrderedAddMonoid X)
    | true => (inferInstance : IsOrderedAddMonoid Y)
  letI instVector : ∀ i, @VectorLattice (E i) (instGroup i) (instLattice i) (instOrder i) :=
    fun ⟨b⟩ ↦
      match b with
      | false => (inferInstance : VectorLattice X)
      | true => (inferInstance : VectorLattice Y)
  ∀ P : @FreeProduct _ E instGroup instLattice instOrder instVector,
    IsVLArchimedean (@FreeProduct.Carrier _ E instGroup instLattice instOrder instVector P)

end VectorLattice

namespace VectorLattice.ConeRepresentation

/-- The product cone, with the coordinates of the first factor followed
by the coordinates of the second factor. -/
def productCone {n m : ℕ} (C : ClosedCone n) (D : ClosedCone m) :
    ClosedCone (n + m) where
  carrier := {z |
    (fun i : Fin n ↦ z (i.castAdd m)) ∈ C.carrier ∧
    (fun j : Fin m ↦ z (j.natAdd n)) ∈ D.carrier}
  isClosed := (C.isClosed.preimage (continuous_pi (fun i ↦ continuous_apply (i.castAdd m)))).inter
    (D.isClosed.preimage (continuous_pi (fun j ↦ continuous_apply (j.natAdd n))))
  zero_mem := ⟨C.zero_mem, D.zero_mem⟩
  smul_mem := fun r hr _ hz ↦ ⟨C.smul_mem r hr _ hz.1, D.smul_mem r hr _ hz.2⟩

/-- The ideal generated by the vanishing relations from the two factors,
pulled back along the coordinate projections. -/
noncomputable def productRelationsIdeal {n m : ℕ}
    (C : ClosedCone n) (D : ClosedCone m) :
    OrderIdeal (FVL (Fin (n + m))) :=
  OrderIdeal.generated
    ((FVL.map (fun i : Fin n ↦ i.castAdd m) ''
        (vanishingIdeal C : Set (FVL (Fin n)))) ∪
      (FVL.map (fun j : Fin m ↦ j.natAdd n) ''
        (vanishingIdeal D : Set (FVL (Fin m)))))

/-- Relations inherited from either factor vanish on the product cone. -/
lemma productRelationsIdeal_le_vanishingIdeal {n m : ℕ}
    (C : ClosedCone n) (D : ClosedCone m) :
    productRelationsIdeal C D ≤ vanishingIdeal (productCone C D) := by
  apply OrderIdeal.generated_le
  rintro _ (⟨f, hf, rfl⟩ | ⟨g, hg, rfl⟩)
  · exact (mem_vanishingIdeal _ _).mpr fun z hz ↦ (free_map_apply _ f z).trans
      ((mem_vanishingIdeal C f).mp hf _ hz.1)
  · exact (mem_vanishingIdeal _ _).mpr fun z hz ↦ (free_map_apply _ g z).trans
      ((mem_vanishingIdeal D g).mp hg _ hz.2)

/-- Every element of the product relation ideal is dominated by a sum of nonnegative vanishing
functions from the two factors. -/
lemma productRelations_majorant {n m : ℕ} (C : ClosedCone n) (D : ClosedCone m)
    {h : FVL (Fin (n + m))} (hh : h ∈ productRelationsIdeal C D) :
    ∃ f : FVL (Fin n), ∃ g : FVL (Fin m),
      f ∈ vanishingIdeal C ∧ g ∈ vanishingIdeal D ∧ 0 ≤ f ∧ 0 ≤ g ∧
      |h| ≤ FVL.map (fun i ↦ i.castAdd m) f + FVL.map (fun j ↦ j.natAdd n) g := by
  obtain ⟨t, c, ht, hc, hh⟩ := OrderIdeal.mem_generated_iff.mp hh
  have rep (y : t) : ∃ f : FVL (Fin n), ∃ g : FVL (Fin m),
      f ∈ vanishingIdeal C ∧ g ∈ vanishingIdeal D ∧ 0 ≤ f ∧ 0 ≤ g ∧
      |y.val| = FVL.map (fun i ↦ i.castAdd m) f + FVL.map (fun j ↦ j.natAdd n) g := by
    rcases ht y.val y.property with ⟨f, hf, heq⟩ | ⟨g, hg, heq⟩
    · refine ⟨|f|, 0, (vanishingIdeal C).abs_mem hf, (vanishingIdeal D).zero_mem,
        abs_nonneg _, le_rfl, ?_⟩
      simp only [VecLatHom.map_abs, heq, map_zero, add_zero]
    · refine ⟨0, |g|, (vanishingIdeal C).zero_mem, (vanishingIdeal D).abs_mem hg,
        le_rfl, abs_nonneg _, ?_⟩
      simp only [VecLatHom.map_abs, heq, map_zero, zero_add]
  choose f g hf hg hf0 hg0 hfg using rep
  refine ⟨∑ y : t, c y.val • f y, ∑ y : t, c y.val • g y,
    (vanishingIdeal C).toSubmodule.sum_mem (fun y _ ↦
      (vanishingIdeal C).smul_mem _ (hf y)),
    (vanishingIdeal D).toSubmodule.sum_mem (fun y _ ↦
      (vanishingIdeal D).smul_mem _ (hg y)),
    Finset.sum_nonneg (fun y _ ↦ smul_nonneg (hc _ y.property) (hf0 y)),
    Finset.sum_nonneg (fun y _ ↦ smul_nonneg (hc _ y.property) (hg0 y)), ?_⟩
  rw [← Finset.sum_coe_sort t] at hh
  simpa only [hfg, smul_add, Finset.sum_add_distrib, map_sum, map_smul] using hh

end VectorLattice.ConeRepresentation

namespace VectorLattice

variable (X : Type u) [AddCommGroup X] [Lattice X]
  [IsOrderedAddMonoid X] [VectorLattice X]

open ConeRepresentation

/-- The binary family inherits the additive group of its selected factor. -/
private instance binaryAddCommGroup {X Y : Type u} [AddCommGroup X] [AddCommGroup Y]
    (i : ULift.{u} Bool) : AddCommGroup (binaryFamily X Y i) :=
  match i with
  | ⟨b⟩ => match b with
    | false => inferInstanceAs (AddCommGroup X)
    | true => inferInstanceAs (AddCommGroup Y)

/-- The binary family inherits the lattice order of its selected factor. -/
private instance binaryLattice {X Y : Type u} [Lattice X] [Lattice Y]
    (i : ULift.{u} Bool) : Lattice (binaryFamily X Y i) :=
  match i with
  | ⟨b⟩ => match b with
    | false => inferInstanceAs (Lattice X)
    | true => inferInstanceAs (Lattice Y)

/-- Addition respects the inherited order in the binary family. -/
private instance binaryOrderedAddMonoid {X Y : Type u} [AddCommGroup X] [Lattice X]
    [IsOrderedAddMonoid X] [AddCommGroup Y] [Lattice Y] [IsOrderedAddMonoid Y]
    (i : ULift.{u} Bool) : IsOrderedAddMonoid (binaryFamily X Y i) :=
  match i with
  | ⟨b⟩ => match b with
    | false => inferInstanceAs (IsOrderedAddMonoid X)
    | true => inferInstanceAs (IsOrderedAddMonoid Y)

/-- The binary family inherits the real vector lattice structure of its factors. -/
private instance binaryVectorLattice {X Y : Type u} [AddCommGroup X] [Lattice X]
    [IsOrderedAddMonoid X] [VectorLattice X] [AddCommGroup Y] [Lattice Y]
    [IsOrderedAddMonoid Y] [VectorLattice Y]
    (i : ULift.{u} Bool) : VectorLattice (binaryFamily X Y i) :=
  match i with
  | ⟨b⟩ => match b with
    | false => inferInstanceAs (VectorLattice X)
    | true => inferInstanceAs (VectorLattice Y)

/-- The binary family is Archimedean when both factors are Archimedean. -/
private instance binaryArchimedean {X Y : Type u} [AddCommGroup X] [Lattice X]
    [IsOrderedAddMonoid X] [VectorLattice X] [IsVLArchimedean X]
    [AddCommGroup Y] [Lattice Y] [IsOrderedAddMonoid Y] [VectorLattice Y] [IsVLArchimedean Y]
    (i : ULift.{u} Bool) : IsVLArchimedean (binaryFamily X Y i) :=
  match i with
  | ⟨b⟩ => match b with
    | false => inferInstanceAs (IsVLArchimedean X)
    | true => inferInstanceAs (IsVLArchimedean Y)

/-! ## Ordinary coproducts as quotients by factor relations -/

/-- The ambient free lattice on both coordinate blocks, modulo the relations inherited from
the two cones. -/
abbrev ConeProductQuotient {n m : ℕ} (C : ClosedCone n) (D : ClosedCone m) :=
  FVL (Fin (n + m)) ⧸ (productRelationsIdeal C D).toSubmodule

/-- A free-lattice homomorphism killing a cone's vanishing ideal descends to its restriction
lattice. -/
private lemma descend_from_cone {n : ℕ} (C : ClosedCone n)
    {Z : Type*} [AddCommGroup Z] [Lattice Z] [IsOrderedAddMonoid Z] [VectorLattice Z]
    (T : VecLatHom (FVL (Fin n)) Z) (hT : vanishingIdeal C ≤ OrderIdeal.ofKerVecLatHom T) :
    ∃ A : VecLatHom (ConeFunctions C) Z, A.comp (FVL.lift (coordinate C)) = T := by
  obtain ⟨e, he⟩ := cone_quotient_equiv C
  let R := (vanishingIdeal C).liftQVecLatHom T hT
  refine ⟨R.comp e.symm.toVecLatHom, DFunLike.ext _ _ (fun f ↦ ?_)⟩
  have h : e.symm (FVL.lift (coordinate C) f) = (vanishingIdeal C).mkQ f :=
    (congrArg e.symm (he f)).symm.trans (e.toLinearEquiv.symm_apply_apply _)
  exact (congrArg R h).trans rfl

/-- Combines maps from the two restriction lattices into a free-lattice map that kills the
product relation ideal. -/
private lemma cone_product_lift {n m : ℕ} (C : ClosedCone n) (D : ClosedCone m)
    {Z : Type*} [AddCommGroup Z] [Lattice Z] [IsOrderedAddMonoid Z] [VectorLattice Z]
    (A : VecLatHom (ConeFunctions C) Z) (B : VecLatHom (ConeFunctions D) Z) :
    ∃ T : VecLatHom (FVL (Fin (n + m))) Z,
      T.comp (FVL.map (fun i : Fin n ↦ i.castAdd m)) = A.comp (FVL.lift (coordinate C)) ∧
      T.comp (FVL.map (fun j : Fin m ↦ j.natAdd n)) = B.comp (FVL.lift (coordinate D)) ∧
      productRelationsIdeal C D ≤ OrderIdeal.ofKerVecLatHom T := by
  let T := FVL.lift (Fin.append (fun i ↦ A (coordinate C i)) (fun j ↦ B (coordinate D j)))
  have hleft : T.comp (FVL.map (fun i : Fin n ↦ i.castAdd m)) =
      A.comp (FVL.lift (coordinate C)) := by
    apply FVL.hom_ext
    intro i
    simp only [VecLatHom.comp_apply, FVL.map_of, T, FVL.lift_of, Fin.append_left]
  have hright : T.comp (FVL.map (fun j : Fin m ↦ j.natAdd n)) =
      B.comp (FVL.lift (coordinate D)) := by
    apply FVL.hom_ext
    intro j
    simp only [VecLatHom.comp_apply, FVL.map_of, T, FVL.lift_of, Fin.append_right]
  refine ⟨T, hleft, hright, OrderIdeal.generated_le ?_⟩
  rintro _ (⟨f, hf, rfl⟩ | ⟨f, hf, rfl⟩)
  · have hz : FVL.lift (coordinate C) f = 0 := Subtype.ext
      (funext (fun x ↦ (coneRestriction_apply C f x).trans
        ((mem_vanishingIdeal C f).mp hf _ x.property)))
    exact (DFunLike.congr_fun hleft f).trans ((congrArg A hz).trans (map_zero A))
  · have hz : FVL.lift (coordinate D) f = 0 := Subtype.ext
      (funext (fun x ↦ (coneRestriction_apply D f x).trans
        ((mem_vanishingIdeal D f).mp hf _ x.property)))
    exact (DFunLike.congr_fun hright f).trans ((congrArg B hz).trans (map_zero B))

/-- Constructs the two factor homomorphisms into the product-relation quotient with their
prescribed coordinate values. -/
lemma cone_product_inclusions {n m : ℕ} (C : ClosedCone n) (D : ClosedCone m) :
    ∃ (A : VecLatHom (ConeFunctions C) (ConeProductQuotient C D))
      (B : VecLatHom (ConeFunctions D) (ConeProductQuotient C D)),
      (∀ i, A (coordinate C i) = (productRelationsIdeal C D).mkQ (FVL.of (i.castAdd m))) ∧
      ∀ j, B (coordinate D j) = (productRelationsIdeal C D).mkQ (FVL.of (j.natAdd n)) := by
  let J := productRelationsIdeal C D
  have hleft : vanishingIdeal C ≤ OrderIdeal.ofKerVecLatHom
      (J.mkQVecLatHom.comp (FVL.map (fun i : Fin n ↦ i.castAdd m))) := by
    intro f hf
    exact (Submodule.Quotient.mk_eq_zero J.toSubmodule).mpr
      (OrderIdeal.subset_generated _ (Or.inl ⟨f, hf, rfl⟩))
  have hright : vanishingIdeal D ≤ OrderIdeal.ofKerVecLatHom
      (J.mkQVecLatHom.comp (FVL.map (fun j : Fin m ↦ j.natAdd n))) := by
    intro f hf
    exact (Submodule.Quotient.mk_eq_zero J.toSubmodule).mpr
      (OrderIdeal.subset_generated _ (Or.inr ⟨f, hf, rfl⟩))
  obtain ⟨A, hA⟩ := descend_from_cone C _ hleft
  obtain ⟨B, hB⟩ := descend_from_cone D _ hright
  refine ⟨A, B, ?_, ?_⟩
  · intro i
    simpa only [VecLatHom.comp_apply, FVL.lift_of, FVL.map_of, OrderIdeal.mkQVecLatHom_apply]
      using DFunLike.congr_fun hA (FVL.of i)
  · intro j
    simpa only [VecLatHom.comp_apply, FVL.lift_of, FVL.map_of, OrderIdeal.mkQVecLatHom_apply]
      using DFunLike.congr_fun hB (FVL.of j)

section ConeProductQuotient

variable {n m : ℕ} (C : ClosedCone n) (D : ClosedCone m)
  (A : VecLatHom (ConeFunctions C) (ConeProductQuotient C D))
  (B : VecLatHom (ConeFunctions D) (ConeProductQuotient C D))
  (hA : ∀ i, A (coordinate C i) = (productRelationsIdeal C D).mkQ (FVL.of (i.castAdd m)))
  (hB : ∀ j, B (coordinate D j) = (productRelationsIdeal C D).mkQ (FVL.of (j.natAdd n)))

include hA hB

/-- Homomorphisms on the product-relation quotient are determined by their restrictions to the
two factors. -/
private lemma cone_product_hom_ext {Z : Type*}
    [AddCommGroup Z] [Lattice Z] [IsOrderedAddMonoid Z] [VectorLattice Z]
    (S T : VecLatHom (ConeProductQuotient C D) Z)
    (hS : S.comp A = T.comp A) (hT : S.comp B = T.comp B) : S = T := by
  have h : S.comp (productRelationsIdeal C D).mkQVecLatHom =
      T.comp (productRelationsIdeal C D).mkQVecLatHom := by
    apply FVL.hom_ext
    intro i
    refine Fin.addCases (fun i ↦ ?_) (fun j ↦ ?_) i
    · change S ((productRelationsIdeal C D).mkQ (FVL.of (i.castAdd m))) =
        T ((productRelationsIdeal C D).mkQ (FVL.of (i.castAdd m)))
      rw [← hA]
      exact DFunLike.congr_fun hS (coordinate C i)
    · change S ((productRelationsIdeal C D).mkQ (FVL.of (j.natAdd n))) =
        T ((productRelationsIdeal C D).mkQ (FVL.of (j.natAdd n)))
      rw [← hB]
      exact DFunLike.congr_fun hT (coordinate D j)
  apply DFunLike.ext
  intro z
  obtain ⟨f, rfl⟩ := (productRelationsIdeal C D).toSubmodule.mkQ_surjective z
  exact DFunLike.congr_fun h f

/-- The product-relation quotient satisfies the universal property of the ordinary free
product of the two restriction lattices. -/
lemma cone_product_universal {Z : Type*}
    [AddCommGroup Z] [Lattice Z] [IsOrderedAddMonoid Z] [VectorLattice Z]
    (f : VecLatHom (ConeFunctions C) Z) (g : VecLatHom (ConeFunctions D) Z) :
    ∃! R : VecLatHom (ConeProductQuotient C D) Z, R.comp A = f ∧ R.comp B = g := by
  obtain ⟨T, hleft, hright, hker⟩ := cone_product_lift C D f g
  let R := (productRelationsIdeal C D).liftQVecLatHom T hker
  have hRA : R.comp A = f := by
    apply hom_ext_finite_generators (ConeFunctions C) (coordinate C) (generated_range_coordinate C)
    intro i
    change R (A (coordinate C i)) = f (coordinate C i)
    rw [hA]
    change T (FVL.of (i.castAdd m)) = f (coordinate C i)
    simpa only [VecLatHom.comp_apply, FVL.map_of, FVL.lift_of]
      using DFunLike.congr_fun hleft (FVL.of i)
  have hRB : R.comp B = g := by
    apply hom_ext_finite_generators (ConeFunctions D) (coordinate D) (generated_range_coordinate D)
    intro j
    change R (B (coordinate D j)) = g (coordinate D j)
    rw [hB]
    change T (FVL.of (j.natAdd n)) = g (coordinate D j)
    simpa only [VecLatHom.comp_apply, FVL.map_of, FVL.lift_of]
      using DFunLike.congr_fun hright (FVL.of j)
  exact ⟨R, ⟨hRA, hRB⟩, fun S hS ↦ cone_product_hom_ext C D A B hA hB S R
    (hS.1.trans hRA.symm) (hS.2.trans hRB.symm)⟩

end ConeProductQuotient

/-- Homomorphisms from an ordinary free product are determined by their values on the
canonical factors. -/
lemma freeProduct_hom_ext {I : Type u} {E : I → Type u}
    [∀ i, AddCommGroup (E i)] [∀ i, Lattice (E i)]
    [∀ i, IsOrderedAddMonoid (E i)] [∀ i, VectorLattice (E i)]
    (P : FreeProduct E) {Z : Type u} [AddCommGroup Z] [Lattice Z]
    [IsOrderedAddMonoid Z] [VectorLattice Z] (S T : VecLatHom P.Carrier Z)
    (h : ∀ i x, S (P.inclusion i x) = T (P.inclusion i x)) : S = T := by
  obtain ⟨R, _, hu⟩ := P.universal Z (fun i ↦ S.comp (P.inclusion i))
  exact (hu S (fun _ _ ↦ rfl)).trans (hu T (fun i x ↦ (h i x).symm)).symm

/-- Identifies a binary ordinary free product of cone restriction lattices with the
product-relation quotient. -/
lemma binary_cone_product_equiv {E : ULift.{u} Bool → Type u}
    [∀ i, AddCommGroup (E i)] [∀ i, Lattice (E i)]
    [∀ i, IsOrderedAddMonoid (E i)] [∀ i, VectorLattice (E i)] (P : FreeProduct E)
    {n m : ℕ} (C : ClosedCone n) (D : ClosedCone m)
    (eC : VecLatEquiv (E ⟨false⟩) (ConeFunctions C))
    (eD : VecLatEquiv (E ⟨true⟩) (ConeFunctions D)) :
    Nonempty (VecLatEquiv P.Carrier (ConeProductQuotient C D)) := by
  obtain ⟨A, B, hA, hB⟩ := cone_product_inclusions C D
  let L := (P.inclusion ⟨false⟩).comp eC.symm.toVecLatHom
  let R := (P.inclusion ⟨true⟩).comp eD.symm.toVecLatHom
  obtain ⟨F, hFA, hFB⟩ := (cone_product_universal C D A B hA hB L R).exists
  let up := (uliftEquiv.{u} (ConeProductQuotient C D)).symm.toVecLatHom
  let down := (uliftEquiv.{u} (ConeProductQuotient C D)).toVecLatHom
  let U : ∀ i, VecLatHom (E i) (ULift.{u} (ConeProductQuotient C D)) := fun i ↦ match i with
    | ⟨false⟩ => up.comp (A.comp eC.toVecLatHom)
    | ⟨true⟩ => up.comp (B.comp eD.toVecLatHom)
  obtain ⟨G, hG, _⟩ := P.universal _ U
  let H := down.comp G
  have hleft (x : E ⟨false⟩) : H (P.inclusion ⟨false⟩ x) = A (eC x) :=
    congrArg ULift.down (hG ⟨false⟩ x)
  have hright (x : E ⟨true⟩) : H (P.inclusion ⟨true⟩ x) = B (eD x) :=
    congrArg ULift.down (hG ⟨true⟩ x)
  have hFH : F.comp H = VecLatHom.id := by
    apply freeProduct_hom_ext P
    rintro (⟨_ | _⟩) x
    · exact (congrArg F (hleft x)).trans ((DFunLike.congr_fun hFA (eC x)).trans
        (congrArg (P.inclusion ⟨false⟩) (eC.toLinearEquiv.symm_apply_apply x)))
    · exact (congrArg F (hright x)).trans ((DFunLike.congr_fun hFB (eD x)).trans
        (congrArg (P.inclusion ⟨true⟩) (eD.toLinearEquiv.symm_apply_apply x)))
  have hHF : H.comp F = VecLatHom.id := by
    apply cone_product_hom_ext C D A B hA hB
    · apply DFunLike.ext
      intro f
      exact (congrArg H (DFunLike.congr_fun hFA f)).trans
        ((hleft (eC.symm f)).trans (congrArg A (eC.toLinearEquiv.apply_symm_apply f)))
    · apply DFunLike.ext
      intro f
      exact (congrArg H (DFunLike.congr_fun hFB f)).trans
        ((hright (eD.symm f)).trans (congrArg B (eD.toLinearEquiv.apply_symm_apply f)))
  exact ⟨{ H.toLinearMap with
    invFun := F
    left_inv := DFunLike.congr_fun hFH
    right_inv := DFunLike.congr_fun hHF
    map_sup' := H.map_sup'
    map_inf' := H.map_inf' }⟩

end VectorLattice

namespace VectorLattice.ConeRepresentation

/-! ## Archimedean coproducts from cone duality -/

/-- The first coordinate projection is a cone map. -/
private def productConeFst {n m : ℕ} (C : ClosedCone n) (D : ClosedCone m) :
    ConeMap (productCone C D) C where
  toFun x := ⟨fun i ↦ x.val (i.castAdd m), x.property.1⟩
  coordinate_mem i := (coordinate (productCone C D) (i.castAdd m)).property

/-- The second coordinate projection is a cone map. -/
private def productConeSnd {n m : ℕ} (C : ClosedCone n) (D : ClosedCone m) :
    ConeMap (productCone C D) D where
  toFun x := ⟨fun j ↦ x.val (j.natAdd n), x.property.2⟩
  coordinate_mem j := (coordinate (productCone C D) (j.natAdd n)).property

/-- Pairing two cone maps gives a map to the product cone. -/
private def productConePair {k n m : ℕ} {A : ClosedCone k} {C : ClosedCone n}
    {D : ClosedCone m} (q : ConeMap A C) (r : ConeMap A D) :
    ConeMap A (productCone C D) where
  toFun x := ⟨Fin.append (q.toFun x).val (r.toFun x).val,
    by simpa only [productCone, Set.mem_ofPred_eq, Fin.append_left, Fin.append_right]
      using And.intro (q.toFun x).property (r.toFun x).property⟩
  coordinate_mem := Fin.addCases (fun i ↦ by simpa only [Fin.append_left] using q.coordinate_mem i)
    (fun j ↦ by simpa only [Fin.append_right] using r.coordinate_mem j)

/-- Pullback of a paired map restricts to each of its two component pullbacks. -/
private lemma productConePair_pullback {k n m : ℕ} {A : ClosedCone k} {C : ClosedCone n}
    {D : ClosedCone m} (q : ConeMap A C) (r : ConeMap A D) :
    (pullback (productConePair q r)).comp (pullback (productConeFst C D)) = pullback q ∧
    (pullback (productConePair q r)).comp (pullback (productConeSnd C D)) = pullback r := by
  exact ⟨DFunLike.ext _ _ (fun f ↦ Subtype.ext (funext (fun x ↦
    congrArg f.val (Subtype.ext (funext (fun i ↦
      Fin.append_left (q.toFun x).val (r.toFun x).val i)))))),
    DFunLike.ext _ _ (fun f ↦ Subtype.ext (funext (fun x ↦
      congrArg f.val (Subtype.ext (funext (fun j ↦
        Fin.append_right (q.toFun x).val (r.toFun x).val j))))))⟩

/-- Cone duality extends two factor maps to any finitely generated Archimedean target. -/
private lemma cone_product_extension {X : Type*} [AddCommGroup X] [Lattice X]
    [IsOrderedAddMonoid X] [VectorLattice X] [IsVLArchimedean X]
    (hX : IsFinitelyGenerated X) {n m : ℕ} (C : ClosedCone n) (D : ClosedCone m)
    (f : VecLatHom (ConeFunctions C) X) (g : VecLatHom (ConeFunctions D) X) :
    ∃ R : VecLatHom (ConeFunctions (productCone C D)) X,
      R.comp (pullback (productConeFst C D)) = f ∧
      R.comp (pullback (productConeSnd C D)) = g := by
  obtain ⟨k, v, hv⟩ := hX
  obtain ⟨A, e, _⟩ := exists_cone_representation X v hv
  obtain ⟨q, hq, _⟩ := exists_unique_pullback A C (e.toVecLatHom.comp f)
  obtain ⟨r, hr, _⟩ := exists_unique_pullback A D (e.toVecLatHom.comp g)
  exact ⟨e.symm.toVecLatHom.comp (pullback (productConePair q r)),
    DFunLike.ext _ _ (fun x ↦ (congrArg e.symm
      (DFunLike.congr_fun ((productConePair_pullback q r).1.trans hq) x)).trans
        (e.toLinearEquiv.symm_apply_apply (f x))),
    DFunLike.ext _ _ (fun x ↦ (congrArg e.symm
      (DFunLike.congr_fun ((productConePair_pullback q r).2.trans hr) x)).trans
        (e.toLinearEquiv.symm_apply_apply (g x)))⟩

/-- An Archimedean free product of two cone function lattices is finitely generated. -/
private lemma cone_product_finitely_generated {E : ULift.{u} Bool → Type u}
    [∀ i, AddCommGroup (E i)] [∀ i, Lattice (E i)]
    [∀ i, IsOrderedAddMonoid (E i)] [∀ i, VectorLattice (E i)]
    [∀ i, IsVLArchimedean (E i)] (P : ArchimedeanFreeProduct E)
    {n m : ℕ} (C : ClosedCone n) (D : ClosedCone m)
    (eC : VecLatEquiv (E ⟨false⟩) (ConeFunctions C))
    (eD : VecLatEquiv (E ⟨true⟩) (ConeFunctions D)) :
    IsFinitelyGenerated P.Carrier := by
  obtain ⟨Q⟩ := nonempty_freeProduct E
  obtain ⟨e⟩ := binary_cone_product_equiv Q C D eC eD
  have hfg : IsFinitelyGenerated (ConeProductQuotient C D) :=
    ⟨n + m, fun i ↦ (productRelationsIdeal C D).mkQ (FVL.of i),
      generated_range_of_surjective_free _ (productRelationsIdeal C D).mkQVecLatHom
        (productRelationsIdeal C D).toSubmodule.mkQ_surjective⟩
  obtain ⟨a, _, _⟩ := (Q.archimedeanization E).exists_unique_equiv P
  exact finitely_generated_of_surjective _ hfg
    (a.toVecLatHom.comp ((archimedeanQuotient Q.Carrier).comp e.symm.toVecLatHom))
    (a.toLinearEquiv.surjective.comp
      ((archimedeanQuotient_surjective Q.Carrier).comp e.symm.toLinearEquiv.surjective))

/-- Maps out of the product-cone lattice are determined by the two coordinate pullbacks. -/
private lemma cone_product_restrictions_ext {X : Type*} [AddCommGroup X] [Lattice X]
    [IsOrderedAddMonoid X] [VectorLattice X] {n m : ℕ}
    (C : ClosedCone n) (D : ClosedCone m)
    (S T : VecLatHom (ConeFunctions (productCone C D)) X)
    (hC : S.comp (pullback (productConeFst C D)) = T.comp (pullback (productConeFst C D)))
    (hD : S.comp (pullback (productConeSnd C D)) = T.comp (pullback (productConeSnd C D))) :
    S = T := by
  apply hom_ext_finite_generators _ (coordinate (productCone C D))
    (generated_range_coordinate (productCone C D)) S T
  exact Fin.addCases (fun i ↦ DFunLike.congr_fun hC (coordinate C i))
    (fun j ↦ DFunLike.congr_fun hD (coordinate D j))

/-- The universal property determines an Archimedean free-product map on its factors. -/
private lemma archimedean_product_ext {I : Type u} {E : I → Type u}
    [∀ i, AddCommGroup (E i)] [∀ i, Lattice (E i)]
    [∀ i, IsOrderedAddMonoid (E i)] [∀ i, VectorLattice (E i)]
    [∀ i, IsVLArchimedean (E i)] (P : ArchimedeanFreeProduct E)
    {X : Type u} [AddCommGroup X] [Lattice X] [IsOrderedAddMonoid X]
    [VectorLattice X] [IsVLArchimedean X] {S T : VecLatHom P.Carrier X}
    (h : ∀ i x, S (P.inclusion i x) = T (P.inclusion i x)) : S = T := by
  exact (P.universal X (fun i ↦ S.comp (P.inclusion i))).unique
    (fun _ _ ↦ rfl) (fun i x ↦ (h i x).symm)

/-- The maps supplied by cone duality and the Archimedean universal property are inverse. -/
private lemma cone_product_equiv {E : ULift.{u} Bool → Type u}
    [∀ i, AddCommGroup (E i)] [∀ i, Lattice (E i)]
    [∀ i, IsOrderedAddMonoid (E i)] [∀ i, VectorLattice (E i)]
    [∀ i, IsVLArchimedean (E i)] (P : ArchimedeanFreeProduct E)
    {n m : ℕ} (C : ClosedCone n) (D : ClosedCone m)
    (eC : VecLatEquiv (E ⟨false⟩) (ConeFunctions C))
    (eD : VecLatEquiv (E ⟨true⟩) (ConeFunctions D)) :
    ∃ e : VecLatEquiv P.Carrier (ConeFunctions (productCone C D)),
      (∀ x, e (P.inclusion ⟨false⟩ x) = pullback (productConeFst C D) (eC x)) ∧
      ∀ x, e (P.inclusion ⟨true⟩ x) = pullback (productConeSnd C D) (eD x) := by
  obtain ⟨F, hFC, hFD⟩ := cone_product_extension
    (cone_product_finitely_generated P C D eC eD) C D
    ((P.inclusion ⟨false⟩).comp eC.symm.toVecLatHom)
    ((P.inclusion ⟨true⟩).comp eD.symm.toVecLatHom)
  let d := uliftEquiv.{u} (ConeFunctions (productCone C D))
  let : IsVLArchimedean (ULift.{u} (ConeFunctions (productCone C D))) :=
    archimedean_of_injective d.toVecLatHom d.toLinearEquiv.injective
  obtain ⟨G, hG, _⟩ := P.universal _ (fun i ↦ match i with
    | ⟨false⟩ => d.symm.toVecLatHom.comp ((pullback (productConeFst C D)).comp eC.toVecLatHom)
    | ⟨true⟩ => d.symm.toVecLatHom.comp ((pullback (productConeSnd C D)).comp eD.toVecLatHom))
  let H := d.toVecLatHom.comp G
  have hleft (x : E ⟨false⟩) : H (P.inclusion ⟨false⟩ x) =
      pullback (productConeFst C D) (eC x) := congrArg ULift.down (hG ⟨false⟩ x)
  have hright (x : E ⟨true⟩) : H (P.inclusion ⟨true⟩ x) =
      pullback (productConeSnd C D) (eD x) := congrArg ULift.down (hG ⟨true⟩ x)
  have hFH : F.comp H = VecLatHom.id := archimedean_product_ext P (fun
    | ⟨false⟩, x => (congrArg F (hleft x)).trans
        ((DFunLike.congr_fun hFC (eC x)).trans
          (congrArg (P.inclusion ⟨false⟩) (eC.toLinearEquiv.symm_apply_apply x)))
    | ⟨true⟩, x => (congrArg F (hright x)).trans
        ((DFunLike.congr_fun hFD (eD x)).trans
          (congrArg (P.inclusion ⟨true⟩) (eD.toLinearEquiv.symm_apply_apply x))))
  have hHF : H.comp F = VecLatHom.id := cone_product_restrictions_ext C D _ _
    (DFunLike.ext _ _ (fun f ↦ (congrArg H (DFunLike.congr_fun hFC f)).trans
      ((hleft (eC.symm f)).trans (congrArg (pullback (productConeFst C D))
        (eC.toLinearEquiv.apply_symm_apply f)))))
    (DFunLike.ext _ _ (fun g ↦ (congrArg H (DFunLike.congr_fun hFD g)).trans
      ((hright (eD.symm g)).trans (congrArg (pullback (productConeSnd C D))
        (eD.toLinearEquiv.apply_symm_apply g)))))
  exact ⟨{ H.toLinearMap with
    invFun := F
    left_inv := DFunLike.congr_fun hFH
    right_inv := DFunLike.congr_fun hHF
    map_sup' := H.map_sup'
    map_inf' := H.map_inf' }, hleft, hright⟩

end VectorLattice.ConeRepresentation

namespace VectorLattice

/-- The Archimedean free product of two cone function lattices is the function lattice
on the product cone, with the factors acting through the coordinate projections. -/
theorem ArchimedeanFreeProduct.exists_cone_product_equiv {E : ULift.{u} Bool → Type u}
    [∀ i, AddCommGroup (E i)] [∀ i, Lattice (E i)]
    [∀ i, IsOrderedAddMonoid (E i)] [∀ i, VectorLattice (E i)]
    [∀ i, IsVLArchimedean (E i)] (P : ArchimedeanFreeProduct E)
    {n m : ℕ} (C : ConeRepresentation.ClosedCone n) (D : ConeRepresentation.ClosedCone m)
    (eC : VecLatEquiv (E ⟨false⟩) (ConeRepresentation.ConeFunctions C))
    (eD : VecLatEquiv (E ⟨true⟩) (ConeRepresentation.ConeFunctions D)) :
    ∃ e : VecLatEquiv P.Carrier
        (ConeRepresentation.ConeFunctions (ConeRepresentation.productCone C D)),
      (∀ x z, (e (P.inclusion ⟨false⟩ x)).val z =
        (eC x).val ⟨fun i ↦ z.val (i.castAdd m), z.property.1⟩) ∧
      ∀ x z, (e (P.inclusion ⟨true⟩ x)).val z =
        (eD x).val ⟨fun j ↦ z.val (j.natAdd n), z.property.2⟩ := by
  obtain ⟨e, hC, hD⟩ := ConeRepresentation.cone_product_equiv P C D eC eD
  exact ⟨e, fun x z ↦ congrArg (fun f ↦ f.val z) (hC x),
    fun x z ↦ congrArg (fun f ↦ f.val z) (hD x)⟩

end VectorLattice
