import FreeProducts.AVLvsVL.Classical.FreeFunctions

/-!
# Closed-cone representations and vanishing ideals

Every finitely generated Archimedean vector lattice is a lattice of restrictions
to a closed cone. This restriction lattice is also the quotient by the vanishing ideal.
-/

universe u

namespace VectorLattice

variable (X : Type u) [AddCommGroup X] [Lattice X]
  [IsOrderedAddMonoid X] [VectorLattice X]

open ConeRepresentation

/-- A vector lattice generated by a finite family. -/
def IsFinitelyGenerated : Prop :=
  ∃ (n : ℕ) (g : Fin n → X),
    VectorSublattice.generated (Set.range g) = ⊤

end VectorLattice

namespace VectorLattice.ConeRepresentation

/-- A closed set containing zero and stable under nonnegative scaling.
No convexity is required. -/
structure ClosedCone (n : ℕ) where
  carrier : Set (Fin n → ℝ)
  isClosed : IsClosed carrier
  zero_mem : 0 ∈ carrier
  smul_mem : ∀ (r : ℝ), 0 ≤ r → ∀ x ∈ carrier, r • x ∈ carrier

open scoped Topology

/-- Restrictions of ambient free vector lattice functions to a closed cone. -/
noncomputable def restrictionSublattice {n : ℕ} (C : ClosedCone n) :
    VectorSublattice (C.carrier → ℝ) where
  carrier := {f | ∃ g : FVL (Fin n), ∀ x : C.carrier, f x = g x.val}
  zero_mem' := by exact ⟨0, fun _ ↦ rfl⟩
  add_mem' := by
    rintro f g ⟨a, ha⟩ ⟨b, hb⟩
    exact ⟨a + b, fun x ↦ congrArg₂ (· + ·) (ha x) (hb x)⟩
  smul_mem' := by
    rintro r f ⟨g, hg⟩
    exact ⟨r • g, fun x ↦ congrArg (r * ·) (hg x)⟩
  sup_mem' := by
    rintro f g ⟨a, ha⟩ ⟨b, hb⟩
    exact ⟨a ⊔ b, fun x ↦ congrArg₂ max (ha x) (hb x)⟩

/-- The vector lattice of restrictions to a closed cone. -/
abbrev ConeFunctions {n : ℕ} (C : ClosedCone n) :=
  ↥(restrictionSublattice C)

/-- A coordinate function restricted to the cone. -/
noncomputable def coordinate {n : ℕ} (C : ClosedCone n) (i : Fin n) :
    ConeFunctions C :=
  ⟨fun x ↦ x.val i, by exact ⟨FVL.of i, fun _ ↦ rfl⟩⟩

/-- Restriction lattices are Archimedean. -/
instance instIsVLArchimedean {n : ℕ} (C : ClosedCone n) :
    IsVLArchimedean (ConeFunctions C) := by
  apply isVLArchimedean_of_eq_zero_of_nonneg_of_forall_nsmul_le
  intro f g hf hfg
  apply Subtype.ext
  funext x
  exact IsVLArchimedean.eq_zero_of_nonneg_of_forall_nsmul_le (show 0 ≤ f.val x from hf x)
    (fun k ↦ show k • f.val x ≤ g.val x from hfg k x)

/-- Restricts an ambient free vector lattice function to the closed cone, as a vector lattice
homomorphism. -/
private noncomputable def restrictionHom {n : ℕ} (C : ClosedCone n) :
    VecLatHom (FVL (Fin n)) (ConeFunctions C) where
  toFun f := ⟨fun x ↦ f x.val, by exact ⟨f, fun _ ↦ rfl⟩⟩
  map_add' := by exact fun _ _ ↦ Subtype.ext rfl
  map_smul' := by exact fun _ _ ↦ Subtype.ext rfl
  map_sup' := by exact fun _ _ ↦ Subtype.ext rfl
  map_inf' := by exact fun _ _ ↦ Subtype.ext rfl

/-- A scalar homomorphism on a free vector lattice evaluates each function at the scalar values of
the free generators. -/
private lemma free_hom_apply {n : ℕ} (φ : VecLatHom (FVL (Fin n)) ℝ)
    (f : FVL (Fin n)) : φ f = f (fun i ↦ φ (FVL.of i)) := by
  let ev : VecLatHom (FVL (Fin n)) ℝ :=
    { toFun := fun g ↦ g (fun i ↦ φ (FVL.of i))
      map_add' := by exact fun _ _ ↦ rfl
      map_smul' := by exact fun _ _ ↦ rfl
      map_sup' := by exact fun _ _ ↦ rfl
      map_inf' := by exact fun _ _ ↦ rfl }
  have h : φ = ev := FVL.hom_ext (fun _ ↦ rfl)
  exact DFunLike.congr_fun h f

/-- The sum of the absolute coordinate values, used to construct homogeneous functions separating
points from cones. -/
private def coneGauge {n : ℕ} (x : Fin n → ℝ) : ℝ := ∑ i, |x i|

/-- The coordinate supremum norm is bounded by the sum of the absolute coordinate values. -/
private lemma norm_le_coneGauge {n : ℕ} (x : Fin n → ℝ) : ‖x‖ ≤ coneGauge x := by
  apply (pi_norm_le_iff_of_nonneg (Finset.sum_nonneg (fun i _ ↦ abs_nonneg (x i)))).mpr
  exact fun i ↦ (Real.norm_eq_abs (x i)).trans_le
    (Finset.single_le_sum (fun j _ ↦ abs_nonneg (x j)) (Finset.mem_univ i))

/-- The coordinate absolute-value sum is an element of the concrete free vector lattice. -/
private lemma coneGauge_mem {n : ℕ} :
    (coneGauge : (Fin n → ℝ) → ℝ) ∈ FVL.concreteSublattice (Fin n) := by
  have heq : (coneGauge : (Fin n → ℝ) → ℝ) = ∑ i : Fin n, |FVL.coordinate i| := by
    ext x
    simp [coneGauge, FVL.coordinate, Finset.sum_apply]
  rw [heq]
  exact (FVL.concreteSublattice (Fin n)).toSubmodule.sum_mem (fun i _ ↦
    (FVL.concreteSublattice (Fin n)).abs_mem (VectorSublattice.subset_generated _ ⟨i, rfl⟩))

/-- The homogeneous positive-part bump used for separation is a free vector lattice function. -/
private lemma cone_bump_mem {n : ℕ} (x : Fin n → ℝ) (ε : ℝ) :
    (fun y ↦ (ε * coneGauge y - coneGauge (coneGauge y • x - coneGauge x • y))⁺) ∈
      FVL.concreteSublattice (Fin n) := by
  let S := FVL.concreteSublattice (Fin n)
  have herror : (fun y ↦ coneGauge (coneGauge y • x - coneGauge x • y)) ∈ S := by
    have heq : (fun y ↦ coneGauge (coneGauge y • x - coneGauge x • y)) =
        ∑ i : Fin n, |x i • coneGauge - coneGauge x • FVL.coordinate i| := by
      ext y
      simp [coneGauge, FVL.coordinate, Finset.sum_apply, mul_comm]
    rw [heq]
    exact S.toSubmodule.sum_mem (fun i _ ↦ S.abs_mem
      (S.sub_mem (S.smul_mem _ coneGauge_mem)
        (S.smul_mem _ (VectorSublattice.subset_generated _ ⟨i, rfl⟩))))
  exact S.posPart_mem (S.sub_mem (S.smul_mem ε coneGauge_mem) herror)

/-- A point lies in the closed cone if every free function vanishing on the cone also vanishes at
that point. -/
private lemma mem_cone_of_vanishing {n : ℕ} (C : ClosedCone n) (x : Fin n → ℝ)
    (hx : ∀ f : FVL (Fin n), (∀ y : C.carrier, f y.val = 0) → f x = 0) :
    x ∈ C.carrier := by
  by_contra hnot
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp C.isClosed.isOpen_compl x hnot
  let f : FVL (Fin n) := ⟨_, cone_bump_mem x ε⟩
  have hzero (y : C.carrier) : f y.val = 0 := by
    apply sup_eq_right.mpr
    by_contra hn
    have hp : coneGauge (coneGauge y.val • x - coneGauge x • y.val) < ε * coneGauge y.val :=
      sub_pos.mp (lt_of_not_ge hn)
    have hypos : 0 < coneGauge y.val := (mul_pos_iff_of_pos_left hε).mp
      ((Finset.sum_nonneg (fun i _ ↦ abs_nonneg _)).trans_lt hp)
    let z := (coneGauge x / coneGauge y.val) • y.val
    have hz : z ∈ C.carrier := C.smul_mem _
      (div_nonneg (Finset.sum_nonneg (fun i _ ↦ abs_nonneg _)) hypos.le) y.val y.property
    have heq : x - z = (coneGauge y.val)⁻¹ •
        (coneGauge y.val • x - coneGauge x • y.val) := by
      simp [z, smul_sub, smul_smul, inv_mul_cancel₀ hypos.ne', div_eq_mul_inv, mul_comm]
    have hd : dist x z < ε := by
      rw [dist_eq_norm, heq, norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hypos)]
      calc
        (coneGauge y.val)⁻¹ * ‖coneGauge y.val • x - coneGauge x • y.val‖ ≤
            (coneGauge y.val)⁻¹ * coneGauge (coneGauge y.val • x - coneGauge x • y.val) :=
          mul_le_mul_of_nonneg_left (norm_le_coneGauge _) (inv_nonneg.mpr hypos.le)
        _ < (coneGauge y.val)⁻¹ * (ε * coneGauge y.val) :=
          mul_lt_mul_of_pos_left hp (inv_pos.mpr hypos)
        _ = ε := by field_simp
    exact hball (by simpa only [Metric.mem_ball, dist_comm] using hd) hz
  have hxne : x ≠ 0 := fun h ↦ hnot (h.symm ▸ C.zero_mem)
  have hxpos : 0 < coneGauge x := (norm_pos_iff.mpr hxne).trans_le (norm_le_coneGauge x)
  have hfx : 0 < f x := by
    change 0 < (ε * coneGauge x - coneGauge (coneGauge x • x - coneGauge x • x))⁺
    simpa only [sub_self, coneGauge, Pi.zero_apply, abs_zero, Finset.sum_const_zero, sub_zero,
      posPart_def]
      using (mul_pos hε hxpos).trans_le (le_sup_left : ε * coneGauge x ≤ (ε * coneGauge x)⁺)
  exact (ne_of_gt hfx) (hx f hzero)

/-- Every real-valued lattice homomorphism on the restriction lattice is evaluation at a point of
the cone. -/
lemma exists_evaluation {n : ℕ} (C : ClosedCone n)
    (φ : VecLatHom (ConeFunctions C) ℝ) :
    ∃ x : C.carrier, ∀ f : ConeFunctions C, φ f = f.val x := by
  let x : Fin n → ℝ := fun i ↦ φ (coordinate C i)
  have hφ (f : FVL (Fin n)) : φ (restrictionHom C f) = f x :=
    free_hom_apply (φ.comp (restrictionHom C)) f
  have hx : x ∈ C.carrier := by
    apply mem_cone_of_vanishing C x
    intro f hf
    have hz : restrictionHom C f = 0 := Subtype.ext (funext hf)
    rw [← hφ, hz, map_zero]
  refine ⟨⟨x, hx⟩, ?_⟩
  intro f
  obtain ⟨g, hg⟩ := f.property
  have heq : f = restrictionHom C g := Subtype.ext (funext hg)
  exact (congrArg φ heq).trans ((hφ g).trans (hg ⟨x, hx⟩).symm)

/-- Two surjective lattice homomorphisms with the same kernel identify their target lattices by an
equivalence compatible with both maps. -/
private lemma equiv_of_common_surjection
    {A X Y : Type*} [AddCommGroup A] [Lattice A] [IsOrderedAddMonoid A] [VectorLattice A]
    [AddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [VectorLattice X]
    [AddCommGroup Y] [Lattice Y] [IsOrderedAddMonoid Y] [VectorLattice Y]
    (f : VecLatHom A X) (g : VecLatHom A Y)
    (hf : Function.Surjective f) (hg : Function.Surjective g)
    (hk : ∀ a, f a = 0 ↔ g a = 0) :
    ∃ e : VecLatEquiv X Y, ∀ a, e (f a) = g a := by
  have hker : LinearMap.ker f.toLinearMap = LinearMap.ker g.toLinearMap := by
    ext a
    exact hk a
  let e₁ := f.toLinearMap.quotKerEquivOfSurjective hf
  let e₂ := g.toLinearMap.quotKerEquivOfSurjective hg
  let e := e₁.symm.trans ((Submodule.quotEquivOfEq _ _ hker).trans e₂)
  have he (a : A) : e (f a) = g a := by
    change g.toLinearMap.quotKerEquivOfSurjective hg
      ((Submodule.quotEquivOfEq _ _ hker)
        ((f.toLinearMap.quotKerEquivOfSurjective hf).symm (f.toLinearMap a))) = g.toLinearMap a
    simp
  refine ⟨{ e with map_sup' := ?_, map_inf' := ?_ }, he⟩
  · intro x y
    obtain ⟨a, rfl⟩ := hf x
    obtain ⟨b, rfl⟩ := hf y
    change e (f a ⊔ f b) = e (f a) ⊔ e (f b)
    rw [← map_sup, he, he, he, map_sup]
  · intro x y
    obtain ⟨a, rfl⟩ := hf x
    obtain ⟨b, rfl⟩ := hf y
    change e (f a ⊓ f b) = e (f a) ⊓ e (f b)
    rw [← map_inf, he, he, he, map_inf]

/-- Real-valued lattice homomorphisms separate nonzero elements of a normed vector lattice with a
strictly positive strong order unit. -/
private lemma normed_unit_separates {D : Type*} [NormedAddCommGroup D] [Lattice D]
    [IsOrderedAddMonoid D] [NormedVectorLattice D]
    (e : D) (he : StrongOrderUnit e) (hepos : 0 < e) {x : D} (hx : x ≠ 0) :
    ∃ φ : VecLatHom D ℝ, φ x ≠ 0 := by
  let H := UniformSpace.Completion D
  let T : VecLatHom D H := toCompletionVecLatHom
  have heH : 0 < (e : H) := by
    simpa only [map_zero, coe_toCompletionVecLatHom] using
      ((toCompletionVecLatHom : VecLatHom D H).monotone.strictMono_of_injective
        (isometry_toCompletionVecLatHom (X := D)).injective) hepos
  let J := (OrderIdeal.principal (e : H)).toVectorSublattice
  let : NormedAddCommGroup J := OrderIdeal.principalNormedAddCommGroup (e : H)
  let : IsUniformlyCompleteVectorLattice H :=
    isUniformlyCompleteVectorLattice_of_banachLattice H
  let : AMSpaceWithUnit J := OrderIdeal.principalAMSpaceWithUnit heH.le
    (IsUniformlyCompleteVectorLattice.complete_principal (e : H) heH)
  have hmem (z : D) : T z ∈ OrderIdeal.principal (T e) := by
    obtain ⟨c, hc, hz⟩ := he.2 z
    refine OrderIdeal.mem_principal.mpr ⟨c, hc, ?_⟩
    simpa only [T.map_abs, map_smul, abs_of_nonneg (T.map_nonneg he.1)] using T.monotone hz
  let j : VecLatHom D J :=
    { T.toLinearMap.codRestrict (OrderIdeal.principal (T e)).toSubmodule hmem with
      map_sup' := by exact fun x y ↦ Subtype.ext (map_sup T x y)
      map_inf' := by exact fun x y ↦ Subtype.ext (map_inf T x y) }
  have hjx : j x ≠ 0 := by
    intro h
    exact hx ((isometry_coe_completion (X := D)).injective (congrArg Subtype.val h))
  let : Nontrivial J := ⟨⟨j x, 0, hjx⟩⟩
  obtain ⟨φ, hφ⟩ := AMSpaceWithUnit.LatticeCharacter.exists_abs_apply_eq_norm (X := J) (j x)
  refine ⟨φ.toVecLatHom.comp j, ?_⟩
  intro h
  change φ (j x) = 0 at h
  exact hjx (norm_eq_zero.mp (hφ.symm.trans (by rw [h, abs_zero])))

/-- Real-valued lattice homomorphisms separate nonzero elements of a finitely generated
Archimedean vector lattice. -/
private lemma finite_generators_separate
    {X : Type*} [AddCommGroup X] [Lattice X] [IsOrderedAddMonoid X]
    [VectorLattice X] [IsVLArchimedean X] {n : ℕ} (g : Fin n → X)
    (hg : VectorSublattice.generated (Set.range g) = ⊤) {x : X} (hx : x ≠ 0) :
    ∃ φ : VecLatHom X ℝ, φ x ≠ 0 := by
  let e := ∑ i, |g i|
  have he : 0 ≤ e := Finset.sum_nonneg (fun i _ ↦ abs_nonneg (g i))
  have hgen (i : Fin n) : g i ∈ OrderIdeal.principal e := by
    refine OrderIdeal.mem_principal.mpr ⟨1, zero_le_one, ?_⟩
    simpa only [abs_of_nonneg he, one_smul] using
      Finset.single_le_sum (fun j _ ↦ abs_nonneg (g j)) (Finset.mem_univ i)
  have hwhole (z : X) : z ∈ OrderIdeal.principal e := by
    have hle := VectorSublattice.generated_le
      (Y := (OrderIdeal.principal e).toVectorSublattice) (Set.range_subset_iff.mpr hgen)
    exact (hg ▸ hle) VectorSublattice.mem_top
  have hepos : 0 < e := by
    apply lt_of_le_of_ne he
    intro h
    have hezero : e = 0 := h.symm
    obtain ⟨c, _, hc⟩ := OrderIdeal.mem_principal.mp (hwhole x)
    have hax : |x| ≤ 0 := by simpa only [hezero, abs_zero, smul_zero] using hc
    exact hx ((abs_eq_zero_iff_zero x).mp (le_antisymm hax (abs_nonneg x)))
  let P := (OrderIdeal.principal e).toVectorSublattice
  let : NormedAddCommGroup P := OrderIdeal.principalNormedAddCommGroup e
  let : NormedVectorLattice P := OrderIdeal.principalNormedVectorLattice e
  let j : VecLatHom X P :=
    { (LinearMap.id : X →ₗ[ℝ] X).codRestrict (OrderIdeal.principal e).toSubmodule hwhole with
      map_sup' := by exact fun _ _ ↦ Subtype.ext rfl
      map_inf' := by exact fun _ _ ↦ Subtype.ext rfl }
  have hu : StrongOrderUnit (j e) := by
    refine ⟨he, ?_⟩
    intro z
    obtain ⟨c, hc, hz⟩ := OrderIdeal.mem_principal.mp z.property
    refine ⟨c, hc, ?_⟩
    change |z.val| ≤ c • e
    simpa only [abs_of_nonneg he] using hz
  obtain ⟨φ, hφ⟩ := normed_unit_separates (j e) hu hepos
    (show j x ≠ 0 from fun h ↦ hx (congrArg Subtype.val h))
  exact ⟨φ.comp j, hφ⟩

/-- The closed cone of coordinate tuples satisfying all free-function relations among the chosen
generators. -/
private noncomputable def relationCone
    {X : Type*} [AddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [VectorLattice X]
    {n : ℕ} (g : Fin n → X) : ClosedCone n where
  carrier := {x | ∀ f : FVL (Fin n), FVL.lift g f = 0 → f x = 0}
  isClosed := by
    simp only [Set.ofPred_forall]
    exact isClosed_iInter (fun f ↦ isClosed_iInter (fun _ ↦
      isClosed_eq ((mem_free_iff f.val).mp f.property).1 continuous_const))
  zero_mem := by
    intro f _
    simpa only [zero_smul, zero_mul] using
      ((mem_free_iff f.val).mp f.property).2.1 0 le_rfl (0 : Fin n → ℝ)
  smul_mem := by
    intro r hr x hx f hf
    rw [((mem_free_iff f.val).mp f.property).2.1 r hr x, hx f hf, mul_zero]

/-- For an Archimedean lattice generated by the chosen family, evaluation on the generators and
restriction to the relation cone have the same kernel. -/
private lemma relationCone_kernel
    {X : Type*} [AddCommGroup X] [Lattice X] [IsOrderedAddMonoid X]
    [VectorLattice X] [IsVLArchimedean X] {n : ℕ} (g : Fin n → X)
    (hg : VectorSublattice.generated (Set.range g) = ⊤) (f : FVL (Fin n)) :
    FVL.lift g f = 0 ↔ restrictionHom (relationCone g) f = 0 := by
  constructor
  · intro hf
    exact Subtype.ext (funext (fun x ↦ x.property f hf))
  · intro hf
    by_contra hne
    obtain ⟨φ, hφ⟩ := finite_generators_separate g hg hne
    let x : Fin n → ℝ := fun i ↦ φ (g i)
    have heval (a : FVL (Fin n)) : φ (FVL.lift g a) = a x := by
      simpa only [VecLatHom.comp_apply, FVL.lift_of] using
        free_hom_apply (φ.comp (FVL.lift g)) a
    have hx : x ∈ (relationCone g).carrier := by
      intro a ha
      rw [← heval, ha, map_zero]
    have hfx : f x = 0 := congrArg (fun z : ConeFunctions (relationCone g) ↦ z.val ⟨x, hx⟩) hf
    exact hφ ((heval f).trans hfx)

/-- A generating family makes the associated free lattice homomorphism surjective. -/
private lemma lift_surjective_of_generated
    {X : Type*} [AddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [VectorLattice X]
    {n : ℕ} (g : Fin n → X) (hg : VectorSublattice.generated (Set.range g) = ⊤) :
    Function.Surjective (FVL.lift g) := by
  intro x
  obtain ⟨a, rfl⟩ : ∃ a : LLexpr n, LLexpr.eval g a = x :=
    (LLexpr.generated_range_eq_combinations g).le (hg.symm ▸ VectorSublattice.mem_top)
  refine ⟨LLexpr.eval FVL.of a, ?_⟩
  rw [LLexpr.map_eval]
  simp only [FVL.lift_of]

/-- Every cone restriction function has an ambient free vector lattice representative. -/
private lemma restrictionHom_surjective {n : ℕ} (C : ClosedCone n) :
    Function.Surjective (restrictionHom C) := by
  intro f
  obtain ⟨g, hg⟩ := f.property
  exact ⟨g, Subtype.ext (funext (fun x ↦ (hg x).symm))⟩

/-- Identifies a finitely generated Archimedean lattice with functions on its relation cone,
sending its generators to coordinates. -/
private lemma representation_from_relations
    {X : Type*} [AddCommGroup X] [Lattice X] [IsOrderedAddMonoid X]
    [VectorLattice X] [IsVLArchimedean X] {n : ℕ} (g : Fin n → X)
    (hg : VectorSublattice.generated (Set.range g) = ⊤) :
    ∃ e : VecLatEquiv X (ConeFunctions (relationCone g)),
      ∀ i, e (g i) = coordinate (relationCone g) i := by
  obtain ⟨e, he⟩ := equiv_of_common_surjection (FVL.lift g) (restrictionHom (relationCone g))
    (lift_surjective_of_generated g hg) (restrictionHom_surjective _) (relationCone_kernel g hg)
  refine ⟨e, ?_⟩
  intro i
  change e (g i) = restrictionHom (relationCone g) (FVL.of i)
  simpa only [FVL.lift_of] using he (FVL.of i)

/-- The finitely many restricted coordinates generate the restriction lattice. -/
theorem generated_range_coordinate {n : ℕ} (C : ClosedCone n) :
    VectorSublattice.generated (Set.range (coordinate C)) = ⊤ := by
  let S := VectorSublattice.generated (Set.range (coordinate C))
  let L := FVL.lift (fun i : Fin n ↦
    (⟨coordinate C i, VectorSublattice.subset_generated _ ⟨i, rfl⟩⟩ : S))
  have hL : S.subtype.comp L = restrictionHom C := by
    apply FVL.hom_ext
    intro i
    change (L (FVL.of i)).val = restrictionHom C (FVL.of i)
    rw [FVL.lift_of]
    rfl
  apply le_antisymm (fun _ _ ↦ VectorSublattice.mem_top)
  intro f _
  obtain ⟨g, rfl⟩ := restrictionHom_surjective C f
  have h := DFunLike.congr_fun hL g
  exact h ▸ (L g).property

/-- A finite generating family in an Archimedean vector lattice is represented
by the coordinates on a closed cone of the same ambient dimension. -/
theorem exists_cone_representation
    (X : Type u) [AddCommGroup X] [Lattice X] [IsOrderedAddMonoid X]
    [VectorLattice X] [IsVLArchimedean X]
    {n : ℕ} (g : Fin n → X)
    (hg : VectorSublattice.generated (Set.range g) = ⊤) :
    ∃ (C : ClosedCone n) (e : VecLatEquiv X (ConeFunctions C)),
      ∀ i, e (g i) = coordinate C i := by
  obtain ⟨e, he⟩ := representation_from_relations g hg
  exact ⟨relationCone g, e, he⟩

/-- The ideal of ambient free vector lattice functions vanishing on a cone. -/
noncomputable def vanishingIdeal {n : ℕ} (C : ClosedCone n) :
    OrderIdeal (FVL (Fin n)) :=
  ⨅ x : C.carrier, OrderIdeal.ofKerVecLatHom (FVL.lift x.val)

/-- Membership in a cone's vanishing ideal means vanishing at every point of the cone. -/
lemma mem_vanishingIdeal {n : ℕ} (C : ClosedCone n) (f : FVL (Fin n)) :
    f ∈ vanishingIdeal C ↔ ∀ x ∈ C.carrier, f x = 0 := by
  simp only [vanishingIdeal, iInf, OrderIdeal.mem_sInf, Set.forall_mem_range]
  change (∀ x : C.carrier, FVL.lift x.val f = 0) ↔ _
  simp only [free_lift_apply, Subtype.forall]

/-- A free function belongs to the vanishing ideal exactly when its support is disjoint from
the cone. -/
lemma mem_vanishingIdeal_iff_disjoint_support {n : ℕ} (C : ClosedCone n)
    (f : FVL (Fin n)) :
    f ∈ vanishingIdeal C ↔ Disjoint (Function.support f) C.carrier := by
  rw [mem_vanishingIdeal, Set.disjoint_left]
  exact ⟨fun h _ hne hx ↦ hne (h _ hx),
    fun h x hx ↦ not_ne_iff.mp (fun hne ↦ h hne hx)⟩

/-- The free homomorphism induced by the cone coordinates acts as ordinary restriction to the
cone. -/
lemma coneRestriction_apply {n : ℕ} (C : ClosedCone n) (f : FVL (Fin n))
    (x : C.carrier) : (FVL.lift (coordinate C) f).val x = f x.val := by
  let T : VecLatHom (FVL (Fin n)) (ConeFunctions C) :=
    { toFun := fun f ↦ ⟨fun x ↦ f x.val, f, fun _ ↦ rfl⟩
      map_add' := fun _ _ ↦ Subtype.ext rfl
      map_smul' := fun _ _ ↦ Subtype.ext rfl
      map_sup' := fun _ _ ↦ Subtype.ext rfl
      map_inf' := fun _ _ ↦ Subtype.ext rfl }
  have h : T = FVL.lift (coordinate C) := FVL.lift_unique _ _ (fun _ ↦ rfl)
  exact congrArg (fun S : VecLatHom (FVL (Fin n)) (ConeFunctions C) ↦ (S f).val x) h.symm

end VectorLattice.ConeRepresentation

namespace VectorLattice

variable (X : Type u) [AddCommGroup X] [Lattice X]
  [IsOrderedAddMonoid X] [VectorLattice X]

open ConeRepresentation

/-- A surjective homomorphic image of a finitely generated vector lattice is finitely
generated. -/
lemma finitely_generated_of_surjective {Y : Type*}
    [AddCommGroup Y] [Lattice Y] [IsOrderedAddMonoid Y] [VectorLattice Y]
    (hX : IsFinitelyGenerated X) (T : VecLatHom X Y) (hT : Function.Surjective T) :
    IsFinitelyGenerated Y := by
  obtain ⟨n, g, hg⟩ := hX
  let L := T.comp (FVL.lift g)
  have hL : Function.Surjective L := hT.comp (lift_surjective_of_generators X g hg)
  exact ⟨n, fun i ↦ L (FVL.of i), generated_range_of_surjective_free Y L hL⟩

/-- The restriction lattice of a cone is the ambient free vector lattice modulo its vanishing
ideal. -/
lemma cone_quotient_equiv {n : ℕ} (C : ClosedCone n) :
    ∃ e : VecLatEquiv (FVL (Fin n) ⧸ (vanishingIdeal C).toSubmodule) (ConeFunctions C),
      ∀ f, e ((vanishingIdeal C).mkQ f) = FVL.lift (coordinate C) f := by
  let Q := FVL.lift (coordinate C)
  have hQ : Function.Surjective Q := by
    intro f
    obtain ⟨F, hF⟩ := f.property
    exact ⟨F, Subtype.ext (funext (fun x ↦ (coneRestriction_apply C F x).trans (hF x).symm))⟩
  have hker : OrderIdeal.ofKerVecLatHom Q = vanishingIdeal C := by
    refine SetLike.ext fun f ↦ ?_
    change Q f = 0 ↔ f ∈ vanishingIdeal C
    rw [mem_vanishingIdeal]
    constructor
    · intro hf x hx
      have h := congrArg (fun F : ConeFunctions C ↦ F.val ⟨x, hx⟩) hf
      exact (coneRestriction_apply C f ⟨x, hx⟩).symm.trans h
    · intro hf
      exact Subtype.ext (funext (fun x ↦ (coneRestriction_apply C f x).trans (hf _ x.property)))
  rw [← hker]
  exact quotient_ker_equiv Q hQ

end VectorLattice
