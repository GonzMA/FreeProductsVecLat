import FreeProducts.AVLvsVL.Classical.Retractions
import FreeProducts.AVLvsVL.Classical.Duality
import Mathlib.Data.List.TFAE
import Mathlib.Data.List.Pairwise

/-!
# Projectivity and finite presentations

Polyhedral representations connect projectivity, finite presentations, principal-ideal
quotients and embeddings into free vector lattices.
-/

universe u

namespace VectorLattice

variable (X : Type u) [AddCommGroup X] [Lattice X]
  [IsOrderedAddMonoid X] [VectorLattice X]

open ConeRepresentation

/-- Every homomorphism into an ideal quotient lifts through the quotient map. -/
def IsProjective : Prop :=
  ∀ (Z : Type u) [AddCommGroup Z] [Lattice Z]
    [IsOrderedAddMonoid Z] [VectorLattice Z]
    (J : OrderIdeal Z) (T : VecLatHom X (Z ⧸ J.toSubmodule)),
    ∃ S : VecLatHom X Z, ∀ x, J.mkQ (S x) = T x

/-- A quotient of a finitely generated free vector lattice by
a finitely generated order ideal. -/
def IsFinitelyPresented : Prop :=
  ∃ (n : ℕ) (s : Finset (FVL (Fin n))),
    Nonempty (VecLatEquiv X
      (FVL (Fin n) ⧸
        (OrderIdeal.generated (s : Set (FVL (Fin n)))).toSubmodule))

end VectorLattice

namespace VectorLattice.ConeRepresentation

/-- The closed cone on which a given free lattice function vanishes. -/
private def zeroCone {n : ℕ} (f : FVL (Fin n)) : ClosedCone n where
  carrier := {x | f x = 0}
  isClosed := isClosed_eq ((mem_free_iff _).mp f.property).1 continuous_const
  zero_mem := by
    change f (0 : Fin n → ℝ) = 0
    simpa only [zero_smul, smul_eq_mul, zero_mul] using
      ((mem_free_iff _).mp f.property).2.1 0 le_rfl (0 : Fin n → ℝ)
  smul_mem := fun r hr x hx ↦ by
    change f (r • x) = 0
    rw [((mem_free_iff _).mp f.property).2.1 r hr x, hx, mul_zero]

/-- The zero set of a free lattice function is closed polyhedral. -/
private lemma zeroCone_polyhedral {n : ℕ} (f : FVL (Fin n)) :
    IsClosedPolyhedralCone (zeroCone f).carrier := by
  convert closedPolyhedral_compl_of_openPolyhedral (isOpenPolyhedralCone_positive |f|) using 1
  ext x
  change f x = 0 ↔ ¬ 0 < |f x|
  simp only [abs_pos, not_not]

/-- Functions vanishing on the zero set of a free function form exactly its principal order
ideal. -/
private lemma vanishingIdeal_zeroCone {n : ℕ} (f : FVL (Fin n)) :
    vanishingIdeal (zeroCone f) = OrderIdeal.principal f := by
  have hf : f ∈ vanishingIdeal (zeroCone f) := (mem_vanishingIdeal _ _).mpr (fun _ hx ↦ hx)
  apply le_antisymm
  · intro g hg
    apply ideal_mem_of_support_subset (OrderIdeal.principal f) (OrderIdeal.self_mem_principal f)
    intro x hx hfx
    exact hx ((mem_vanishingIdeal _ _).mp hg x hfx)
  · rw [OrderIdeal.principal_eq_generated_abs]
    apply OrderIdeal.generated_le
    rintro _ rfl
    exact (vanishingIdeal (zeroCone f)).abs_mem hf

/-- The vanishing ideal of a closed polyhedral cone is generated by one nonnegative free
function. -/
private lemma polyhedral_vanishingIdeal_principal {n : ℕ} (C : ClosedCone n)
    (hC : IsClosedPolyhedralCone C.carrier) :
    ∃ f : FVL (Fin n), 0 ≤ f ∧ vanishingIdeal C = OrderIdeal.principal f := by
  obtain ⟨f, hf, hs⟩ := isOpenPolyhedralCone_iff_support.mp
    (openPolyhedral_compl_of_closedPolyhedral hC C.zero_mem)
  have heq : C.carrier = (zeroCone f).carrier := by
    ext x
    have h := not_congr (Set.ext_iff.mp hs x)
    simpa only [Set.mem_compl_iff, not_not, Function.mem_support, zeroCone, Set.mem_ofPred_eq]
      using h
  refine ⟨f, hf, ?_⟩
  rw [← vanishingIdeal_zeroCone]
  refine SetLike.ext fun g ↦ ?_
  rw [mem_vanishingIdeal, mem_vanishingIdeal, heq]

/-- The whole coordinate space, regarded as a closed cone. -/
private def fullCone (n : ℕ) : ClosedCone n where
  carrier := Set.univ
  isClosed := isClosed_univ
  zero_mem := Set.mem_univ _
  smul_mem := fun _ _ _ _ ↦ Set.mem_univ _

/-- The restriction lattice of the whole coordinate space is canonically the free vector
lattice itself. -/
private lemma fullCone_equiv (n : ℕ) :
    ∃ e : VecLatEquiv (FVL (Fin n)) (ConeFunctions (fullCone n)),
      ∀ f x, (e f).val ⟨x, Set.mem_univ _⟩ = f x := by
  let Q := FVL.lift (coordinate (fullCone n))
  have hinj : Function.Injective Q := by
    intro f g h
    apply Subtype.ext
    funext x
    exact (coneRestriction_apply _ f ⟨x, Set.mem_univ _⟩).symm.trans
      ((congrArg (fun F : ConeFunctions (fullCone n) ↦ F.val ⟨x, Set.mem_univ _⟩) h).trans
        (coneRestriction_apply _ g ⟨x, Set.mem_univ _⟩))
  have hsurj : Function.Surjective Q := by
    intro f
    obtain ⟨F, hF⟩ := f.property
    exact ⟨F, Subtype.ext (funext (fun x ↦ (coneRestriction_apply _ F x).trans (hF x).symm))⟩
  exact ⟨{ LinearEquiv.ofBijective Q.toLinearMap ⟨hinj, hsurj⟩ with
    map_sup' := Q.map_sup'
    map_inf' := Q.map_inf' }, fun f x ↦ coneRestriction_apply _ f ⟨x, Set.mem_univ _⟩⟩

/-- The coordinate map dual to a homomorphism into a finite free lattice takes its values in
the original cone. -/
private lemma finite_hom_dual_image {n m : ℕ} (C : ClosedCone n)
    (T : VecLatHom (ConeFunctions C) (FVL (Fin m))) :
    Set.range (fun x : Fin m → ℝ ↦ fun i ↦ T (coordinate C i) x) ⊆ C.carrier := by
  obtain ⟨e, he⟩ := fullCone_equiv m
  obtain ⟨q, hq, _⟩ := exists_unique_pullback (fullCone m) C (e.toVecLatHom.comp T)
  rintro _ ⟨x, rfl⟩
  have hcoord : (q.toFun ⟨x, Set.mem_univ _⟩).val = (fun i ↦ T (coordinate C i) x) := by
    funext i
    have h := congrArg (fun S : VecLatHom (ConeFunctions C) (ConeFunctions (fullCone m)) ↦
      (S (coordinate C i)).val ⟨x, Set.mem_univ _⟩) hq
    exact h.trans (he (T (coordinate C i)) x)
  change (fun i ↦ T (coordinate C i) x) ∈ C.carrier
  rw [← hcoord]
  exact (q.toFun ⟨x, Set.mem_univ _⟩).property

/-- If a cone's restriction lattice embeds into a finitely generated free lattice, the cone is
polyhedral. -/
private lemma polyhedral_of_finite_free_embedding {n m : ℕ} (C : ClosedCone n)
    (T : VecLatHom (ConeFunctions C) (FVL (Fin m))) (hT : Function.Injective T) :
    IsClosedPolyhedralCone C.carrier := by
  let g (i : Fin n) := T (coordinate C i)
  let image := Set.range (fun x : Fin m → ℝ ↦ fun i ↦ g i x)
  have hpoly : IsClosedPolyhedralCone image := closedPolyhedral_range g
  have hzero : (0 : Fin n → ℝ) ∈ image :=
    ⟨0, funext (fun i ↦ (zeroCone (g i)).zero_mem)⟩
  obtain ⟨f, _, hs⟩ := isOpenPolyhedralCone_iff_support.mp
    (openPolyhedral_compl_of_closedPolyhedral hpoly hzero)
  have hcomp : T.comp (FVL.lift (coordinate C)) = FVL.lift g := by
    apply FVL.hom_ext
    intro i
    simp only [VecLatHom.comp_apply, FVL.lift_of, g]
  have hfzero : T (FVL.lift (coordinate C) f) = 0 := by
    apply Subtype.ext
    funext x
    rw [show T (FVL.lift (coordinate C) f) = FVL.lift g f from DFunLike.congr_fun hcomp f,
      free_substitution_apply]
    by_contra hx
    exact (Set.ext_iff.mp hs _).mpr hx ⟨x, rfl⟩
  have heq : C.carrier = image := by
    apply Set.Subset.antisymm _ (finite_hom_dual_image C T)
    intro x hx
    by_contra hnot
    have hfx : f x ≠ 0 := (Set.ext_iff.mp hs x).mp hnot
    have hf := hT (hfzero.trans (map_zero T).symm)
    exact hfx ((coneRestriction_apply C f ⟨x, hx⟩).symm.trans
      (congrArg (fun F : ConeFunctions C ↦ F.val ⟨x, hx⟩) hf))
  exact heq.symm ▸ hpoly

end VectorLattice.ConeRepresentation

namespace VectorLattice

variable (X : Type u) [AddCommGroup X] [Lattice X]
  [IsOrderedAddMonoid X] [VectorLattice X]

open ConeRepresentation

/-- Every free lattice element is a finite vector lattice expression in free generators. -/
private lemma free_expression {α : Type*} (f : FVL α) :
    ∃ (n : ℕ) (a : Fin n → α) (e : LLexpr n),
      LLexpr.eval (fun i ↦ FVL.of (a i)) e = f := by
  have hf : f ∈ (VectorSublattice.generated (Set.range (FVL.of : α → FVL α)) : Set (FVL α)) :=
    (FVL.generated_range_of (α := α)).symm ▸ VectorSublattice.mem_top
  rw [LLexpr.generated_eq_iUnion_combinations] at hf
  simp only [Set.mem_iUnion, LLexpr.combinations, Set.mem_range] at hf
  obtain ⟨n, v, e, he⟩ := hf
  choose a ha using fun i : Fin n ↦ (v i).property
  exact ⟨n, a, e, (congrArg (fun v : Fin n → FVL α ↦ LLexpr.eval v e) (funext ha)).trans he⟩

/-- A finite family of free lattice elements depends on only finitely many generators. -/
private lemma finite_free_support {α : Type*} {n : ℕ} (g : Fin n → FVL α) :
    ∃ s : Finset α, ∀ T : VecLatHom (FVL α) (FVL α),
      (∀ a ∈ s, T (FVL.of a) = FVL.of a) → ∀ i, T (g i) = g i := by
  classical
  choose k a e he using fun i ↦ free_expression (g i)
  let s := Finset.univ.biUnion (fun i ↦ Finset.univ.image (a i))
  refine ⟨s, fun T hT i ↦ ?_⟩
  rw [← he i, LLexpr.map_eval]
  congr 1
  funext j
  exact hT (a i j) (Finset.mem_biUnion.mpr
    ⟨i, Finset.mem_univ _, Finset.mem_image.mpr ⟨j, Finset.mem_univ _, rfl⟩⟩)

/-- A finitely generated lattice embedded in an arbitrary free lattice already embeds in a
finitely generated free lattice. -/
private lemma finite_free_embedding {α : Type*} (hX : IsFinitelyGenerated X)
    (T : VecLatHom X (FVL α)) (hT : Function.Injective T) :
    ∃ (k : ℕ) (S : VecLatHom X (FVL (Fin k))), Function.Injective S := by
  classical
  obtain ⟨n, g, hg⟩ := hX
  obtain ⟨s, hs⟩ := finite_free_support (fun i ↦ T (g i))
  let β (j : Fin s.card) : α := (s.equivFin.symm j).val
  let v (a : α) : FVL (Fin s.card) :=
    if ha : a ∈ s then FVL.of (s.equivFin ⟨a, ha⟩) else 0
  let Q := FVL.lift v
  let M := FVL.map β
  have hbase (a : α) (ha : a ∈ s) : (M.comp Q) (FVL.of a) = FVL.of a := by
    simp only [M, Q, VecLatHom.comp_apply, FVL.lift_of, v, dite_eq_left ha,
      FVL.map_of, β, Equiv.symm_apply_apply]
  have hcomp : M.comp (Q.comp T) = T :=
    hom_ext_finite_generators X g hg _ _ (hs (M.comp Q) hbase)
  refine ⟨s.card, Q.comp T, fun x y hxy ↦ hT ?_⟩
  exact (DFunLike.congr_fun hcomp x).symm.trans
    ((congrArg M hxy).trans (DFunLike.congr_fun hcomp y))

/-- A cone whose restriction lattice embeds in any free lattice is polyhedral. -/
private lemma polyhedral_of_free_embedding {n : ℕ} {α : Type*} (C : ClosedCone n)
    (T : VecLatHom (ConeFunctions C) (FVL α)) (hT : Function.Injective T) :
    IsClosedPolyhedralCone C.carrier := by
  obtain ⟨k, S, hS⟩ := finite_free_embedding (ConeFunctions C)
    ⟨n, coordinate C, generated_range_coordinate C⟩ T hT
  exact polyhedral_of_finite_free_embedding C S hS

/-- A lattice retract of a free vector lattice is projective. -/
private lemma projective_of_free_retract {α : Type*}
    (R : VecLatHom X (FVL α)) (Q : VecLatHom (FVL α) X) (hQR : ∀ x, Q (R x) = x) :
    IsProjective X := by
  intro Z _ _ _ _ J T
  choose z hz using fun a ↦ J.toSubmodule.mkQ_surjective (T (Q (FVL.of a)))
  have h : J.mkQVecLatHom.comp (FVL.lift z) = T.comp Q := by
    apply FVL.hom_ext
    intro a
    simpa only [VecLatHom.comp_apply, FVL.lift_of, OrderIdeal.mkQVecLatHom_apply] using hz a
  exact ⟨(FVL.lift z).comp R, fun x ↦
    (DFunLike.congr_fun h (R x)).trans (congrArg T (hQR x))⟩

/-- A lattice represented on a closed polyhedral cone is projective, since restriction from
the free lattice splits. -/
private lemma projective_of_polyhedral_representation {n : ℕ} (C : ClosedCone n)
    (e : VecLatEquiv X (ConeFunctions C)) (hC : IsClosedPolyhedralCone C.carrier) :
    IsProjective X := by
  obtain ⟨R, hR⟩ := polyhedral_restriction_splits C hC
  apply projective_of_free_retract X (R.comp e.toVecLatHom)
    (e.symm.toVecLatHom.comp (FVL.lift (coordinate C)))
  intro x
  change e.symm (FVL.lift (coordinate C) (R (e x))) = x
  rw [hR]
  exact e.toLinearEquiv.symm_apply_apply x

/-- A finitely generated projective lattice embeds into a free vector lattice by splitting a
free presentation. -/
private lemma free_embedding_of_projective (hfg : IsFinitelyGenerated X)
    (hX : IsProjective X) :
    ∃ (α : Type u) (T : VecLatHom X (FVL α)), Function.Injective T := by
  obtain ⟨n, g, hg⟩ := hfg
  let α := ULift.{u} (Fin n)
  let Q : VecLatHom (FVL α) X := FVL.lift (fun i ↦ g i.down)
  have hQ : Function.Surjective Q := by
    intro x
    obtain ⟨e, rfl⟩ : ∃ e : LLexpr n, LLexpr.eval g e = x :=
      (LLexpr.generated_range_eq_combinations g).le (hg.symm ▸ VectorSublattice.mem_top)
    refine ⟨LLexpr.eval (fun i ↦ FVL.of (ULift.up i : α)) e, ?_⟩
    rw [LLexpr.map_eval]
    simp only [Q, FVL.lift_of]
  obtain ⟨e, _⟩ := quotient_ker_equiv Q hQ
  obtain ⟨R, hR⟩ := hX (FVL α) (OrderIdeal.ofKerVecLatHom Q) e.symm.toVecLatHom
  refine ⟨α, R, fun x y hxy ↦ e.toLinearEquiv.symm.injective ?_⟩
  exact (hR x).symm.trans ((congrArg (OrderIdeal.ofKerVecLatHom Q).mkQ hxy).trans (hR y))

/-- An ideal generated by a finite set is the principal ideal generated by the sum of the
absolute values of that set. -/
private lemma finite_generated_ideal_principal (s : Finset X) :
    OrderIdeal.generated (s : Set X) = OrderIdeal.principal (∑ x ∈ s, |x|) := by
  have hsum : 0 ≤ ∑ x ∈ s, |x| := Finset.sum_nonneg (fun _ _ ↦ abs_nonneg _)
  apply le_antisymm
  · apply OrderIdeal.generated_le
    intro x hx
    refine ⟨1, zero_le_one, ?_⟩
    rw [one_smul, abs_of_nonneg hsum]
    exact Finset.single_le_sum (fun _ _ ↦ abs_nonneg _) hx
  · rw [OrderIdeal.principal_eq_generated_abs]
    apply OrderIdeal.generated_le
    rintro _ rfl
    apply (OrderIdeal.generated (s : Set X)).abs_mem
    exact (OrderIdeal.generated (s : Set X)).toSubmodule.sum_mem
      (fun x hx ↦ (OrderIdeal.generated (s : Set X)).abs_mem
        (OrderIdeal.subset_generated _ hx))

/-- A finitely presented vector lattice is projective. -/
private lemma projective_of_finitely_presented (hX : IsFinitelyPresented X) : IsProjective X := by
  obtain ⟨n, s, ⟨e⟩⟩ := hX
  let f : FVL (Fin n) := ∑ x ∈ s, |x|
  have hJ : OrderIdeal.generated (s : Set (FVL (Fin n))) = vanishingIdeal (zeroCone f) :=
    (finite_generated_ideal_principal _ s).trans (vanishingIdeal_zeroCone f).symm
  have hq : Nonempty (VecLatEquiv
      (FVL (Fin n) ⧸ (OrderIdeal.generated (s : Set (FVL (Fin n)))).toSubmodule)
      (ConeFunctions (zeroCone f))) := by
    rw [hJ]
    exact ⟨(cone_quotient_equiv (zeroCone f)).choose⟩
  exact projective_of_polyhedral_representation X (zeroCone f) (e.trans hq.some)
    (zeroCone_polyhedral f)

/-- A lattice represented on a closed polyhedral cone has a finite presentation. -/
private lemma finitely_presented_of_polyhedral_representation {n : ℕ} (C : ClosedCone n)
    (e : VecLatEquiv X (ConeFunctions C)) (hC : IsClosedPolyhedralCone C.carrier) :
    IsFinitelyPresented X := by
  obtain ⟨f, _, hf⟩ := polyhedral_vanishingIdeal_principal C hC
  obtain ⟨q, _⟩ := cone_quotient_equiv C
  have hJ : vanishingIdeal C = OrderIdeal.generated ({|f|} : Set (FVL (Fin n))) :=
    hf.trans (OrderIdeal.principal_eq_generated_abs f)
  have he (J : OrderIdeal (FVL (Fin n))) (hJ : vanishingIdeal C = J) :
      Nonempty (VecLatEquiv X (FVL (Fin n) ⧸ J.toSubmodule)) := by
    subst J
    exact ⟨e.trans q.symm⟩
  exact ⟨n, {|f|}, he _ (by simpa only [Finset.coe_singleton] using hJ)⟩

/-- A finite presentation can be given by a single principal order ideal in a finite free
vector lattice. -/
theorem isFinitelyPresented_iff_principal_quotient :
    IsFinitelyPresented X ↔
      ∃ (n : ℕ) (f : FVL (Fin n)),
        Nonempty (VecLatEquiv X (FVL (Fin n) ⧸ (OrderIdeal.principal f).toSubmodule)) := by
  constructor
  · rintro ⟨n, s, he⟩
    refine ⟨n, ∑ f ∈ s, |f|, ?_⟩
    exact (congrArg (fun J : OrderIdeal (FVL (Fin n)) ↦
      Nonempty (VecLatEquiv X (FVL (Fin n) ⧸ J.toSubmodule)))
        (finite_generated_ideal_principal _ s)).mp he
  · rintro ⟨n, f, he⟩
    refine ⟨n, {|f|}, ?_⟩
    exact (congrArg (fun J : OrderIdeal (FVL (Fin n)) ↦
      Nonempty (VecLatEquiv X (FVL (Fin n) ⧸ J.toSubmodule)))
        (show OrderIdeal.principal f =
            OrderIdeal.generated (({|f|} : Finset (FVL (Fin n))) : Set (FVL (Fin n))) by
          simpa only [Finset.coe_singleton] using OrderIdeal.principal_eq_generated_abs f)).mp he

/-- For a finitely generated Archimedean vector lattice, free embeddability, projectivity,
finite presentation, polyhedrality of every representing cone, and presentation by a
principal ideal of a finite free vector lattice are equivalent. -/
theorem finitely_generated_projective_tfae [IsVLArchimedean X]
    (hX : IsFinitelyGenerated X) :
    List.TFAE [
      (∃ (α : Type u) (T : VecLatHom X (FVL α)), Function.Injective T),
      IsProjective X,
      IsFinitelyPresented X,
      (∀ (n : ℕ) (C : ClosedCone n),
        Nonempty (VecLatEquiv X (ConeFunctions C)) → IsClosedPolyhedralCone C.carrier),
      (∃ (n : ℕ) (f : FVL (Fin n)),
        Nonempty (VecLatEquiv X (FVL (Fin n) ⧸ (OrderIdeal.principal f).toSubmodule)))
    ] := by
  obtain ⟨n, g, hg⟩ := hX
  obtain ⟨C, e, _⟩ := exists_cone_representation X g hg
  tfae_have 1 → 4 := fun ⟨_, T, hT⟩ _ D ⟨eD⟩ ↦
    polyhedral_of_free_embedding D (T.comp eD.symm.toVecLatHom)
      (hT.comp eD.toLinearEquiv.symm.injective)
  tfae_have 4 → 3 := fun h ↦ finitely_presented_of_polyhedral_representation X C e (h n C ⟨e⟩)
  tfae_have 3 → 2 := projective_of_finitely_presented X
  tfae_have 2 → 1 := free_embedding_of_projective X ⟨n, g, hg⟩
  tfae_have 3 ↔ 5 := isFinitelyPresented_iff_principal_quotient X
  tfae_finish

end VectorLattice
