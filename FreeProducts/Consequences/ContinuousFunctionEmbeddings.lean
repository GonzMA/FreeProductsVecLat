import FreeProducts.BanachLattice.Join
import FreeProducts.TensorProducts.Banach

/-!
# Embeddings of continuous-function free products

Injective lattice homomorphisms from continuous-function lattices induce injective
maps on their Banach lattice free products, using local quotients and tensor pairings.
-/

namespace BanachLattice.FreeProduct

universe u v

/-- Fixing a positive right tensor factor gives a bounded lattice homomorphism in the left
factor. -/
private lemma exists_tensor_hom_left
    {E F : Type u}
    [NormedAddCommGroup E] [Lattice E] [IsOrderedAddMonoid E] [BanachLattice E]
    [NormedAddCommGroup F] [Lattice F] [IsOrderedAddMonoid F] [BanachLattice F]
    (B : TensorPairing E F) (y : F) (hy : 0 ≤ y) :
    ∃ A : E →L[ℝ] B.Carrier, IsVecLatHom A ∧ ∀ x, A x = B.tmul x y := by
  exact ⟨B.tmul.flip y, B.isVecLatHom_left y hy, fun _ ↦ rfl⟩

/-- Fixing a positive left tensor factor gives a bounded lattice homomorphism in the right
factor. -/
private lemma exists_tensor_hom_right
    {E F : Type u}
    [NormedAddCommGroup E] [Lattice E] [IsOrderedAddMonoid E] [BanachLattice E]
    [NormedAddCommGroup F] [Lattice F] [IsOrderedAddMonoid F] [BanachLattice F]
    (B : TensorPairing E F) (x : E) (hx : 0 ≤ x) :
    ∃ A : F →L[ℝ] B.Carrier, IsVecLatHom A ∧ ∀ y, A y = B.tmul x y := by
  exact ⟨B.tmul x, B.isVecLatHom_right x hx, fun _ ↦ rfl⟩

section Neighborhoods

variable {A Y : Type u} [TopologicalSpace A]
  [NormedAddCommGroup Y] [Lattice Y] [IsOrderedAddMonoid Y] [BanachLattice Y]

/-- Images of a function vanishing on a set and a function supported in that set are disjoint
under a lattice homomorphism. -/
private lemma map_zeroOn_disjoint
    (T : C(A, ℝ) →L[ℝ] Y) (hT : IsVecLatHom T)
    (U : Set A) (f g : C(A, ℝ)) (hf : Set.EqOn f 0 U)
    (hg : Function.support g ⊆ U) : IsVLDisjoint (T f) (T g) := by
  have hfg : |f| ⊓ |g| = 0 := by
    refine ContinuousMap.ext (fun a ↦ ?_)
    by_cases ha : a ∈ U
    · simp [hf ha, abs_nonneg]
    · have hg0 : g a = 0 := not_not.mp (fun h ↦ ha (hg h))
      simp [hg0, inf_of_le_right, abs_nonneg]
  change |(hT.mk' T) f| ⊓ |(hT.mk' T) g| = 0
  rw [← VecLatHom.map_abs, ← VecLatHom.map_abs, ← map_inf, hfg, map_zero]

/-- A finite family of continuous functions varies by at most a prescribed positive tolerance
on a common neighborhood of a point. -/
private lemma exists_function_neighborhood {n : ℕ}
    (f : Fin n → C(A, ℝ)) (a : A) (δ : ℝ) (hδ : 0 < δ) :
    ∃ U : Set A, IsOpen U ∧ a ∈ U ∧ ∀ i x, x ∈ U → |f i x - f i a| ≤ δ := by
  refine ⟨⋂ i, {x | |f i x - f i a| < δ},
    isOpen_iInter_of_finite (fun i ↦
      isOpen_lt (((f i).continuous.sub continuous_const).abs) continuous_const), ?_,
    fun i x hx ↦ (Set.mem_iInter.mp hx i).le⟩
  simpa only [Set.mem_iInter, Set.mem_ofPred_eq, sub_self, abs_zero] using fun _ ↦ hδ

/-- Point evaluation multiplied by a positive vector is a lattice homomorphism. -/
private lemma exists_pointwise_hom (a : A) (w : Y) (hw : 0 ≤ w) :
    ∃ F : VecLatHom C(A, ℝ) Y, ∀ f, F f = f a • w := by
  refine ⟨VecLatHom.ofAbs ((ContinuousMap.evalCLM ℝ a).toLinearMap.smulRight w)
    (fun f ↦ ?_), fun _ ↦ rfl⟩
  exact (congrArg (|f a| • ·) (abs_of_nonneg hw).symm).trans (abs_smul' w (f a)).symm

/-- The closed ideal generated by images of functions vanishing on a set is disjoint from the
image of every function supported there. -/
private lemma local_zero_ideal_disjoint
    (T : C(A, ℝ) →L[ℝ] Y) (hT : IsVecLatHom T)
    (U : Set A) (g : C(A, ℝ)) (hg : Function.support g ⊆ U) :
    (OrderIdeal.generated (T '' {f : C(A, ℝ) | Set.EqOn f 0 U})).topologicalClosure ≤
      (Band.disjointComplement {T g}).toOrderIdeal := by
  apply closure_minimal _ (isClosed_disjointComplement {T g})
  apply OrderIdeal.generated_le (J := (Band.disjointComplement {T g}).toOrderIdeal)
  rintro _ ⟨f, hf, rfl⟩ v (hv : v ∈ ({T g} : Set Y))
  exact (Set.mem_singleton_iff.mp hv).symm ▸ map_zeroOn_disjoint T hT U f g hf hg

/-- For an injective function-lattice map, the image of one survives the quotient by functions
vanishing on a neighborhood. -/
lemma local_zero_ideal_unit_not_mem [CompactSpace A] [T2Space A]
    (T : C(A, ℝ) →L[ℝ] Y) (hT : IsVecLatHom T) (hinj : Function.Injective T)
    (a : A) (U : Set A) (hU : IsOpen U) (ha : a ∈ U) :
    T 1 ∉ (OrderIdeal.generated (T '' {f : C(A, ℝ) | Set.EqOn f 0 U})).topologicalClosure := by
  obtain ⟨g, hg1, _, hgs, hg01⟩ :=
    exists_continuousMap_one_of_isCompact_subset_isOpen isCompact_singleton hU
      (Set.singleton_subset_iff.mpr ha)
  intro hunit
  have hmem := (OrderIdeal.generated
    (T '' {f : C(A, ℝ) | Set.EqOn f 0 U})).topologicalClosure.solid hunit
      ((hT.mk' T).map_nonneg (fun x ↦ (hg01 x).1))
      ((hT.mk' T).monotone (fun x ↦ (hg01 x).2))
  have hdis := local_zero_ideal_disjoint T hT U g
    ((subset_closure : Function.support g ⊆ tsupport g).trans hgs)
    hmem (T g) (Set.mem_singleton _)
  have hz : g = 0 := hinj (((abs_eq_zero_iff_zero (T g)).mp
    ((inf_idem _).symm.trans hdis)).trans (map_zero T).symm)
  simpa [hz] using hg1 (Set.mem_singleton a)

/-- A local bound on a function's deviation from its value at a point becomes an order bound
in the corresponding quotient. -/
lemma local_quotient_estimate
    (T : C(A, ℝ) →L[ℝ] Y) (hT : IsVecLatHom T)
    (U : Set A) (a : A) (J : OrderIdeal Y)
    (hJ : ∀ f : C(A, ℝ), Set.EqOn f 0 U → T f ∈ J)
    (f : C(A, ℝ)) (ε : ℝ) (hf : ∀ x ∈ U, |f x - f a| ≤ ε) :
    |J.mkQ (T f) - f a • J.mkQ (T 1)| ≤ ε • J.mkQ (T 1) := by
  let F := J.mkQVecLatHom.comp (hT.mk' T)
  change |F f - f a • F 1| ≤ ε • F 1
  apply sub_nonpos.mp
  apply posPart_eq_zero.mp
  have hzero : Set.EqOn ((|f - f a • 1| - ε • 1)⁺ : C(A, ℝ)) 0 U :=
    fun x hx ↦ by simpa [posPart_def] using (max_eq_right (sub_nonpos.mpr (hf x hx)))
  have hq : F (|f - f a • 1| - ε • 1)⁺ = 0 :=
    (Submodule.Quotient.mk_eq_zero J.toSubmodule).mpr (hJ _ hzero)
  simpa only [VecLatHom.map_posPart, map_sub, VecLatHom.map_abs, map_smul] using hq

/-- Constructs a closed-ideal quotient in which the unit survives and function values admit
the required local approximation estimate. -/
private lemma exists_neighborhood_quotient [CompactSpace A] [T2Space A]
    (T : C(A, ℝ) →L[ℝ] Y) (hT : IsVecLatHom T) (hinj : Function.Injective T)
    (a : A) (U : Set A) (hU : IsOpen U) (ha : a ∈ U) :
    ∃ J : OrderIdeal Y, IsClosed (J : Set Y) ∧ J.mkQ (T 1) ≠ 0 ∧
      ∀ (f : C(A, ℝ)) (ε : ℝ), (∀ x ∈ U, |f x - f a| ≤ ε) →
        |J.mkQ (T f) - f a • J.mkQ (T 1)| ≤ ε • J.mkQ (T 1) := by
  refine ⟨(OrderIdeal.generated (T '' {f : C(A, ℝ) | Set.EqOn f 0 U})).topologicalClosure,
    isClosed_closure, ?_, ?_⟩
  · exact fun h ↦ local_zero_ideal_unit_not_mem T hT hinj a U hU ha
      ((Submodule.Quotient.mk_eq_zero _).mp h)
  · exact fun f ε hf ↦ local_quotient_estimate T hT U a _
      (fun g hg ↦ subset_closure (OrderIdeal.subset_generated
        (T '' {v : C(A, ℝ) | Set.EqOn v 0 U}) ⟨g, hg, rfl⟩)) f ε hf

end Neighborhoods

/-- A homomorphism from continuous functions bounds each image by the function norm times the
image of one. -/
private lemma hom_abs_le_norm_one
    {A Y : Type u} [TopologicalSpace A] [CompactSpace A]
    [AddCommGroup Y] [Lattice Y] [IsOrderedAddMonoid Y] [VectorLattice Y]
    (F : VecLatHom C(A, ℝ) Y) (f : C(A, ℝ)) : |F f| ≤ ‖f‖ • F 1 := by
  have hf : |f| ≤ ‖f‖ • (1 : C(A, ℝ)) :=
    fun a ↦ by simpa using f.norm_coe_le_norm a
  exact (F.map_abs f).symm.le.trans ((F.monotone hf).trans_eq (map_smul F ‖f‖ 1))

/-- A lattice homomorphism transfers an order error estimate when the controlling unit maps to
a scalar multiple of a positive vector. -/
private lemma map_error_bound
    {Y Z : Type u}
    [AddCommGroup Y] [Lattice Y] [IsOrderedAddMonoid Y] [VectorLattice Y]
    [AddCommGroup Z] [Lattice Z] [IsOrderedAddMonoid Z] [VectorLattice Z]
    (F : VecLatHom Y Z) {v e : Y} {w : Z} {c δ α : ℝ}
    (hδ : 0 ≤ δ) (hα : α ≤ 1) (hw : 0 ≤ w)
    (hFe : F e = α • w) (hv : |v - c • e| ≤ δ • e) :
    |F v - (α * c) • w| ≤ δ • w := by
  have h := F.monotone hv
  have h' : |F v - (α * c) • w| ≤ (δ * α) • w := by
    simpa only [VecLatHom.map_abs, map_sub, map_smul, hFe, smul_smul, mul_comm c α] using h
  exact h'.trans (smul_le_smul_of_nonneg_right (mul_le_of_le_one_right hδ hα) hw)

/-- Every finite lattice expression has a uniform error constant controlling its output from
common order bounds on input errors. -/
lemma exists_expression_error_bound {n : ℕ} (e : LLexpr n) :
    ∃ c : ℝ, 0 ≤ c ∧
      ∀ (Y : Type u) [AddCommGroup Y] [Lattice Y]
        [IsOrderedAddMonoid Y] [VectorLattice Y]
        (x y : Fin n → Y) (w : Y) (δ : ℝ),
        (∀ i, |x i - y i| ≤ δ • w) →
          |LLexpr.eval x e - LLexpr.eval y e| ≤ (c * δ) • w := by
  induction e with
  | zero => exact ⟨0, le_rfl, fun Y _ _ _ _ x y w δ _ ↦ by simp [LLexpr.eval]⟩
  | var i => exact ⟨1, zero_le_one, fun Y _ _ _ _ x y w δ h ↦ by
      simpa only [LLexpr.eval_var, one_mul] using h i⟩
  | add a b ha hb =>
    obtain ⟨c, hc, hca⟩ := ha
    obtain ⟨d, hd, hdb⟩ := hb
    refine ⟨c + d, add_nonneg hc hd, fun Y _ _ _ _ x y w δ h ↦ ?_⟩
    rw [LLexpr.eval_add, LLexpr.eval_add, add_sub_add_comm]
    exact (abs_add_le _ _).trans
      ((add_le_add (hca Y x y w δ h) (hdb Y x y w δ h)).trans_eq
        (by rw [← add_smul, ← add_mul]))
  | smul r a ha =>
    obtain ⟨c, hc, hca⟩ := ha
    refine ⟨|r| * c, mul_nonneg (abs_nonneg r) hc, fun Y _ _ _ _ x y w δ h ↦ ?_⟩
    change |r • LLexpr.eval x a - r • LLexpr.eval y a| ≤ (|r| * c * δ) • w
    rw [← smul_sub, abs_smul']
    exact (smul_le_smul_of_nonneg_left (hca Y x y w δ h) (abs_nonneg r)).trans_eq
      (by rw [smul_smul, mul_assoc])
  | sup a b ha hb =>
    obtain ⟨c, hc, hca⟩ := ha
    obtain ⟨d, hd, hdb⟩ := hb
    exact ⟨c + d, add_nonneg hc hd, fun Y _ _ _ _ x y w δ h ↦
      (abs_sup_sub_sup_le_add (LLexpr.eval x a) (LLexpr.eval x b)
        (LLexpr.eval y a) (LLexpr.eval y b)).trans
          ((add_le_add (hca Y x y w δ h) (hdb Y x y w δ h)).trans_eq
            (by rw [← add_smul, ← add_mul]))⟩
  | inf a b ha hb =>
    obtain ⟨c, hc, hca⟩ := ha
    obtain ⟨d, hd, hdb⟩ := hb
    refine ⟨c + d, add_nonneg hc hd, fun Y _ _ _ _ x y w δ h ↦ ?_⟩
    refine le_trans ?_ ((add_le_add (hca Y x y w δ h) (hdb Y x y w δ h)).trans_eq
      (by rw [← add_smul, ← add_mul]))
    simpa only [LLexpr.eval_inf, ← neg_inf, neg_sub_neg, abs_sub_comm] using
      abs_sup_sub_sup_le_add (-LLexpr.eval x a) (-LLexpr.eval x b)
        (-LLexpr.eval y a) (-LLexpr.eval y b)

section ContinuousFunctions

variable (K : Bool → Type u)
  [∀ b, TopologicalSpace (K b)] [∀ b, CompactSpace (K b)]
  [∀ b, T2Space (K b)] [∀ b, Nonempty (K b)]
  (X : Bool → Type u)
  [∀ b, NormedAddCommGroup (X b)] [∀ b, Lattice (X b)]
  [∀ b, IsOrderedAddMonoid (X b)] [∀ b, BanachLattice (X b)]

omit [∀ b, Nonempty (K b)] in
/-- Builds local quotient and tensor maps that approximate the factor evaluations at a
selected join point. -/
private lemma exists_local_tensor_maps
    (P : FreeProduct (fun b ↦ C(K b, ℝ))) (Q : FreeProduct X)
    (T : ∀ b, C(K b, ℝ) →L[ℝ] X b)
    (hT : ∀ b, IsVecLatHom (T b)) (hinj : ∀ b, Function.Injective (T b))
    (S : P.Carrier →L[ℝ] Q.Carrier)
    (hcomm : ∀ b f, S (P.inclusion b f) = Q.inclusion b (T b f))
    {n : ℕ} (f : ∀ b, Fin n → C(K b, ℝ)) (a : ∀ b, K b)
    (t : Set.Icc (0 : ℝ) 1) (δ : ℝ) (hδ : 0 < δ) :
    ∃ (J : ∀ b, OrderIdeal (X b)) (hc : ∀ b, IsClosed (J b : Set (X b))),
      letI : ∀ b, NormedAddCommGroup (X b ⧸ (J b).toSubmodule) :=
        fun b ↦ (J b).quotientNormedAddCommGroup (hc b)
      letI : ∀ b, BanachLattice (X b ⧸ (J b).toSubmodule) :=
        fun b ↦ (J b).quotientBanachLattice (hc b)
      ∃ (B : TensorPairing
          (X false ⧸ (J false).toSubmodule) (X true ⧸ (J true).toSubmodule))
        (R : Q.Carrier →L[ℝ] B.Carrier) (w : B.Carrier),
        IsVecLatHom R ∧ 0 < w ∧
        R (S (P.inclusion false 1 + P.inclusion true 1)) = w ∧
        ∀ b j, |R (S (P.inclusion b (f b j))) -
          ((Bool.rec (1 - (t : ℝ)) (t : ℝ) b) * f b j (a b)) • w| ≤ δ • w := by
  choose U hU haU hlocal using
    fun b ↦ exists_function_neighborhood (f b) (a b) δ hδ
  choose J hc hunit hestimate using
    fun b ↦ exists_neighborhood_quotient (T b) (hT b) (hinj b) (a b) (U b) (hU b) (haU b)
  let : ∀ b, NormedAddCommGroup (X b ⧸ (J b).toSubmodule) :=
    fun b ↦ (J b).quotientNormedAddCommGroup (hc b)
  let : ∀ b, BanachLattice (X b ⧸ (J b).toSubmodule) :=
    fun b ↦ (J b).quotientBanachLattice (hc b)
  let q (b : Bool) : X b →L[ℝ] (X b ⧸ (J b).toSubmodule) := (J b).toSubmodule.mkQL
  have hq (b : Bool) : IsVecLatHom (q b) := (J b).mkQVecLatHom.isVecLatHom
  let e (b : Bool) := q b (T b 1)
  have hepos (b : Bool) : 0 ≤ e b :=
    ((hq b).mk' (q b)).map_nonneg (((hT b).mk' (T b)).map_nonneg (fun _ ↦ zero_le_one))
  let B := ProjectiveTensor.tensorPairing
    (X false ⧸ (J false).toSubmodule) (X true ⧸ (J true).toSubmodule)
  let w := B.tmul (e false) (e true)
  have hw : 0 < w := B.tmul_pos _ _
    (lt_of_le_of_ne (hepos false) (hunit false).symm)
    (lt_of_le_of_ne (hepos true) (hunit true).symm)
  obtain ⟨A, hA, hAv⟩ := exists_tensor_hom_left B ((1 - (t : ℝ)) • e true)
    (smul_nonneg (sub_nonneg.mpr t.property.2) (hepos true))
  obtain ⟨D, hD, hDv⟩ := exists_tensor_hom_right B ((t : ℝ) • e false)
    (smul_nonneg t.property.1 (hepos false))
  let V : ∀ b, X b →L[ℝ] B.Carrier := Bool.rec (A.comp (q false)) (D.comp (q true))
  have hV : ∀ b, IsVecLatHom (V b) := Bool.rec
    ((hA.mk' A).comp ((hq false).mk' (q false))).isVecLatHom
    ((hD.mk' D).comp ((hq true).mk' (q true))).isVecLatHom
  obtain ⟨R, hR, _⟩ := Q.exists_unique_extension B.Carrier V hV
    (‖V false‖ + ‖V true‖) (add_nonneg (norm_nonneg _) (norm_nonneg _))
    (Bool.rec (le_add_of_nonneg_right (norm_nonneg (V true)))
      (le_add_of_nonneg_left (norm_nonneg (V false))))
  refine ⟨J, hc, B, R, w, hR.1, hw, ?_, ?_⟩
  · rw [map_add, map_add, hcomm, hcomm, hR.2.1, hR.2.1]
    change A (e false) + D (e true) = w
    rw [hAv, hDv]
    simp only [map_smul, smul_apply, ← add_smul, sub_add_cancel, one_smul, w]
  · refine Bool.rec (fun j ↦ ?_) (fun j ↦ ?_)
    · rw [hcomm, hR.2.1]
      change |A (q false (T false (f false j))) -
        ((1 - (t : ℝ)) * f false j (a false)) • w| ≤ δ • w
      apply map_error_bound (hA.mk' A) hδ.le (sub_le_self 1 t.property.1) hw.le _
        (hestimate false (f false j) δ (hlocal false j))
      simp only [IsVecLatHom.mk'_apply, hAv, map_smul, w]
      rfl
    · rw [hcomm, hR.2.1]
      change |D (q true (T true (f true j))) -
        ((t : ℝ) * f true j (a true)) • w| ≤ δ • w
      apply map_error_bound (hD.mk' D) hδ.le t.property.2 hw.le _
        (hestimate true (f true j) δ (hlocal true j))
      simp only [IsVecLatHom.mk'_apply, hDv, map_smul, w]
      rfl

omit [∀ b, Nonempty (K b)] [∀ b, T2Space (K b)] in
/-- The sum of the two included factor units becomes the constant one in the join
representation. -/
private lemma join_unit_eq_one
    (P : FreeProduct (fun b ↦ C(K b, ℝ)))
    (e : VecLatEquiv P.Carrier C(Join (K false) (K true), ℝ))
    (hleft : ∀ f, e (P.inclusion false f) = interpolate (K false) (K true) f 0)
    (hright : ∀ g, e (P.inclusion true g) = interpolate (K false) (K true) 0 g) :
    e (P.inclusion false 1 + P.inclusion true 1) = 1 := by
  change e.toVecLatHom (P.inclusion false 1 + P.inclusion true 1) = 1
  rw [map_add]
  change e (P.inclusion false 1) + e (P.inclusion true 1) = 1
  rw [hleft, hright]
  exact ContinuousMap.ext (fun p ↦ Quotient.inductionOn p (fun q ↦ by
    change ((1 - (q.2.2 : ℝ)) * 1 + (q.2.2 : ℝ) * 0) +
      ((1 - (q.2.2 : ℝ)) * 0 + (q.2.2 : ℝ) * 1) = 1
    ring))

omit [∀ b, Nonempty (K b)] [∀ b, T2Space (K b)] in
/-- At a join point, the two included factor functions evaluate with weights one minus the
interval coordinate and the interval coordinate. -/
private lemma join_eval_inclusion
    (P : FreeProduct (fun b ↦ C(K b, ℝ)))
    (e : VecLatEquiv P.Carrier C(Join (K false) (K true), ℝ))
    (hleft : ∀ f, e (P.inclusion false f) = interpolate (K false) (K true) f 0)
    (hright : ∀ g, e (P.inclusion true g) = interpolate (K false) (K true) 0 g)
    (a : ∀ b, K b) (t : Set.Icc (0 : ℝ) 1) :
    ∀ b (f : C(K b, ℝ)),
      e (P.inclusion b f) (joinMk (K false) (K true) (a false) (a true) t) =
        Bool.rec (1 - (t : ℝ)) (t : ℝ) b * f (a b) := by
  exact Bool.rec
    (fun f ↦ by simp only [hleft, interpolate_joinMk, ContinuousMap.zero_apply,
      mul_zero, add_zero])
    (fun f ↦ by simp only [hright, interpolate_joinMk, ContinuousMap.zero_apply,
      mul_zero, zero_add])

/-- Approximation by a nearby continuous function transfers a local comparison between two
unital homomorphisms, with three times the original error. -/
private lemma hom_approximation_error
    {A Y : Type u} [TopologicalSpace A] [CompactSpace A]
    [NormedAddCommGroup Y] [Lattice Y] [IsOrderedAddMonoid Y] [BanachLattice Y]
    (F G : VecLatHom C(A, ℝ) Y) (w : Y) (hw : 0 ≤ w)
    (hF : F 1 = w) (hG : G 1 = w) (f g : C(A, ℝ)) (r : ℝ)
    (hnorm : ‖f - g‖ ≤ r) (hlocal : |F g - G g| ≤ r • w) :
    |F f - G f| ≤ (3 * r) • w := by
  have hFd : |F f - F g| ≤ r • w :=
    (show |F f - F g| ≤ ‖f - g‖ • w from by
      simpa only [map_sub, hF] using hom_abs_le_norm_one F (f - g)).trans
        (smul_le_smul_of_nonneg_right hnorm hw)
  have hGd : |G g - G f| ≤ r • w :=
    (show |G g - G f| ≤ ‖f - g‖ • w from by
      simpa only [map_sub, hG, abs_sub_comm] using hom_abs_le_norm_one G (f - g)).trans
        (smul_le_smul_of_nonneg_right hnorm hw)
  have htri := (abs_add_le (F f - F g + (F g - G g)) (G g - G f)).trans
    (add_le_add ((abs_add_le (F f - F g) (F g - G g)).trans
      (add_le_add hFd hlocal)) hGd)
  simpa only [sub_add_sub_cancel, ← add_smul, show r + r + r = 3 * r by ring] using htri

omit [∀ b, Nonempty (K b)] in
/-- An element killed by the induced free-product map vanishes at every point in the join
representation. -/
private lemma kernel_join_eval_zero
    (P : FreeProduct (fun b ↦ C(K b, ℝ))) (Q : FreeProduct X)
    (T : ∀ b, C(K b, ℝ) →L[ℝ] X b)
    (hT : ∀ b, IsVecLatHom (T b)) (hinj : ∀ b, Function.Injective (T b))
    (S : P.Carrier →L[ℝ] Q.Carrier) (hS : IsVecLatHom S)
    (hcomm : ∀ b f, S (P.inclusion b f) = Q.inclusion b (T b f))
    (e : VecLatEquiv P.Carrier C(Join (K false) (K true), ℝ))
    (hleft : ∀ f, e (P.inclusion false f) = interpolate (K false) (K true) f 0)
    (hright : ∀ g, e (P.inclusion true g) = interpolate (K false) (K true) 0 g)
    (hnorm : ∀ v, ‖e v‖ ≤ ‖v‖) (z : P.Carrier) (hz : S z = 0)
    (a : ∀ b, K b) (t : Set.Icc (0 : ℝ) 1) :
    e z (joinMk (K false) (K true) (a false) (a true) t) = 0 := by
  by_contra hne
  let p := joinMk (K false) (K true) (a false) (a true) t
  let r := |e z p| / 4
  have hr : 0 < r := div_pos (abs_pos.mpr hne) (by norm_num)
  obtain ⟨z₀, hz₀, hclose⟩ := P.dense_generated.exists_dist_lt z hr
  obtain ⟨n, i, x, φ, hrepr⟩ := P.exists_expression ⟨z₀, hz₀⟩
  obtain ⟨c, hc, hcφ⟩ := exists_expression_error_bound.{u} φ
  let δ := r / (c + 1)
  have hδ : 0 < δ := div_pos hr (by positivity)
  have hmul : δ * (c + 1) = r := div_mul_cancel₀ r (by positivity)
  have hcost : c * δ ≤ r := by nlinarith [hδ]
  let f : ∀ b, Fin n → C(K b, ℝ) :=
    fun b j ↦ if h : i j = b then h ▸ x j else 0
  have hf (j : Fin n) : f (i j) j = x j := by simp only [f, dite_eq_left rfl]
  obtain ⟨J, hJ, hmaps⟩ := exists_local_tensor_maps K X P Q T hT hinj S hcomm f a t δ hδ
  let : ∀ b, NormedAddCommGroup (X b ⧸ (J b).toSubmodule) :=
    fun b ↦ (J b).quotientNormedAddCommGroup (hJ b)
  let : ∀ b, BanachLattice (X b ⧸ (J b).toSubmodule) :=
    fun b ↦ (J b).quotientBanachLattice (hJ b)
  obtain ⟨B, R, w, hR, hw, hunit, hgen⟩ := hmaps
  let H := (hR.mk' R).comp (hS.mk' S)
  let F := H.comp e.symm.toVecLatHom
  obtain ⟨G, hG⟩ := exists_pointwise_hom p w hw.le
  have heunit := join_unit_eq_one K P e hleft hright
  have hpre : e.symm 1 = P.inclusion false 1 + P.inclusion true 1 :=
    e.toLinearEquiv.symm_apply_eq.mpr heunit.symm
  have hFunit : F 1 = w := (congrArg H hpre).trans hunit
  have hGunit : G 1 = w := by simpa only [ContinuousMap.one_apply, one_smul] using hG 1
  have hFapply (v : P.Carrier) : F (e v) = H v :=
    congrArg H (e.toLinearEquiv.symm_apply_apply v)
  have hev (b : Bool) (g : C(K b, ℝ)) : G (e (P.inclusion b g)) =
      (Bool.rec (1 - (t : ℝ)) (t : ℝ) b * g (a b)) • w :=
    (hG _).trans (congrArg (· • w) (join_eval_inclusion K P e hleft hright a t b g))
  have hvar (j : Fin n) :
      |H (P.inclusion (i j) (x j)) - (G.comp e.toVecLatHom) (P.inclusion (i j) (x j))| ≤
        δ • w := by
    change |R (S (P.inclusion (i j) (x j))) - G (e (P.inclusion (i j) (x j)))| ≤ δ • w
    simpa only [hev, hf] using hgen (i j) j
  have hsmall := hcφ B.Carrier (fun j ↦ H (P.inclusion (i j) (x j)))
    (fun j ↦ (G.comp e.toVecLatHom) (P.inclusion (i j) (x j))) w δ hvar
  change z₀ = LLexpr.eval (fun j ↦ P.inclusion (i j) (x j)) φ at hrepr
  have hsmall' : |H z₀ - G (e z₀)| ≤ (c * δ) • w := by
    change |H z₀ - (G.comp e.toVecLatHom) z₀| ≤ (c * δ) • w
    rw [hrepr, LLexpr.map_eval, LLexpr.map_eval]
    exact hsmall
  have hlocal : |F (e z₀) - G (e z₀)| ≤ r • w :=
    (hFapply z₀).symm ▸ hsmall'.trans (smul_le_smul_of_nonneg_right hcost hw.le)
  have hnorm₀ : ‖e z - e z₀‖ ≤ r := by
    change ‖e.toVecLatHom z - e.toVecLatHom z₀‖ ≤ r
    rw [← map_sub e.toVecLatHom]
    exact (hnorm (z - z₀)).trans (by simpa only [dist_eq_norm] using hclose.le)
  have hmain := hom_approximation_error F G w hw.le hFunit hGunit (e z) (e z₀) r
    hnorm₀ hlocal
  have hFzero : F (e z) = 0 := (hFapply z).trans ((congrArg R hz).trans (map_zero R))
  have hscalarw : |e z p| • w ≤ (3 * r) • w := by
    simpa only [hFzero, hG, zero_sub, abs_neg, abs_smul', abs_of_nonneg hw.le] using hmain
  have hscalar : |e z p| ≤ 3 * r := by
    have habs : |(|e z p| • w)| ≤ |((3 * r) • w)| := by
      simpa only [abs_smul', abs_abs, abs_of_nonneg hw.le,
        abs_of_nonneg (mul_nonneg (by norm_num : 0 ≤ (3 : ℝ)) hr.le)] using hscalarw
    have hn := norm_le_norm_of_abs_le_abs habs
    rw [norm_smul, norm_smul, Real.norm_of_nonneg (abs_nonneg (e z p)),
      Real.norm_of_nonneg (mul_nonneg (by norm_num : 0 ≤ (3 : ℝ)) hr.le)] at hn
    exact le_of_mul_le_mul_right hn (norm_pos_iff.mpr (ne_of_gt hw))
  dsimp [r] at hscalar
  exact (not_le_of_gt (abs_pos.mpr hne)) (by linarith)

/-- Injective lattice homomorphisms from continuous-function lattices induce
an injective homomorphism between their Banach lattice free products. -/
theorem induced_injective_of_continuousFunctions
    (P : FreeProduct (fun b ↦ C(K b, ℝ))) (Q : FreeProduct X)
    (T : ∀ b, C(K b, ℝ) →L[ℝ] X b)
    (hT : ∀ b, IsVecLatHom (T b))
    (hT_injective : ∀ b, Function.Injective (T b))
    (S : P.Carrier →L[ℝ] Q.Carrier)
    (hS : IsVecLatHom S)
    (hcomm : ∀ b f, S (P.inclusion b f) = Q.inclusion b (T b f)) :
    Function.Injective S := by
  obtain ⟨e, hleft, hright, hnorm, _⟩ := exists_join_equiv K P
  refine (injective_iff_map_eq_zero S.toLinearMap).mpr (fun z hz ↦ ?_)
  apply e.toLinearEquiv.injective
  rw [map_zero]
  refine ContinuousMap.ext (fun p ↦ ?_)
  induction p using Quotient.inductionOn with
  | h p =>
    exact kernel_join_eval_zero K X P Q T hT hT_injective S hS hcomm e hleft hright
      (fun v ↦ (hnorm v).1) z hz (Bool.rec p.1 p.2.1) p.2.2

end ContinuousFunctions


end BanachLattice.FreeProduct
