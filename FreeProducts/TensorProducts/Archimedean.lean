import FreeProducts.TensorProducts.Bimorphisms

/-!
# Archimedean lattice tensor products

`VectorLattice.TensorProduct` specifies the universal property for arbitrary Archimedean
factors. The concrete construction `algebraicTensor` below currently assumes Banach
factors, while its universal property allows every Archimedean target. It takes the
vector sublattice generated by the auxiliary pairing, without closing it. Scalar
characters on principal ideals transfer lattice relations and yield approximation by
linear combinations of elementary tensors with a fixed order bound.
-/

universe u

namespace VectorLattice

section Archimedean

variable (E F : Type u)
  [AddCommGroup E] [Lattice E] [IsOrderedAddMonoid E] [VectorLattice E]
  [AddCommGroup F] [Lattice F] [IsOrderedAddMonoid F] [VectorLattice F]
  [IsVLArchimedean E] [IsVLArchimedean F]

/-- An Archimedean tensor product universally linearizes lattice bimorphisms
into Archimedean vector lattices. -/
structure TensorProduct where
  Carrier : Type u
  [addCommGroup : AddCommGroup Carrier]
  [lattice : Lattice Carrier]
  [isOrderedAddMonoid : IsOrderedAddMonoid Carrier]
  [vectorLattice : VectorLattice Carrier]
  [isVLArchimedean : IsVLArchimedean Carrier]
  tmul : E →ₗ[ℝ] (F →ₗ[ℝ] Carrier)
  tmul_isLatticeBimorphism : IsLatticeBimorphism tmul
  universal :
    ∀ (G : Type u) [AddCommGroup G] [Lattice G]
      [IsOrderedAddMonoid G] [VectorLattice G] [IsVLArchimedean G]
      (b : E →ₗ[ℝ] (F →ₗ[ℝ] G)), IsLatticeBimorphism b →
      ∃! T : VecLatHom Carrier G, ∀ x y, T (tmul x y) = b x y

attribute [instance] TensorProduct.addCommGroup TensorProduct.lattice
  TensorProduct.isOrderedAddMonoid TensorProduct.vectorLattice
  TensorProduct.isVLArchimedean

namespace TensorProduct

variable {E F}
variable {G H : Type u}
  [AddCommGroup G] [Lattice G] [IsOrderedAddMonoid G] [VectorLattice G]
  [AddCommGroup H] [Lattice H] [IsOrderedAddMonoid H] [VectorLattice H]
  [IsVLArchimedean G] [IsVLArchimedean H]
variable (P : TensorProduct E F)

/-- The extension of a lattice bimorphism to the tensor product. -/
noncomputable def lift (b : E →ₗ[ℝ] (F →ₗ[ℝ] G))
    (hb : IsLatticeBimorphism b) : VecLatHom P.Carrier G :=
  Classical.choose (P.universal G b hb)

end TensorProduct

end Archimedean

end VectorLattice

namespace BanachLattice.FreeProduct

variable (E F : Type u)
  [NormedAddCommGroup E] [Lattice E] [IsOrderedAddMonoid E] [BanachLattice E]
  [NormedAddCommGroup F] [Lattice F] [IsOrderedAddMonoid F] [BanachLattice F]

namespace ProjectiveTensor

/-- The vector sublattice generated by the concrete elementary tensors. -/
noncomputable def coreSublattice :
    VectorSublattice (rankOnePairing E F).Carrier :=
  VectorSublattice.generated
    (Set.range (fun p : E × F ↦ (rankOnePairing E F).tmul p.1 p.2))

/-- The generated vector lattice, with a separate type for its projective norm. -/
def Core : Type u := coreSublattice E F

/-- Addition on the generated vector lattice. -/
noncomputable instance instAddCommGroup : AddCommGroup (Core E F) :=
  inferInstanceAs (AddCommGroup (coreSublattice E F))

/-- The inherited lattice operations on the generated vector lattice. -/
noncomputable instance instLattice : Lattice (Core E F) :=
  inferInstanceAs (Lattice (coreSublattice E F))

/-- The inherited compatibility of addition and order. -/
noncomputable instance instIsOrderedAddMonoid : IsOrderedAddMonoid (Core E F) :=
  inferInstanceAs (IsOrderedAddMonoid (coreSublattice E F))

/-- The inherited real vector lattice structure. -/
noncomputable instance instVectorLattice : VectorLattice (Core E F) :=
  inferInstanceAs (VectorLattice (coreSublattice E F))

/-- The elementary tensor in the generated vector lattice. -/
noncomputable def coreTmul : E →ₗ[ℝ] F →ₗ[ℝ] Core E F where
  toFun x :=
    { toFun y := ⟨(rankOnePairing E F).tmul x y,
        VectorSublattice.subset_generated _ ⟨(x, y), rfl⟩⟩
      map_add' y z := Subtype.ext (map_add ((rankOnePairing E F).tmul x) y z)
      map_smul' c y := Subtype.ext (map_smul ((rankOnePairing E F).tmul x) c y) }
  map_add' x z := LinearMap.ext (fun y ↦ Subtype.ext
    (DFunLike.congr_fun (map_add (rankOnePairing E F).tmul x z) y))
  map_smul' c x := LinearMap.ext (fun y ↦ Subtype.ext
    (DFunLike.congr_fun (map_smul (rankOnePairing E F).tmul c x) y))

/-- The lattice homomorphism including the generated tensor core into the concrete rank-one
model. -/
noncomputable def coreInclusion : VecLatHom (Core E F) (rankOnePairing E F).Carrier :=
  (coreSublattice E F).subtype

section ScalarCharacters

variable {D Z : Type u} [NormedAddCommGroup D] [Lattice D] [IsOrderedAddMonoid D]
  [AMSpaceWithUnit D] [NormedAddCommGroup Z] [Lattice Z] [IsOrderedAddMonoid Z]
  [AMSpaceWithUnit Z]

/-- Fixing the right unit of a normalized scalar bimorphism gives a normalized lattice
character of the left factor. -/
private noncomputable def scalarLeftCharacter (b : D →ₗ[ℝ] Z →ₗ[ℝ] ℝ)
    (hb : ∀ x y, |b x y| = b |x| |y|)
    (hu : b AMSpaceWithUnit.unit AMSpaceWithUnit.unit = 1) :
    AMSpaceWithUnit.LatticeCharacter D := by
  refine ⟨VecLatHom.ofAbs (b.flip AMSpaceWithUnit.unit) ?_, hu⟩
  intro x
  change b |x| AMSpaceWithUnit.unit = |b x AMSpaceWithUnit.unit|
  simpa only [abs_of_nonneg (AMSpaceWithUnit.unit_nonneg (X := Z))] using
    (hb x AMSpaceWithUnit.unit).symm

/-- A normalized scalar bimorphism on unital AM-spaces factors as the product of a character
on each factor. -/
private lemma scalar_character_factor (b : D →ₗ[ℝ] Z →ₗ[ℝ] ℝ)
    (hb : ∀ x y, |b x y| = b |x| |y|)
    (hu : b AMSpaceWithUnit.unit AMSpaceWithUnit.unit = 1) (x : D) (y : Z) :
    b x y = scalarLeftCharacter b hb hu x *
      scalarLeftCharacter b.flip (fun y x ↦ hb x y) hu y := by
  obtain ⟨r, _, hy⟩ := (AMSpaceWithUnit.strongOrderUnit_unit (X := Z)).2 y
  change b x y = b x AMSpaceWithUnit.unit * b AMSpaceWithUnit.unit y
  simpa only [hu, mul_one] using scalar_bimorphism_factor D Z b hb x
    AMSpaceWithUnit.unit AMSpaceWithUnit.unit_nonneg hy
    (fun h ↦ zero_ne_one (h.symm.trans hu))

variable {W : Type u} [NormedAddCommGroup W] [Lattice W] [IsOrderedAddMonoid W]
  [AMSpaceWithUnit W]

/-- A target character pulls back along a unital bimorphism to a pair of factor characters. -/
private noncomputable def characterPair (b : D →ₗ[ℝ] Z →ₗ[ℝ] W)
    (hb : ∀ x y, |b x y| = b |x| |y|)
    (hu : b AMSpaceWithUnit.unit AMSpaceWithUnit.unit = AMSpaceWithUnit.unit)
    (χ : AMSpaceWithUnit.LatticeCharacter W) :
    AMSpaceWithUnit.LatticeCharacter D × AMSpaceWithUnit.LatticeCharacter Z := by
  let c := b.compr₂ χ.toVecLatHom.toLinearMap
  have hc (x : D) (y : Z) : |c x y| = c |x| |y| := by
    change |χ (b x y)| = χ (b |x| |y|)
    exact (χ.toVecLatHom.map_abs _).symm.trans (congrArg χ (hb x y))
  have hcunit : c AMSpaceWithUnit.unit AMSpaceWithUnit.unit = 1 := by
    exact (congrArg χ hu).trans χ.map_unit
  exact (scalarLeftCharacter c hc hcunit,
    scalarLeftCharacter c.flip (fun y x ↦ hc x y) hcunit)

/-- Evaluating a bimorphism under a target character equals the product of its two associated
character values. -/
lemma character_pair_apply (b : D →ₗ[ℝ] Z →ₗ[ℝ] W)
    (hb : ∀ x y, |b x y| = b |x| |y|)
    (hu : b AMSpaceWithUnit.unit AMSpaceWithUnit.unit = AMSpaceWithUnit.unit)
    (χ : AMSpaceWithUnit.LatticeCharacter W) (x : D) (y : Z) :
    χ (b x y) = (characterPair b hb hu χ).1 x * (characterPair b hb hu χ).2 y := by
  exact scalar_character_factor (b.compr₂ χ.toVecLatHom.toLinearMap)
    (fun x y ↦ (χ.toVecLatHom.map_abs _).symm.trans (congrArg χ (hb x y)))
    ((congrArg χ hu).trans χ.map_unit) x y

/-- The map from target characters to pairs of factor characters is continuous. -/
private lemma character_pair_continuous (b : D →ₗ[ℝ] Z →ₗ[ℝ] W)
    (hb : ∀ x y, |b x y| = b |x| |y|)
    (hu : b AMSpaceWithUnit.unit AMSpaceWithUnit.unit = AMSpaceWithUnit.unit) :
    Continuous (characterPair b hb hu) := by
  have hl : Continuous (fun χ ↦ (characterPair b hb hu χ).1) :=
    continuous_induced_rng.mpr (continuous_pi (fun x ↦
      AMSpaceWithUnit.LatticeCharacter.continuous_eval W (b x AMSpaceWithUnit.unit)))
  have hr : Continuous (fun χ ↦ (characterPair b hb hu χ).2) :=
    continuous_induced_rng.mpr (continuous_pi (fun y ↦
      AMSpaceWithUnit.LatticeCharacter.continuous_eval W (b AMSpaceWithUnit.unit y)))
  exact hl.prodMk hr

/-- Constructs an element whose character values are one at a chosen character and zero
outside a prescribed open neighborhood. -/
private lemma exists_character_bump [Nontrivial D]
    {U : Set (AMSpaceWithUnit.LatticeCharacter D)} (hU : IsOpen U)
    {φ : AMSpaceWithUnit.LatticeCharacter D} (hφ : φ ∈ U) :
    ∃ x : D, φ x = 1 ∧ ∀ ψ : AMSpaceWithUnit.LatticeCharacter D, ψ ∉ U → ψ x = 0 := by
  have hd : Disjoint Uᶜ {φ} := by simp [hφ]
  obtain ⟨f, hf0, hf1, _⟩ := exists_continuous_zero_one_of_isClosed
    hU.isClosed_compl isClosed_singleton hd
  obtain ⟨x, hx⟩ := AMSpaceWithUnit.gelfand_surjective (X := D) f
  exact ⟨x, (DFunLike.congr_fun hx φ).trans (hf1 (Set.mem_singleton φ)),
    fun ψ hψ ↦ (DFunLike.congr_fun hx ψ).trans (hf0 hψ)⟩

/-- An element of a nontrivial unital AM-space is zero if all normalized characters vanish on
it. -/
private lemma eq_zero_of_characters [Nontrivial W] (w : W)
    (h : ∀ χ : AMSpaceWithUnit.LatticeCharacter W, χ w = 0) : w = 0 := by
  obtain ⟨χ, hχ⟩ := AMSpaceWithUnit.LatticeCharacter.exists_abs_apply_eq_norm (X := W) w
  exact norm_eq_zero.mp (hχ.symm.trans (by rw [h χ, abs_zero]))

/-- If the bimorphism never kills a pair of nonzero vectors, every pair of factor characters
comes from a target character. -/
lemma character_pair_surjective [Nontrivial D] [Nontrivial Z] [Nontrivial W]
    (b : D →ₗ[ℝ] Z →ₗ[ℝ] W) (hb : ∀ x y, |b x y| = b |x| |y|)
    (hu : b AMSpaceWithUnit.unit AMSpaceWithUnit.unit = AMSpaceWithUnit.unit)
    (hbi : ∀ x y, x ≠ 0 → y ≠ 0 → b x y ≠ 0) :
    Function.Surjective (characterPair b hb hu) := by
  intro p
  by_contra hp
  have ho := (isCompact_range (character_pair_continuous b hb hu)).isClosed.isOpen_compl
  obtain ⟨U, V, hU, hV, hpU, hpV, hUV⟩ := isOpen_prod_iff.mp ho p.1 p.2 hp
  obtain ⟨x, hx, hx0⟩ := exists_character_bump hU hpU
  obtain ⟨y, hy, hy0⟩ := exists_character_bump hV hpV
  have hzero : b x y = 0 := by
    apply eq_zero_of_characters
    intro χ
    rw [character_pair_apply b hb hu]
    by_cases hχU : (characterPair b hb hu χ).1 ∈ U
    · have hχV : (characterPair b hb hu χ).2 ∉ V :=
        fun hχV ↦ (hUV ⟨hχU, hχV⟩) ⟨χ, rfl⟩
      rw [hy0 _ hχV, mul_zero]
    · rw [hx0 _ hχU, zero_mul]
  exact hbi x y
    (fun h ↦ one_ne_zero (hx.symm.trans ((congrArg p.1 h).trans (map_zero p.1.toVecLatHom))))
    (fun h ↦ one_ne_zero (hy.symm.trans ((congrArg p.2 h).trans (map_zero p.2.toVecLatHom)))) hzero

/-- A lattice relation among paired vectors remains a relation after evaluation at any pair of
factor characters. -/
private lemma scalar_expression_zero [Nontrivial D] [Nontrivial Z] [Nontrivial W]
    (b : D →ₗ[ℝ] Z →ₗ[ℝ] W) (hb : ∀ x y, |b x y| = b |x| |y|)
    (hu : b AMSpaceWithUnit.unit AMSpaceWithUnit.unit = AMSpaceWithUnit.unit)
    (hbi : ∀ x y, x ≠ 0 → y ≠ 0 → b x y ≠ 0)
    {n : ℕ} (p : Fin n → D × Z) (a : LLexpr n)
    (ha : LLexpr.eval (fun i ↦ b (p i).1 (p i).2) a = 0)
    (φ : AMSpaceWithUnit.LatticeCharacter D) (ψ : AMSpaceWithUnit.LatticeCharacter Z) :
    LLexpr.eval (fun i ↦ φ (p i).1 * ψ (p i).2) a = 0 := by
  obtain ⟨χ, hχ⟩ := character_pair_surjective b hb hu hbi (φ, ψ)
  have h := congrArg χ ha
  change χ.toVecLatHom (LLexpr.eval (fun i ↦ b (p i).1 (p i).2) a) = χ.toVecLatHom 0 at h
  rw [LLexpr.map_eval, map_zero] at h
  simpa only [show (fun i ↦ χ.toVecLatHom (b (p i).1 (p i).2)) =
      (fun i ↦ φ (p i).1 * ψ (p i).2) from funext (fun i ↦
        (character_pair_apply b hb hu χ (p i).1 (p i).2).trans (by rw [hχ]))] using h

/-- A lattice relation valid for all pairs of characters is valid for every normalized scalar
bimorphism. -/
private lemma scalar_expression_zero_of_characters (b : D →ₗ[ℝ] Z →ₗ[ℝ] ℝ)
    (hb : ∀ x y, |b x y| = b |x| |y|)
    (hu : b AMSpaceWithUnit.unit AMSpaceWithUnit.unit = 1)
    {n : ℕ} (p : Fin n → D × Z) (a : LLexpr n)
    (ha : ∀ (φ : AMSpaceWithUnit.LatticeCharacter D)
      (ψ : AMSpaceWithUnit.LatticeCharacter Z),
      LLexpr.eval (fun i ↦ φ (p i).1 * ψ (p i).2) a = 0) :
    LLexpr.eval (fun i ↦ b (p i).1 (p i).2) a = 0 := by
  simpa only [scalar_character_factor b hb hu] using
    ha (scalarLeftCharacter b hb hu) (scalarLeftCharacter b.flip (fun y x ↦ hb x y) hu)

/-- Realizes pointwise multiplication of the character values of two elements as the character
values of a third element. -/
private lemma exists_character_product [Nontrivial D] (x y : D) :
    ∃ z : D, ∀ φ : AMSpaceWithUnit.LatticeCharacter D, φ z = φ x * φ y := by
  obtain ⟨z, hz⟩ := AMSpaceWithUnit.gelfand_surjective
    (AMSpaceWithUnit.gelfand x * AMSpaceWithUnit.gelfand y)
  exact ⟨z, fun φ ↦ DFunLike.congr_fun hz φ⟩

/-- The character representations of paired elements form a multiplicative submonoid of the
target character-function space. -/
private noncomputable def characterMonoid [Nontrivial D] [Nontrivial Z]
    (b : D →ₗ[ℝ] Z →ₗ[ℝ] W) (hb : ∀ x y, |b x y| = b |x| |y|)
    (hu : b AMSpaceWithUnit.unit AMSpaceWithUnit.unit = AMSpaceWithUnit.unit) :
    Submonoid C(AMSpaceWithUnit.LatticeCharacter W, ℝ) where
  carrier := Set.range (fun p : D × Z ↦ AMSpaceWithUnit.gelfand (b p.1 p.2))
  one_mem' := by
    refine ⟨(AMSpaceWithUnit.unit, AMSpaceWithUnit.unit), ?_⟩
    exact (congrArg AMSpaceWithUnit.gelfand hu).trans AMSpaceWithUnit.gelfand_unit
  mul_mem' := by
    rintro _ _ ⟨⟨x, y⟩, rfl⟩ ⟨⟨z, w⟩, rfl⟩
    obtain ⟨xz, hxz⟩ := exists_character_product x z
    obtain ⟨yw, hyw⟩ := exists_character_product y w
    refine ⟨(xz, yw), ?_⟩
    ext χ
    simp only [AMSpaceWithUnit.gelfand_apply, ContinuousMap.mul_apply,
      character_pair_apply b hb hu, hxz, hyw]
    ring

/-- A closed real subalgebra of continuous functions contains every finite lattice expression
in its elements. -/
private lemma expression_mem_closed_subalgebra {K : Type u} [TopologicalSpace K]
    [CompactSpace K] (A : Subalgebra ℝ C(K, ℝ)) (hA : IsClosed (A : Set C(K, ℝ)))
    {n : ℕ} (p : Fin n → C(K, ℝ)) (hp : ∀ i, p i ∈ A) (a : LLexpr n) :
    LLexpr.eval p a ∈ A := by
  exact a.rec A.zero_mem hp (fun _ _ h₁ h₂ ↦ A.add_mem h₁ h₂)
    (fun r _ h ↦ A.smul_mem h r)
    (fun _ _ h₁ h₂ ↦ ContinuousMap.sup_mem_closed_subalgebra A hA ⟨_, h₁⟩ ⟨_, h₂⟩)
    (fun _ _ h₁ h₂ ↦ ContinuousMap.inf_mem_closed_subalgebra A hA ⟨_, h₁⟩ ⟨_, h₂⟩)

/-- Characterwise lattice relations pass to a normalized bimorphism valued in a principal
ideal of an Archimedean lattice. -/
private lemma principal_expression_zero {G : Type u} [AddCommGroup G] [Lattice G]
    [IsOrderedAddMonoid G] [VectorLattice G] [IsVLArchimedean G] {e : G} (he : 0 < e)
    (b : D →ₗ[ℝ] Z →ₗ[ℝ] (OrderIdeal.principal e).toVectorSublattice)
    (hb : ∀ x y, |b x y| = b |x| |y|)
    (hu : b AMSpaceWithUnit.unit AMSpaceWithUnit.unit =
      ⟨e, OrderIdeal.self_mem_principal e⟩)
    {n : ℕ} (p : Fin n → D × Z) (a : LLexpr n)
    (ha : ∀ (φ : AMSpaceWithUnit.LatticeCharacter D)
      (ψ : AMSpaceWithUnit.LatticeCharacter Z),
      LLexpr.eval (fun i ↦ φ (p i).1 * ψ (p i).2) a = 0) :
    LLexpr.eval (fun i ↦ b (p i).1 (p i).2) a = 0 := by
  by_contra h
  obtain ⟨φ, hφ, hne⟩ := principal_separates he h
  apply hne
  rw [LLexpr.map_eval]
  exact scalar_expression_zero_of_characters (b.compr₂ φ.toLinearMap)
    (fun x y ↦ (φ.map_abs _).symm.trans (congrArg φ (hb x y)))
    ((congrArg φ hu).trans hφ) p a ha

end ScalarCharacters

/-- On principal ideals, a lattice relation in a nonvanishing Banach-valued bimorphism
transfers to any Archimedean-valued bimorphism. -/
private lemma local_expression_transfer {H G : Type u}
    [NormedAddCommGroup H] [Lattice H] [IsOrderedAddMonoid H] [BanachLattice H]
    [AddCommGroup G] [Lattice G] [IsOrderedAddMonoid G] [VectorLattice G]
    [IsVLArchimedean G]
    (b : E →ₗ[ℝ] F →ₗ[ℝ] H) (hb : ∀ x y, |b x y| = b |x| |y|)
    (hbi : ∀ x y, x ≠ 0 → y ≠ 0 → b x y ≠ 0)
    (c : E →ₗ[ℝ] F →ₗ[ℝ] G) (hc : ∀ x y, |c x y| = c |x| |y|)
    {e : E} {f : F} (he : 0 < e) (hf : 0 < f)
    {n : ℕ} (p : Fin n → (OrderIdeal.principal e).toVectorSublattice ×
      (OrderIdeal.principal f).toVectorSublattice) (a : LLexpr n)
    (ha : LLexpr.eval (fun i ↦ b (p i).1.val (p i).2.val) a = 0) :
    LLexpr.eval (fun i ↦ c (p i).1.val (p i).2.val) a = 0 := by
  let D := (OrderIdeal.principal e).toVectorSublattice
  let Z := (OrderIdeal.principal f).toVectorSublattice
  let : NormedAddCommGroup D := OrderIdeal.principalNormedAddCommGroup e
  let : NormedAddCommGroup Z := OrderIdeal.principalNormedAddCommGroup f
  let : AMSpaceWithUnit D := OrderIdeal.principalAMSpaceWithUnit he.le
    (@IsUniformlyCompleteVectorLattice.complete_principal E _ _ _ _
      (isUniformlyCompleteVectorLattice_of_banachLattice E) e he)
  let : AMSpaceWithUnit Z := OrderIdeal.principalAMSpaceWithUnit hf.le
    (@IsUniformlyCompleteVectorLattice.complete_principal F _ _ _ _
      (isUniformlyCompleteVectorLattice_of_banachLattice F) f hf)
  have hbef : 0 < b e f := lt_of_le_of_ne (bimorphism_nonneg b hb he.le hf.le)
    (Ne.symm (hbi e f he.ne' hf.ne'))
  let W := (OrderIdeal.principal (b e f)).toVectorSublattice
  let : NormedAddCommGroup W := OrderIdeal.principalNormedAddCommGroup (b e f)
  let : AMSpaceWithUnit W := OrderIdeal.principalAMSpaceWithUnit hbef.le
    (@IsUniformlyCompleteVectorLattice.complete_principal H _ _ _ _
      (isUniformlyCompleteVectorLattice_of_banachLattice H) (b e f) hbef)
  let : Nontrivial D := principal_nontrivial he
  let : Nontrivial Z := principal_nontrivial hf
  let : Nontrivial W := principal_nontrivial hbef
  let B : D →ₗ[ℝ] Z →ₗ[ℝ] W := principalBimorphism b hb he.le hf.le
  have hB : ∀ x y, |B x y| = B |x| |y| := fun x y ↦ Subtype.ext (hb x.val y.val)
  have hBa : LLexpr.eval (fun i ↦ B (p i).1 (p i).2) a = 0 :=
    Subtype.ext ((LLexpr.coe_eval_vectorSublattice _ _ a).trans ha)
  have hBi : ∀ x y, x ≠ 0 → y ≠ 0 → B x y ≠ 0 :=
    fun x y hx hy h ↦ hbi x.val y.val (fun h ↦ hx (Subtype.ext h))
      (fun h ↦ hy (Subtype.ext h)) (congrArg Subtype.val h)
  have hs := scalar_expression_zero B hB rfl hBi p a hBa
  let C : D →ₗ[ℝ] Z →ₗ[ℝ] (OrderIdeal.principal (c e f)).toVectorSublattice :=
    principalBimorphism c hc he.le hf.le
  have hCa : LLexpr.eval (fun i ↦ C (p i).1 (p i).2) a = 0 := by
    by_cases hzero : c e f = 0
    · exact principal_eq_zero hzero _
    · exact principal_expression_zero
        (lt_of_le_of_ne (bimorphism_nonneg c hc he.le hf.le) (Ne.symm hzero)) C
        (fun x y ↦ Subtype.ext (hc x.val y.val)) rfl p a hs
  exact (LLexpr.coe_eval_vectorSublattice _ _ a).symm.trans (congrArg Subtype.val hCa)

/-- Every finite lattice relation in a nonvanishing Banach-valued bimorphism transfers to any
Archimedean-valued bimorphism. -/
private lemma expression_transfer {H G : Type u}
    [NormedAddCommGroup H] [Lattice H] [IsOrderedAddMonoid H] [BanachLattice H]
    [AddCommGroup G] [Lattice G] [IsOrderedAddMonoid G] [VectorLattice G]
    [IsVLArchimedean G]
    (b : E →ₗ[ℝ] F →ₗ[ℝ] H) (hb : ∀ x y, |b x y| = b |x| |y|)
    (hbi : ∀ x y, x ≠ 0 → y ≠ 0 → b x y ≠ 0)
    (c : E →ₗ[ℝ] F →ₗ[ℝ] G) (hc : ∀ x y, |c x y| = c |x| |y|)
    {n : ℕ} (p : Fin n → E × F) (a : LLexpr n)
    (ha : LLexpr.eval (fun i ↦ b (p i).1 (p i).2) a = 0) :
    LLexpr.eval (fun i ↦ c (p i).1 (p i).2) a = 0 := by
  obtain ⟨e, he, hx⟩ := exists_principal_family (fun i ↦ (p i).1)
  obtain ⟨f, hf, hy⟩ := exists_principal_family (fun i ↦ (p i).2)
  let q : Fin n → (OrderIdeal.principal e).toVectorSublattice ×
      (OrderIdeal.principal f).toVectorSublattice := fun i ↦ (⟨(p i).1, hx i⟩, ⟨(p i).2, hy i⟩)
  by_cases he0 : e = 0
  · exact expression_zero_of_variables _ a (fun i ↦ by
      simp only [show (p i).1 = 0 from congrArg Subtype.val (principal_eq_zero he0 (q i).1),
        map_zero, LinearMap.zero_apply])
  · by_cases hf0 : f = 0
    · exact expression_zero_of_variables _ a (fun i ↦ by
        simp only [show (p i).2 = 0 from congrArg Subtype.val (principal_eq_zero hf0 (q i).2),
          map_zero])
    · exact local_expression_transfer E F b hb hbi c hc
        (lt_of_le_of_ne he (Ne.symm he0)) (lt_of_le_of_ne hf (Ne.symm hf0)) q a ha

/-- Relations in the concrete tensor core hold under every lattice bimorphism into an
Archimedean lattice. -/
private lemma core_expression_zero {G : Type u} [AddCommGroup G] [Lattice G]
    [IsOrderedAddMonoid G] [VectorLattice G] [IsVLArchimedean G]
    (b : E →ₗ[ℝ] F →ₗ[ℝ] G) (hb : ∀ x y, |b x y| = b |x| |y|)
    {n : ℕ} (p : Fin n → E × F) (a : LLexpr n)
    (ha : LLexpr.eval (fun i ↦ coreTmul E F (p i).1 (p i).2) a = 0) :
    LLexpr.eval (fun i ↦ b (p i).1 (p i).2) a = 0 := by
  exact expression_transfer E F ((coreTmul E F).compr₂ (coreInclusion E F).toLinearMap)
    (completedPairing_abs E F) (fun _ _ ↦ completedPairing_ne_zero E F) b hb p a
    ((LLexpr.map_eval (coreInclusion E F) _ a).symm.trans
      ((congrArg (coreInclusion E F) ha).trans (map_zero (coreInclusion E F))))

/-- Every tensor-core element is a finite lattice expression in elementary tensors. -/
private lemma core_exists_expression (z : Core E F) :
    ∃ (n : ℕ) (p : Fin n → E × F) (a : LLexpr n),
      LLexpr.eval (fun i ↦ coreTmul E F (p i).1 (p i).2) a = z := by
  have hz := z.property
  change z.val ∈ (VectorSublattice.generated
    (Set.range (fun p : E × F ↦ (rankOnePairing E F).tmul p.1 p.2)) : Set _) at hz
  rw [LLexpr.generated_eq_iUnion_combinations] at hz
  simp only [Set.mem_iUnion, LLexpr.combinations, Set.mem_range] at hz
  obtain ⟨n, v, a, ha⟩ := hz
  choose p hp using fun i : Fin n ↦ (v i).property
  refine ⟨n, p, a, ?_⟩
  apply Subtype.ext
  change coreInclusion E F (LLexpr.eval _ a) = z.val
  rw [LLexpr.map_eval]
  exact (congrArg (fun v ↦ LLexpr.eval v a) (funext hp)).trans ha

/-- Homomorphisms on the tensor core are determined by their values on elementary tensors. -/
private lemma core_hom_ext {G : Type u} [AddCommGroup G] [Lattice G]
    [IsOrderedAddMonoid G] [VectorLattice G] {S T : VecLatHom (Core E F) G}
    (h : ∀ x y, S (coreTmul E F x y) = T (coreTmul E F x y)) : S = T := by
  apply DFunLike.ext
  intro z
  obtain ⟨n, p, a, rfl⟩ := core_exists_expression E F z
  simp only [LLexpr.map_eval, h]

/-- Every lattice bimorphism into an Archimedean lattice induces a lattice homomorphism from
the tensor core. -/
private lemma core_lift {G : Type u} [AddCommGroup G] [Lattice G]
    [IsOrderedAddMonoid G] [VectorLattice G] [IsVLArchimedean G]
    (b : E →ₗ[ℝ] F →ₗ[ℝ] G) (hb : ∀ x y, |b x y| = b |x| |y|) :
    ∃ T : VecLatHom (Core E F) G, ∀ x y, T (coreTmul E F x y) = b x y := by
  let : VectorLattice (Core E F × G) := { }
  let R := VectorSublattice.generated
    (Set.range (fun p : E × F ↦ (coreTmul E F p.1 p.2, b p.1 p.2)))
  let fst : VecLatHom (Core E F × G) (Core E F) :=
    { LinearMap.fst ℝ (Core E F) G with map_sup' := fun _ _ ↦ rfl, map_inf' := fun _ _ ↦ rfl }
  let snd : VecLatHom (Core E F × G) G :=
    { LinearMap.snd ℝ (Core E F) G with map_sup' := fun _ _ ↦ rfl, map_inf' := fun _ _ ↦ rfl }
  let S : VecLatHom R (Core E F) := fst.comp R.subtype
  have hinj : Function.Injective S := by
    apply LinearMap.ker_eq_bot.mp (LinearMap.ker_eq_bot'.mpr ?_)
    intro z hz
    have hm := z.property
    change z.val ∈ (VectorSublattice.generated
      (Set.range (fun p : E × F ↦ (coreTmul E F p.1 p.2, b p.1 p.2))) : Set _) at hm
    rw [LLexpr.generated_eq_iUnion_combinations] at hm
    simp only [Set.mem_iUnion, LLexpr.combinations, Set.mem_range] at hm
    obtain ⟨n, v, a, ha⟩ := hm
    choose p hp using fun i : Fin n ↦ (v i).property
    have hrepr : LLexpr.eval
        (fun i ↦ (coreTmul E F (p i).1 (p i).2, b (p i).1 (p i).2)) a = z.val :=
      (congrArg (fun v ↦ LLexpr.eval v a) (funext hp)).trans ha
    have hzero := core_expression_zero E F b hb p a
      ((LLexpr.map_eval fst _ a).symm.trans ((congrArg fst hrepr).trans hz))
    exact Subtype.ext (Prod.ext hz
      ((congrArg snd hrepr).symm.trans ((LLexpr.map_eval snd _ a).trans hzero)))
  have hsurj : Function.Surjective S := by
    intro z
    obtain ⟨n, p, a, ha⟩ := core_exists_expression E F z
    let q : Fin n → R := fun i ↦ ⟨(coreTmul E F (p i).1 (p i).2, b (p i).1 (p i).2),
      VectorSublattice.subset_generated _ ⟨p i, rfl⟩⟩
    exact ⟨LLexpr.eval q a, (LLexpr.map_eval S q a).trans ha⟩
  refine ⟨(snd.comp R.subtype).comp (S.symm ⟨hinj, hsurj⟩), ?_⟩
  intro x y
  let g : R := ⟨(coreTmul E F x y, b x y), VectorSublattice.subset_generated _ ⟨(x, y), rfl⟩⟩
  exact congrArg (snd.comp R.subtype) ((S.symm_apply ⟨hinj, hsurj⟩ g
    (coreTmul E F x y)).mpr rfl)

/-- The concrete generated lattice satisfies the Archimedean tensor universal property. -/
noncomputable def algebraicTensor : VectorLattice.TensorProduct E F where
  Carrier := Core E F
  isVLArchimedean := by
    refine ⟨fun {x y} h ↦ ?_⟩
    exact IsVLArchimedean.le_zero_of_forall_nsmul_le
      (x := (x : (coreSublattice E F)).val) (y := (y : (coreSublattice E F)).val) h
  tmul := coreTmul E F
  tmul_isLatticeBimorphism x y := Subtype.ext (completedPairing_abs E F x y)
  universal := by
    intro G _ _ _ _ _ b hb
    obtain ⟨T, hT⟩ : ∃ T : VecLatHom (Core E F) G,
        ∀ x y, T (coreTmul E F x y) = b x y := core_lift E F b hb
    exact ⟨T, hT, fun S hS ↦ core_hom_ext E F (fun x y ↦ (hS x y).trans (hT x y).symm)⟩

section Approximation

variable {D Z W : Type u}
  [NormedAddCommGroup D] [Lattice D] [IsOrderedAddMonoid D] [AMSpaceWithUnit D]
  [NormedAddCommGroup Z] [Lattice Z] [IsOrderedAddMonoid Z] [AMSpaceWithUnit Z]
  [NormedAddCommGroup W] [Lattice W] [IsOrderedAddMonoid W] [AMSpaceWithUnit W]

/-- For unital AM-spaces, lattice expressions in bimorphism values lie in the norm closure of
their linear span. -/
private lemma am_expression_mem_closure [Nontrivial D] [Nontrivial Z] [Nontrivial W]
    (b : D →ₗ[ℝ] Z →ₗ[ℝ] W) (hb : ∀ x y, |b x y| = b |x| |y|)
    (hu : b AMSpaceWithUnit.unit AMSpaceWithUnit.unit = AMSpaceWithUnit.unit)
    {n : ℕ} (p : Fin n → D × Z) (a : LLexpr n) :
    LLexpr.eval (fun i ↦ b (p i).1 (p i).2) a ∈
      closure (Submodule.span ℝ (Set.range (fun p : D × Z ↦ b p.1 p.2)) : Set W) := by
  let J := AMSpaceWithUnit.kakutaniEquiv W
  let T := J.toVecLatEquiv.toVecLatHom
  let M := characterMonoid b hb hu
  let A := Algebra.adjoin ℝ (M : Set C(AMSpaceWithUnit.LatticeCharacter W, ℝ))
  let S := Submodule.span ℝ (Set.range (fun p : D × Z ↦ b p.1 p.2))
  have hspan : A.toSubmodule = S.map T.toLinearMap := by
    simp only [A, S, Algebra.adjoin_eq_span, Submonoid.closure_eq,
      Submodule.map_span, ← Set.range_comp]
    rfl
  have hmem : T (LLexpr.eval (fun i ↦ b (p i).1 (p i).2) a) ∈ A.topologicalClosure := by
    rw [LLexpr.map_eval]
    exact expression_mem_closed_subalgebra A.topologicalClosure A.isClosed_topologicalClosure
      _ (fun i ↦ A.le_topologicalClosure (Algebra.subset_adjoin ⟨p i, rfl⟩)) a
  rw [Topology.IsInducing.closure_eq_preimage_closure_image
    J.toLinearIsometryEquiv.isometry.isUniformInducing.isInducing]
  change T (LLexpr.eval (fun i ↦ b (p i).1 (p i).2) a) ∈
    closure (S.map T.toLinearMap : Set C(AMSpaceWithUnit.LatticeCharacter W, ℝ))
  rw [← hspan]
  exact hmem

end Approximation

/-- On principal ideals, lattice expressions can be approximated by linear combinations of
paired vectors with arbitrarily small order-unit error. -/
private lemma local_expression_approx {H : Type u} [NormedAddCommGroup H]
    [Lattice H] [IsOrderedAddMonoid H] [BanachLattice H]
    (b : E →ₗ[ℝ] F →ₗ[ℝ] H) (hb : ∀ x y, |b x y| = b |x| |y|)
    (hbi : ∀ x y, x ≠ 0 → y ≠ 0 → b x y ≠ 0)
    {e : E} {f : F} (he : 0 < e) (hf : 0 < f)
    {n : ℕ} (p : Fin n → (OrderIdeal.principal e).toVectorSublattice ×
      (OrderIdeal.principal f).toVectorSublattice) (a : LLexpr n) {δ : ℝ} (hδ : 0 < δ) :
    ∃ w ∈ Submodule.span ℝ (Set.range (fun p : E × F ↦ b p.1 p.2)),
      |LLexpr.eval (fun i ↦ b (p i).1.val (p i).2.val) a - w| ≤ δ • b e f := by
  let D := (OrderIdeal.principal e).toVectorSublattice
  let Z := (OrderIdeal.principal f).toVectorSublattice
  let : NormedAddCommGroup D := OrderIdeal.principalNormedAddCommGroup e
  let : NormedAddCommGroup Z := OrderIdeal.principalNormedAddCommGroup f
  let : AMSpaceWithUnit D := OrderIdeal.principalAMSpaceWithUnit he.le
    (@IsUniformlyCompleteVectorLattice.complete_principal E _ _ _ _
      (isUniformlyCompleteVectorLattice_of_banachLattice E) e he)
  let : AMSpaceWithUnit Z := OrderIdeal.principalAMSpaceWithUnit hf.le
    (@IsUniformlyCompleteVectorLattice.complete_principal F _ _ _ _
      (isUniformlyCompleteVectorLattice_of_banachLattice F) f hf)
  have hbef : 0 < b e f := lt_of_le_of_ne (bimorphism_nonneg b hb he.le hf.le)
    (Ne.symm (hbi e f he.ne' hf.ne'))
  let W := (OrderIdeal.principal (b e f)).toVectorSublattice
  let : NormedAddCommGroup W := OrderIdeal.principalNormedAddCommGroup (b e f)
  let : AMSpaceWithUnit W := OrderIdeal.principalAMSpaceWithUnit hbef.le
    (@IsUniformlyCompleteVectorLattice.complete_principal H _ _ _ _
      (isUniformlyCompleteVectorLattice_of_banachLattice H) (b e f) hbef)
  let : Nontrivial D := principal_nontrivial he
  let : Nontrivial Z := principal_nontrivial hf
  let : Nontrivial W := principal_nontrivial hbef
  let B : D →ₗ[ℝ] Z →ₗ[ℝ] W := principalBimorphism b hb he.le hf.le
  have hcl := am_expression_mem_closure B (fun x y ↦ Subtype.ext (hb x.val y.val)) rfl p a
  let : PseudoMetricSpace W :=
    (OrderIdeal.principalNormedAddCommGroup (b e f)).toSeminormedAddCommGroup.toPseudoMetricSpace
  obtain ⟨w, hw, hd⟩ := (Metric.mem_closure_iff (α := W)).mp hcl δ hδ
  let S := Submodule.span ℝ (Set.range (fun p : E × F ↦ b p.1 p.2))
  have hspan : Submodule.span ℝ (Set.range (fun p : D × Z ↦ B p.1 p.2)) ≤
      S.comap (OrderIdeal.principal (b e f)).toVectorSublattice.subtype.toLinearMap := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨x, y⟩, rfl⟩
    exact Submodule.subset_span ⟨(x.val, y.val), rfl⟩
  refine ⟨w.val, hspan hw, ?_⟩
  let z : W := LLexpr.eval (fun i ↦ B (p i).1 (p i).2) a - w
  rw [dist_eq_norm] at hd
  change OrderIdeal.gaugeNorm (b e f) z.val < δ at hd
  have hz := OrderIdeal.abs_le_gaugeNorm_smul_abs (b e f) z.property
  have hn := hz.trans (smul_le_smul_of_nonneg_right hd.le (abs_nonneg (b e f)))
  rw [abs_of_nonneg hbef.le] at hn
  change |(LLexpr.eval (fun i ↦ B (p i).1 (p i).2) a : W).val - w.val| ≤ δ • b e f at hn
  rw [LLexpr.coe_eval_vectorSublattice] at hn
  have hcoe : (fun i ↦ (B (p i).1 (p i).2).val) =
      (fun i ↦ b (p i).1.val (p i).2.val) := rfl
  rw [hcoe] at hn
  exact hn

/-- Every tensor-core element admits linear-span approximations whose order errors are
controlled by one fixed positive elementary tensor. -/
lemma core_order_approx (z : Core E F) : ∃ x : E, ∃ y : F, 0 ≤ x ∧ 0 ≤ y ∧
    ∀ δ : ℝ, 0 < δ → ∃ w ∈ Submodule.span ℝ
      (Set.range (fun p : E × F ↦ coreTmul E F p.1 p.2)),
      |z - w| ≤ δ • coreTmul E F x y := by
  obtain ⟨n, p, a, rfl⟩ := core_exists_expression E F z
  obtain ⟨e, he, hx⟩ := exists_principal_family (fun i ↦ (p i).1)
  obtain ⟨f, hf, hy⟩ := exists_principal_family (fun i ↦ (p i).2)
  let q : Fin n → (OrderIdeal.principal e).toVectorSublattice ×
      (OrderIdeal.principal f).toVectorSublattice := fun i ↦ (⟨(p i).1, hx i⟩, ⟨(p i).2, hy i⟩)
  refine ⟨e, f, he, hf, ?_⟩
  intro δ hδ
  by_cases he0 : e = 0
  · have hz := expression_zero_of_variables
      (fun i ↦ coreTmul E F (p i).1 (p i).2) a (fun i ↦ by
        simp only [show (p i).1 = 0 from congrArg Subtype.val (principal_eq_zero he0 (q i).1),
          map_zero, LinearMap.zero_apply])
    exact ⟨0, Submodule.zero_mem _, by
      simp only [hz, sub_self, abs_zero, he0, map_zero, LinearMap.zero_apply, smul_zero, le_refl]⟩
  · by_cases hf0 : f = 0
    · have hz := expression_zero_of_variables
        (fun i ↦ coreTmul E F (p i).1 (p i).2) a (fun i ↦ by
          simp only [show (p i).2 = 0 from congrArg Subtype.val (principal_eq_zero hf0 (q i).2),
            map_zero])
      exact ⟨0, Submodule.zero_mem _, by
        simp only [hz, sub_self, abs_zero, hf0, map_zero, smul_zero, le_refl]⟩
    · let b := (coreTmul E F).compr₂ (coreInclusion E F).toLinearMap
      obtain ⟨w, hw, hbound⟩ := local_expression_approx E F b (completedPairing_abs E F)
        (fun _ _ ↦ completedPairing_ne_zero E F) (lt_of_le_of_ne he (Ne.symm he0))
        (lt_of_le_of_ne hf (Ne.symm hf0)) q a hδ
      let S := Submodule.span ℝ (Set.range (fun p : E × F ↦ coreTmul E F p.1 p.2))
      have hmap : S.map (coreInclusion E F).toLinearMap =
          Submodule.span ℝ (Set.range (fun p : E × F ↦ b p.1 p.2)) := by
        simp only [S, Submodule.map_span, ← Set.range_comp]
        rfl
      rw [← hmap] at hw
      obtain ⟨v, hv, rfl⟩ := Submodule.mem_map.mp hw
      refine ⟨v, hv, ?_⟩
      apply (coreInclusion E F).le_of_map_le Subtype.val_injective
      rw [(coreInclusion E F).map_abs, map_sub, LLexpr.map_eval, map_smul]
      exact hbound

end ProjectiveTensor

