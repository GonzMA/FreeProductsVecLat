import FreeProducts.CountableSpectra.Colexicographic
import Mathlib.Algebra.Order.Monoid.Prod
import Mathlib.SetTheory.Cardinal.Regular

/-!
# Properties of relatively injective lattices

Relative injectivity and universal disposition impose order and cardinality
constraints and admit stability results. Chain embeddings include a colexicographic
copy indexed by the first uncountable ordinal.
-/

noncomputable section

universe u v w

namespace VectorLattice.CountableSpectra

/-- Every nonzero countable-prime-injective lattice has at least continuum many proper primes. -/
theorem continuum_le_spectrum_of_isCountablePrimeInjective
    (Z : Type u) [AddCommGroup Z] [Lattice Z] [IsOrderedAddMonoid Z]
    [VectorLattice Z] [Nontrivial Z] (hZ : IsCountablePrimeInjective Z) :
    Cardinal.continuum ≤ Cardinal.mk ↥(properPrimeIdeals Z) := by
  obtain ⟨z, hz⟩ := exists_ne (0 : Z)
  have hpos : 0 < |z| := lt_of_le_of_ne (abs_nonneg z)
    (fun h ↦ hz ((abs_eq_zero_iff_zero z).mp h.symm))
  obtain ⟨T, hT, -⟩ :=
    colex_embeds_countable_injective (ι := rationalInterval.{u}) hZ |z| hpos
  exact rational_colex_spectrum_cardinal.trans (spectrum_cardinal_le_of_injective T hT)

/-- No nonzero lattice with countable spectrum is injective for that class. -/
theorem countable_spectrum_not_injective
    (Z : Type u) [AddCommGroup Z] [Lattice Z] [IsOrderedAddMonoid Z]
    [VectorLattice Z] [Nontrivial Z] (hZ : (properPrimeIdeals Z).Countable) :
    ¬ IsCountablePrimeInjective Z := by
  exact fun hinj ↦ Cardinal.aleph0_lt_continuum.not_ge
    ((continuum_le_spectrum_of_isCountablePrimeInjective Z hinj).trans
      (Cardinal.le_aleph0_iff_set_countable.mpr hZ))

section UniversalDisposition

variable {B Z : Type u}
  [AddCommGroup B] [Lattice B] [IsOrderedAddMonoid B] [VectorLattice B]
  [AddCommGroup Z] [Lattice Z] [IsOrderedAddMonoid Z] [VectorLattice Z]

/-- Universal disposition gives an embedding of the quotient by the ambient ideal generated by
the kernel, extending the induced map from the original kernel quotient. -/
private lemma quotient_embedding_extension
    (hZ : HasCountablePrimeUniversalDisposition Z) (hB : (properPrimeIdeals B).Countable)
    (A : VectorSublattice B) (T : VecLatHom A Z) :
    let J := OrderIdeal.generated (Subtype.val '' (OrderIdeal.ofKerVecLatHom T : Set A))
    ∃ S : VecLatHom (B ⧸ J.toSubmodule) Z,
      Function.Injective S ∧ ∀ a : A, S (J.mkQ a.val) = T a := by
  intro J
  let K := OrderIdeal.ofKerVecLatHom T
  let q := J.mkQVecLatHom.comp A.subtype
  have hK : K.toSubmodule = LinearMap.ker q.toLinearMap :=
    Submodule.ext (fun a ↦ (mem_generated_ideal_iff A K a).symm.trans
      (Submodule.Quotient.mk_eq_zero J.toSubmodule).symm)
  let F := K.liftQVecLatHom q hK.le
  have hF : Function.Injective F := LinearMap.ker_eq_bot.mp
    (Submodule.ker_liftQ_eq_bot K.toSubmodule q.toLinearMap hK.le hK.ge)
  let H := K.liftQVecLatHom T le_rfl
  have hH : Function.Injective H := LinearMap.ker_eq_bot.mp
    (Submodule.ker_liftQ_eq_bot K.toSubmodule T.toLinearMap le_rfl le_rfl)
  let D := VectorSublattice.ofAbsClosed F.toLinearMap.range
    (fun y ⟨a, ha⟩ ↦ ⟨|a|, (F.map_abs a).trans (congrArg abs ha)⟩)
  let e : VecLatEquiv (A ⧸ K.toSubmodule) D :=
    { LinearEquiv.ofInjective F.toLinearMap hF with
      map_sup' := fun a b ↦ Subtype.ext (F.map_sup' a b)
      map_inf' := fun a b ↦ Subtype.ext (F.map_inf' a b) }
  obtain ⟨S, hS, hST⟩ := hZ (B ⧸ J.toSubmodule)
    (countable_spectrum_of_surjective J.mkQVecLatHom J.toSubmodule.mkQ_surjective hB)
    D (H.comp e.symm.toVecLatHom) (hH.comp e.toLinearEquiv.symm.injective)
  exact ⟨S, hS, fun a ↦ (hST (e (K.mkQ a))).trans
    (congrArg H (e.toLinearEquiv.symm_apply_apply (K.mkQ a)))⟩

/-- Universal disposition extends homomorphisms with exactly the generated kernel. -/
theorem extension_with_generated_kernel
    (hZ : HasCountablePrimeUniversalDisposition Z) (hB : (properPrimeIdeals B).Countable)
    (A : VectorSublattice B) (T : VecLatHom A Z) :
    ∃ S : VecLatHom B Z, (∀ a : A, S a.val = T a) ∧
      OrderIdeal.ofKerVecLatHom S =
        OrderIdeal.generated (Subtype.val '' (OrderIdeal.ofKerVecLatHom T : Set A)) := by
  obtain ⟨S, hS, hST⟩ := quotient_embedding_extension hZ hB A T
  let J := OrderIdeal.generated (Subtype.val '' (OrderIdeal.ofKerVecLatHom T : Set A))
  refine ⟨S.comp J.mkQVecLatHom, hST, SetLike.ext (fun b ↦ ?_)⟩
  exact ⟨fun h ↦ (Submodule.Quotient.mk_eq_zero J.toSubmodule).mp
    (hS (h.trans (map_zero S).symm)), fun h ↦
      (congrArg S ((Submodule.Quotient.mk_eq_zero J.toSubmodule).mpr h)).trans (map_zero S)⟩

/-- Universal disposition for countable prime spectra implies relative injectivity. -/
theorem isCountablePrimeInjective_of_universalDisposition
    (hZ : HasCountablePrimeUniversalDisposition Z) : IsCountablePrimeInjective Z := by
  exact fun X _ _ _ _ hX A T ↦
    (extension_with_generated_kernel hZ hX A T).imp (fun _ h ↦ h.1)

end UniversalDisposition

section LocalProperties

variable {Z : Type u} [AddCommGroup Z] [Lattice Z]
  [IsOrderedAddMonoid Z] [VectorLattice Z]

/-- All real multiples of a positive element have a common upper bound in an injective lattice. -/
theorem exists_forall_smul_le_of_isCountablePrimeInjective
    (hZ : IsCountablePrimeInjective Z) {z : Z} (hz : 0 < z) :
    ∃ y : Z, ∀ r : ℝ, r • z ≤ y := by
  obtain ⟨S, -, hS⟩ :=
    colex_embeds_countable_injective (ι := ULift.{u} (Fin 2)) hZ z hz
  refine ⟨S (toLex (Finsupp.single (OrderDual.toDual (ULift.up (1 : Fin 2))) 1)),
    fun r ↦ ?_⟩
  convert S.monotone (colex_smul_single_lt_single
    (i := (⊥ : ULift.{u} (Fin 2))) (j := ULift.up 1) (by decide) r).le using 1
  · simp only [map_smul, hS]
  · congr 1

/-- A nonzero injective lattice is not Archimedean. -/
theorem not_isVLArchimedean_of_isCountablePrimeInjective [Nontrivial Z]
    (hZ : IsCountablePrimeInjective Z) : ¬IsVLArchimedean Z := by
  intro harch
  obtain ⟨z, hz⟩ := exists_ne (0 : Z)
  have hpos : 0 < |z| := lt_of_le_of_ne (abs_nonneg z)
    (fun h ↦ hz ((abs_eq_zero_iff_zero z).mp h.symm))
  obtain ⟨y, hy⟩ := exists_forall_smul_le_of_isCountablePrimeInjective hZ hpos
  exact hpos.not_ge (harch.le_zero_of_forall_nsmul_le
    (fun n ↦ by simpa only [Nat.cast_smul_eq_nsmul] using hy n))

/-- A nonzero injective lattice has no strong order unit. -/
theorem not_strongOrderUnit_of_isCountablePrimeInjective [Nontrivial Z]
    (hZ : IsCountablePrimeInjective Z) (e : Z) : ¬StrongOrderUnit e := by
  intro he
  have hpos : 0 < e := by
    refine lt_of_le_of_ne he.1 (fun hzero ↦ ?_)
    obtain ⟨x, hx⟩ := exists_ne (0 : Z)
    obtain ⟨r, -, hr⟩ := he.2 x
    exact hx ((abs_eq_zero_iff_zero x).mp
      (le_antisymm (by simpa only [← hzero, smul_zero] using hr) (abs_nonneg x)))
  obtain ⟨y, hy⟩ := exists_forall_smul_le_of_isCountablePrimeInjective hZ hpos
  obtain ⟨r, -, hr⟩ := he.2 y
  have hle : r • e + e ≤ r • e := by
    simpa only [add_smul, one_smul] using
      (hy (r + 1)).trans ((le_abs_self y).trans hr)
  exact hpos.not_ge (by simpa only [add_le_iff_nonpos_right] using hle)

end LocalProperties

/-- Universal disposition extends embeddings along arbitrary embeddings into lattices with
countable spectra. -/
private lemma universalDisposition_extend_embedding {X : Type*} {Y Z : Type u}
    [AddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [VectorLattice X]
    [AddCommGroup Y] [Lattice Y] [IsOrderedAddMonoid Y] [VectorLattice Y]
    [AddCommGroup Z] [Lattice Z] [IsOrderedAddMonoid Z] [VectorLattice Z]
    (hZ : HasCountablePrimeUniversalDisposition Z) (hY : (properPrimeIdeals Y).Countable)
    (f : VecLatHom X Y) (hf : Function.Injective f)
    (T : VecLatHom X Z) (hT : Function.Injective T) :
    ∃ S : VecLatHom Y Z, Function.Injective S ∧ ∀ x, S (f x) = T x := by
  let D := VectorSublattice.ofAbsClosed f.toLinearMap.range
    (fun y ⟨x, hx⟩ ↦ ⟨|x|, (f.map_abs x).trans (congrArg abs hx)⟩)
  let e : VecLatEquiv X D :=
    { LinearEquiv.ofInjective f.toLinearMap hf with
      map_sup' := fun x y ↦ Subtype.ext (f.map_sup' x y)
      map_inf' := fun x y ↦ Subtype.ext (f.map_inf' x y) }
  obtain ⟨S, hS, hST⟩ := hZ Y hY D (T.comp e.symm.toVecLatHom)
    (hT.comp e.toLinearEquiv.symm.injective)
  exact ⟨S, hS, fun x ↦ (hST (e x)).trans
    (congrArg T (e.toLinearEquiv.symm_apply_apply x))⟩

/-- The lattice homomorphism from the real line sending one to a prescribed nonnegative
vector. -/
private def positiveScalarHom {Z : Type*} [AddCommGroup Z] [Lattice Z]
    [IsOrderedAddMonoid Z] [VectorLattice Z] (z : Z) (hz : 0 ≤ z) : VecLatHom ℝ Z where
  toLinearMap := (LinearMap.id : ℝ →ₗ[ℝ] ℝ).smulRight z
  map_sup' := fun a b ↦ sup_smul_nonneg z a b hz
  map_inf' := fun a b ↦ inf_smul_nonneg z a b hz

/-- Universal disposition gives an embedding of a lattice with countable spectrum that sends a
chosen positive vector to a prescribed positive vector. -/
private lemma universalDisposition_prescribed_positive {Y Z : Type u}
    [AddCommGroup Y] [Lattice Y] [IsOrderedAddMonoid Y] [VectorLattice Y]
    [AddCommGroup Z] [Lattice Z] [IsOrderedAddMonoid Z] [VectorLattice Z]
    (hZ : HasCountablePrimeUniversalDisposition Z) (hY : (properPrimeIdeals Y).Countable)
    {e : Y} (he : 0 < e) {z : Z} (hz : 0 < z) :
    ∃ S : VecLatHom Y Z, Function.Injective S ∧ S e = z := by
  obtain ⟨S, hS, hST⟩ := universalDisposition_extend_embedding hZ hY
    (positiveScalarHom e he.le) (smul_left_injective ℝ he.ne')
    (positiveScalarHom z hz.le) (smul_left_injective ℝ hz.ne')
  exact ⟨S, hS, by
    simpa only [one_smul] using (show S ((1 : ℝ) • e) = (1 : ℝ) • z from hST 1)⟩

/-- The constant-one vector in the real coordinate plane splits into two nonzero disjoint
positive vectors. -/
private lemma real_pair_positive_split :
    ∃ a b : ULift.{u} Bool → ℝ,
      0 < a ∧ 0 < b ∧ a ⊓ b = 0 ∧ a + b = fun _ ↦ 1 := by
  refine ⟨Pi.single (ULift.up false) 1, Pi.single (ULift.up true) 1, ?_, ?_, ?_, ?_⟩
  · exact lt_of_le_of_ne (Pi.single_nonneg.mpr zero_le_one)
      (fun h ↦ (zero_ne_one : (0 : ℝ) ≠ 1)
        (by simpa using congrFun h (ULift.up false)))
  · exact lt_of_le_of_ne (Pi.single_nonneg.mpr zero_le_one)
      (fun h ↦ (zero_ne_one : (0 : ℝ) ≠ 1)
        (by simpa using congrFun h (ULift.up true)))
  · ext ⟨i⟩
    cases i <;> simp
  · ext ⟨i⟩
    cases i <;> simp

/-- Every positive element in a universal-disposition lattice splits into disjoint positives. -/
theorem exists_disjoint_positive_sum_of_universalDisposition {Z : Type u}
    [AddCommGroup Z] [Lattice Z] [IsOrderedAddMonoid Z] [VectorLattice Z]
    (hZ : HasCountablePrimeUniversalDisposition Z) {z : Z} (hz : 0 < z) :
    ∃ a b : Z, 0 < a ∧ 0 < b ∧ a ⊓ b = 0 ∧ a + b = z := by
  obtain ⟨a, b, ha, hb, hab, -⟩ := real_pair_positive_split.{u}
  obtain ⟨S, hS, hSz⟩ := universalDisposition_prescribed_positive hZ
    (finite_pi_spectrum (ULift.{u} Bool)).countable
    (ha.trans_le (le_add_of_nonneg_right hb.le)) hz
  refine ⟨S a, S b, ?_, ?_, ?_, (map_add S a b).symm.trans hSz⟩
  · simpa only [map_zero] using (S.monotone.strictMono_of_injective hS) ha
  · simpa only [map_zero] using (S.monotone.strictMono_of_injective hS) hb
  · exact (map_inf S a b).symm.trans ((congrArg S hab).trans (map_zero S))

/-- Every positive element in a universal-disposition lattice bounds a positive infinitesimal. -/
theorem exists_positive_forall_nsmul_le_of_universalDisposition {Z : Type u}
    [AddCommGroup Z] [Lattice Z] [IsOrderedAddMonoid Z] [VectorLattice Z]
    (hZ : HasCountablePrimeUniversalDisposition Z) {z : Z} (hz : 0 < z) :
    ∃ x : Z, 0 < x ∧ ∀ n : ℕ, n • x ≤ z := by
  let : FiniteDimensional ℝ (Lex ((ULift.{u} (Fin 2))ᵒᵈ →₀ ℝ)) :=
    inferInstanceAs (FiniteDimensional ℝ ((ULift.{u} (Fin 2))ᵒᵈ →₀ ℝ))
  obtain ⟨S, hS, hSz⟩ := universalDisposition_prescribed_positive hZ
    (finiteDimensional_ordered_countable_spectrum
      (V := Lex ((ULift.{u} (Fin 2))ᵒᵈ →₀ ℝ)))
    (colex_single_pos (ULift.up (1 : Fin 2))) hz
  refine ⟨S (toLex (Finsupp.single (ULift.up (0 : Fin 2)) 1)), ?_, fun n ↦ ?_⟩
  · convert (S.monotone.strictMono_of_injective hS)
      (colex_single_pos (ULift.up (0 : Fin 2))) using 1
    · exact (map_zero S).symm
    · congr 1
  · convert S.monotone (colex_smul_single_lt_single
      (i := ULift.up (0 : Fin 2)) (j := ULift.up 1) (by decide) (n : ℝ)).le using 1
    · rw [map_smul]
      simp only [Nat.cast_smul_eq_nsmul]
    · exact hSz.symm

/-- Products of relatively injective lattices are relatively injective. -/
theorem isCountablePrimeInjective_pi {ι : Type u} {Z : ι → Type u}
    [∀ i, AddCommGroup (Z i)] [∀ i, Lattice (Z i)]
    [∀ i, IsOrderedAddMonoid (Z i)] [∀ i, VectorLattice (Z i)]
    (hZ : ∀ i, IsCountablePrimeInjective (Z i)) :
    IsCountablePrimeInjective (∀ i, Z i) := by
  intro B _ _ _ _ hB A T
  let Ti (i : ι) : VecLatHom A (Z i) :=
    { toLinearMap := (LinearMap.proj i).comp T.toLinearMap
      map_sup' := fun a b ↦ congrFun (map_sup T a b) i
      map_inf' := fun a b ↦ congrFun (map_inf T a b) i }
  choose S hS using fun i ↦ hZ i B hB A (Ti i)
  exact ⟨{ toLinearMap := LinearMap.pi (fun i ↦ (S i).toLinearMap)
           map_sup' := fun a b ↦ funext (fun i ↦ map_sup (S i) a b)
           map_inf' := fun a b ↦ funext (fun i ↦ map_inf (S i) a b) },
    fun a ↦ funext (fun i ↦ hS i a)⟩

/-- A lattice-homomorphic retract of a relatively injective lattice is relatively injective. -/
theorem isCountablePrimeInjective_of_retract {Y Z : Type u}
    [AddCommGroup Y] [Lattice Y] [IsOrderedAddMonoid Y] [VectorLattice Y]
    [AddCommGroup Z] [Lattice Z] [IsOrderedAddMonoid Z] [VectorLattice Z]
    (hZ : IsCountablePrimeInjective Z) (i : VecLatHom Y Z) (r : VecLatHom Z Y)
    (hri : ∀ y, r (i y) = y) : IsCountablePrimeInjective Y := by
  intro B _ _ _ _ hB A T
  obtain ⟨S, hS⟩ := hZ B hB A (i.comp T)
  exact ⟨r.comp S, fun a ↦ (congrArg r (hS a)).trans (hri (T a))⟩

section LexicographicExtension

attribute [local instance] PosSMulMono.toPosSMulStrictMono

variable {C : Type u} [AddCommGroup C] [LinearOrder C]
  [IsOrderedAddMonoid C] [VectorLattice C]

/-- The vector lattice structure on a lexicographic product with the real line as the minor
coordinate. -/
private instance lexProductVectorLattice : VectorLattice (C ×ₗ ℝ) where
  toModule := inferInstance
  smul_le_smul_of_nonneg_left := by
    intro r hr x y hxy
    rcases hr.eq_or_lt with rfl | hr
    · simp only [zero_smul, le_refl]
    · rcases Prod.Lex.le_iff.mp hxy with hlt | ⟨heq, hle⟩
      · exact Prod.Lex.le_iff.mpr (Or.inl (smul_lt_smul_of_pos_left hlt hr))
      · exact Prod.Lex.le_iff.mpr (Or.inr
          ⟨congrArg (r • ·) heq, mul_le_mul_of_nonneg_left hle hr.le⟩)

/-- Embed a totally ordered vector lattice into the dominant coordinate of its lexicographic
product with the real line. -/
private def lexInl : VecLatHom C (C ×ₗ ℝ) := by
  have hm : Monotone (fun c : C ↦ (toLex (c, (0 : ℝ)) : C ×ₗ ℝ)) := by
    exact fun _ _ h ↦ Prod.Lex.le_iff.mpr
      (h.lt_or_eq.imp id (fun heq ↦ ⟨heq, le_rfl⟩))
  exact { toLinearMap := LinearMap.inl ℝ C ℝ
          map_sup' := hm.map_sup
          map_inf' := hm.map_inf }

/-- Every positive vector in the lexicographic product dominates the minor coordinate unit up
to a scalar factor. -/
private lemma lex_minor_dominated {x : C ×ₗ ℝ} (hx : 0 < x) :
    ∃ r : ℝ, toLex ((0 : C), (1 : ℝ)) ≤ r • x := by
  rcases Prod.Lex.lt_iff.mp hx with hfst | ⟨heq, hsnd⟩
  · exact ⟨1, by simpa only [one_smul] using
      (Prod.Lex.le_iff.mpr (Or.inl hfst) : toLex ((0 : C), (1 : ℝ)) ≤ x)⟩
  · refine ⟨(ofLex x).2⁻¹, Prod.Lex.le_iff.mpr (Or.inr ⟨?_, ?_⟩)⟩
    · change 0 = (ofLex x).2⁻¹ • (ofLex x).1
      simp only [← heq, ofLex_zero, Prod.fst_zero, smul_zero]
    · exact (inv_mul_cancel₀ hsnd.ne').symm.le

/-- Every nonzero ideal of the lexicographic product contains the minor coordinate unit. -/
private lemma lex_minor_mem (J : OrderIdeal (C ×ₗ ℝ)) (hJ : J ≠ ⊥) :
    toLex ((0 : C), (1 : ℝ)) ∈ J := by
  obtain ⟨x, hx, hne⟩ := J.toSubmodule.ne_bot_iff.mp
    (show J.toSubmodule ≠ ⊥ from fun h ↦ hJ (OrderIdeal.toSubmodule_injective h))
  obtain ⟨r, hr⟩ := lex_minor_dominated (abs_pos.mpr hne)
  exact J.solid (J.smul_mem r (J.abs_mem hx))
    (Prod.Lex.le_iff.mpr (Or.inr ⟨rfl, zero_le_one⟩)) hr

/-- Membership in a nonzero ideal of the lexicographic product depends only on the dominant
coordinate. -/
private lemma lex_mem_iff (J : OrderIdeal (C ×ₗ ℝ)) (hJ : J ≠ ⊥) (x : C ×ₗ ℝ) :
    x ∈ J ↔ lexInl (ofLex x).1 ∈ J := by
  have hy := J.smul_mem (ofLex x).2 (lex_minor_mem J hJ)
  have heq : lexInl (ofLex x).1 + (ofLex x).2 • toLex ((0 : C), (1 : ℝ)) = x := by
    change ((ofLex x).1, (0 : ℝ)) + (ofLex x).2 • ((0 : C), (1 : ℝ)) = ofLex x
    ext <;> simp
  exact (congrArg (· ∈ J) heq.symm).to_iff.trans (J.toSubmodule.add_mem_iff_left hy)

/-- Every ideal of a totally ordered vector lattice is prime. -/
private lemma ordered_ideal_isPrime (J : OrderIdeal C) : J.IsPrime := by
  intro a b hab
  exact (min_choice a b).elim
    (fun h ↦ Or.inl ((h.symm.trans hab).symm ▸ J.zero_mem))
    (fun h ↦ Or.inr ((h.symm.trans hab).symm ▸ J.zero_mem))

/-- A totally ordered vector lattice with countable spectrum has only countably many ideals,
including the whole lattice. -/
private lemma countable_ordered_ideals (hC : (properPrimeIdeals C).Countable) :
    Countable (OrderIdeal C) := by
  refine Set.countable_univ_iff.mp ((hC.insert ⊤).mono (fun J _ ↦ ?_))
  exact (eq_or_ne J ⊤).elim (fun h ↦ Or.inl h)
    (fun h ↦ Or.inr ⟨h, ordered_ideal_isPrime J⟩)

/-- Adding a minor real coordinate by a lexicographic product preserves countability of the
spectrum. -/
private lemma lex_countable_spectrum (hC : (properPrimeIdeals C).Countable) :
    (properPrimeIdeals (C ×ₗ ℝ)).Countable := by
  classical
  let := countable_ordered_ideals hC
  let code (J : OrderIdeal (C ×ₗ ℝ)) : Bool × OrderIdeal C :=
    (decide (J = ⊥), idealPreimage lexInl J)
  have hinj : Function.Injective code := by
    intro J K h
    have hbot : J = ⊥ ↔ K = ⊥ := by
      simpa only [code, decide_eq_decide] using congrArg Prod.fst h
    by_cases hJ : J = ⊥
    · exact hJ.trans (hbot.mp hJ).symm
    · exact SetLike.ext (fun x ↦ (lex_mem_iff J hJ x).trans
        (((congrArg (fun I : OrderIdeal C ↦ (ofLex x).1 ∈ I)
          (congrArg Prod.snd h)).to_iff).trans
            (lex_mem_iff K (hJ ∘ hbot.mpr) x).symm))
  let : Countable (OrderIdeal (C ×ₗ ℝ)) := hinj.countable
  exact Set.to_countable _

/-- A homomorphism from the lexicographic product is injective if it does not annihilate the
minor coordinate unit. -/
private lemma lex_hom_injective {Z : Type u}
    [AddCommGroup Z] [Lattice Z] [IsOrderedAddMonoid Z] [VectorLattice Z]
    (S : VecLatHom (C ×ₗ ℝ) Z) (hS : S (toLex (0, 1)) ≠ 0) :
    Function.Injective S := by
  have hker : OrderIdeal.ofKerVecLatHom S = ⊥ := by
    by_contra h
    exact hS (lex_minor_mem (OrderIdeal.ofKerVecLatHom S) h)
  exact LinearMap.ker_eq_bot.mp
    (congrArg (fun J : OrderIdeal (C ×ₗ ℝ) ↦ J.toSubmodule) hker)

/-- Every nonzero relatively injective lattice contains every chain with countable spectrum. -/
theorem exists_injective_hom_of_isCountablePrimeInjective {Z : Type u}
    [AddCommGroup Z] [Lattice Z] [IsOrderedAddMonoid Z] [VectorLattice Z] [Nontrivial Z]
    (hZ : IsCountablePrimeInjective Z) (hC : (properPrimeIdeals C).Countable) :
    ∃ T : VecLatHom C Z, Function.Injective T := by
  obtain ⟨z, hz⟩ := exists_ne (0 : Z)
  have he : (0 : C ×ₗ ℝ) < toLex (0, 1) :=
    Prod.Lex.lt_iff.mpr (Or.inr ⟨rfl, zero_lt_one⟩)
  obtain ⟨S, hS⟩ := countable_injective_extend_map hZ (lex_countable_spectrum hC)
    (positiveScalarHom _ he.le) (smul_left_injective ℝ he.ne')
    (positiveScalarHom |z| (abs_nonneg z))
  have hSe : S (toLex (0, 1)) = |z| := by
    simpa only [one_smul] using
      (show S ((1 : ℝ) • toLex (0, 1)) = (1 : ℝ) • |z| from hS 1)
  refine ⟨S.comp lexInl, (lex_hom_injective S
    (fun h ↦ hz ((abs_eq_zero_iff_zero z).mp (hSe.symm.trans h)))).comp ?_⟩
  exact fun _ _ h ↦ congrArg (fun x : C ×ₗ ℝ ↦ (ofLex x).1) h

end LexicographicExtension

section OrdinalChainExtension

variable {ι Z : Type u} [LinearOrder ι] [OrderBot ι] [WellFoundedLT ι]
  [AddCommGroup Z] [Lattice Z] [IsOrderedAddMonoid Z] [VectorLattice Z]

/-- The condition that the domain of a partial linear map is solid, and hence an order ideal. -/
private def HasIdealDomain (f : Lex (ιᵒᵈ →₀ ℝ) →ₗ.[ℝ] Z) : Prop :=
  ∀ {x y}, x ∈ f.domain → 0 ≤ y → y ≤ x → y ∈ f.domain

/-- The domain of a partial linear map, bundled as an order ideal using its solidity. -/
private def partialDomainIdeal (f : Lex (ιᵒᵈ →₀ ℝ) →ₗ.[ℝ] Z) (hf : HasIdealDomain f) :
    OrderIdeal (Lex (ιᵒᵈ →₀ ℝ)) where
  toVectorSublattice := submoduleSublattice f.domain
  solid' := hf

omit [OrderBot ι] [WellFoundedLT ι] in
/-- The domain of the union of a nonempty directed family of partial maps with ideal domains
is again an ideal. -/
private lemma idealDomain_sSup (S : Set (Lex (ιᵒᵈ →₀ ℝ) →ₗ.[ℝ] Z))
    (hS : DirectedOn (· ≤ ·) S) (hne : S.Nonempty)
    (hdom : ∀ f ∈ S, HasIdealDomain f) : HasIdealDomain (LinearPMap.sSup S hS) := by
  intro x y hx hy0 hyx
  obtain ⟨f, hf, hxf⟩ := (LinearPMap.mem_domain_sSup_iff hne hS).mp hx
  exact (LinearPMap.le_sSup hS hf).1 (hdom f hf hxf hy0 hyx)

/-- Extend an ideal-domain embedding far enough to include one prescribed coordinate. -/
private lemma colex_extend_to_coordinate
    (hι : ∀ i : ι, (Set.Iic i).Countable) (hZ : IsCountablePrimeInjective Z)
    (f : Lex (ιᵒᵈ →₀ ℝ) →ₗ.[ℝ] Z) (hf : StrictMono f) (hideal : HasIdealDomain f)
    (hbot : toLex (Finsupp.single (⊥ : ι) 1) ∈ f.domain)
    (hpos : 0 < f ⟨toLex (Finsupp.single (⊥ : ι) 1), hbot⟩) (i : ι) :
    ∃ g : Lex (ιᵒᵈ →₀ ℝ) →ₗ.[ℝ] Z, f ≤ g ∧ StrictMono g ∧ HasIdealDomain g ∧
      toLex (Finsupp.single i 1) ∈ g.domain := by
  by_cases hi : toLex (Finsupp.single i 1) ∈ f.domain
  · exact ⟨f, le_rfl, hf, hideal, hi⟩
  · let J := partialDomainIdeal f hideal
    let D := (colexCutIdeal (Set.Iic i) (isLowerSet_Iic i)).toVectorSublattice
    have hJD : J.toVectorSublattice ≤ D := fun x hx ↦
      (Finsupp.mem_supported' ℝ (ofLex x)).mpr (fun j hj ↦ not_ne_iff.mp (fun hxj ↦
        hi ((colex_coordinates_lower J) (le_of_lt (lt_of_not_ge hj))
          (colex_coordinate_mem J hx j hxj))))
    let T : VecLatHom J.toVectorSublattice Z :=
      { toLinearMap := f.toFun
        map_sup' := hf.monotone.map_sup
        map_inf' := hf.monotone.map_inf }
    obtain ⟨S, hS⟩ := countable_injective_extend_map hZ
      (colex_supported_countable_spectrum (Set.Iic i) (hι i))
      (VectorSublattice.inclusion hJD) (VectorSublattice.inclusion_injective hJD) T
    have hSi : Function.Injective S := colex_stage_map_injective D (hJD hbot) S
      ((hS ⟨_, hbot⟩).symm ▸ hpos)
    exact ⟨⟨D.toSubmodule, S.toLinearMap⟩,
      ⟨hJD, fun {x y} hxy ↦ (hS x).symm.trans (congrArg S (Subtype.ext hxy))⟩,
      S.monotone.strictMono_of_injective hSi,
      colex_supported_solid (Set.Iic i) (isLowerSet_Iic i),
      (colexCutIdeal_single_mem_iff (Set.Iic i) (isLowerSet_Iic i) i).mpr le_rfl⟩

/-- Take the union of the earlier compatible embeddings, then include the next coordinate. -/
private lemma colex_recursive_step_exists
    (hι : ∀ i : ι, (Set.Iic i).Countable) (hZ : IsCountablePrimeInjective Z)
    (f : Lex (ιᵒᵈ →₀ ℝ) →ₗ.[ℝ] Z) (hf : StrictMono f) (hideal : HasIdealDomain f)
    (hbot : toLex (Finsupp.single (⊥ : ι) 1) ∈ f.domain)
    (hpos : 0 < f ⟨toLex (Finsupp.single (⊥ : ι) 1), hbot⟩) (i : ι)
    (p : Set.Iio i → Lex (ιᵒᵈ →₀ ℝ) →ₗ.[ℝ] Z) (hmono : Monotone p)
    (hp : ∀ j, f ≤ p j ∧ StrictMono (p j) ∧ HasIdealDomain (p j)) :
    ∃ g : Lex (ιᵒᵈ →₀ ℝ) →ₗ.[ℝ] Z,
      (f ≤ g ∧ StrictMono g ∧ HasIdealDomain g ∧ toLex (Finsupp.single i 1) ∈ g.domain) ∧
      ∀ j, p j ≤ g := by
  have hdir : DirectedOn (· ≤ ·) (insert f (Set.range p)) :=
    hmono.directed_le.directedOn_range.insert f (fun g hg ↦
      ⟨g, hg, hg.elim (fun j hj ↦ hj ▸ (hp j).1), le_rfl⟩)
  have hpast : ∀ g ∈ insert f (Set.range p), StrictMono g ∧ HasIdealDomain g :=
    fun g hg ↦ hg.elim (fun h ↦ h.symm ▸ And.intro hf hideal)
      (fun ⟨j, hj⟩ ↦ hj ▸ (hp j).2)
  let U := LinearPMap.sSup (insert f (Set.range p)) hdir
  have hfU : f ≤ U := LinearPMap.le_sSup hdir (Set.mem_insert f _)
  obtain ⟨g, hUg, hg, hideal, hi⟩ := colex_extend_to_coordinate hι hZ U
    (strictMono_sSup_partial _ hdir ⟨f, Set.mem_insert f _⟩ (fun g hg ↦ (hpast g hg).1))
    (idealDomain_sSup _ hdir ⟨f, Set.mem_insert f _⟩ (fun g hg ↦ (hpast g hg).2))
    (hfU.1 hbot) ((show f ⟨_, hbot⟩ = U ⟨_, hfU.1 hbot⟩ from hfU.2 rfl) ▸ hpos) i
  exact ⟨g, ⟨hfU.trans hUg, hg, hideal, hi⟩,
    fun j ↦ (LinearPMap.le_sSup hdir
      (Set.mem_insert_of_mem _ (Set.mem_range_self j))).trans hUg⟩

/-- Recursively choose compatible embeddings, adjoining each coordinate after the earlier union. -/
private lemma colex_recursive_family
    (hι : ∀ i : ι, (Set.Iic i).Countable) (hZ : IsCountablePrimeInjective Z)
    (f : Lex (ιᵒᵈ →₀ ℝ) →ₗ.[ℝ] Z) (hf : StrictMono f) (hideal : HasIdealDomain f)
    (hbot : toLex (Finsupp.single (⊥ : ι) 1) ∈ f.domain)
    (hpos : 0 < f ⟨toLex (Finsupp.single (⊥ : ι) 1), hbot⟩) :
    ∃ g : ι → Lex (ιᵒᵈ →₀ ℝ) →ₗ.[ℝ] Z, Monotone g ∧
      ∀ i, f ≤ g i ∧ StrictMono (g i) ∧ HasIdealDomain (g i) ∧
        toLex (Finsupp.single i 1) ∈ (g i).domain := by
  classical
  let Q (i : ι) (g : Lex (ιᵒᵈ →₀ ℝ) →ₗ.[ℝ] Z) : Prop :=
    f ≤ g ∧ StrictMono g ∧ HasIdealDomain g ∧ toLex (Finsupp.single i 1) ∈ g.domain
  let step (i : ι) (past : ∀ j, j < i → Lex (ιᵒᵈ →₀ ℝ) →ₗ.[ℝ] Z) :=
    if h : ∃ g, Q i g ∧ ∀ j (hj : j < i), past j hj ≤ g then h.choose else f
  let g := WellFoundedLT.fix step
  suffices hg : ∀ i, Q i (g i) ∧ ∀ j, j < i → g j ≤ g i by
    exact ⟨g, fun i j hij ↦ hij.eq_or_lt.elim (fun h ↦ h ▸ le_rfl)
      (fun h ↦ (hg j).2 i h), fun i ↦ (hg i).1⟩
  intro i
  induction i using WellFoundedLT.induction with
  | ind i ih =>
    let p : Set.Iio i → Lex (ιᵒᵈ →₀ ℝ) →ₗ.[ℝ] Z := fun j ↦ g j.val
    have hm : Monotone p := fun j k hjk ↦ hjk.eq_or_lt.elim
      (fun h ↦ h ▸ le_rfl) (fun h ↦ (ih k.val k.property).2 j.val h)
    obtain ⟨r, hr, hprev⟩ := colex_recursive_step_exists hι hZ f hf hideal hbot hpos i p hm
      (fun j ↦ ⟨(ih j.val j.property).1.1, (ih j.val j.property).1.2.1,
        (ih j.val j.property).1.2.2.1⟩)
    have hex : ∃ r, Q i r ∧ ∀ j, j < i → g j ≤ r :=
      ⟨r, hr, fun j hj ↦ hprev ⟨j, hj⟩⟩
    have heq : g i = hex.choose := (WellFoundedLT.fix_eq step i).trans (dite_eq_left hex)
    exact heq.symm ▸ hex.choose_spec


/-- The union of the recursively constructed embeddings covers every coordinate and hence
the whole lattice. -/
private lemma colex_total_partial_map
    (hι : ∀ i : ι, (Set.Iic i).Countable) (hZ : IsCountablePrimeInjective Z)
    (f : Lex (ιᵒᵈ →₀ ℝ) →ₗ.[ℝ] Z) (hf : StrictMono f) (hideal : HasIdealDomain f)
    (hbot : toLex (Finsupp.single (⊥ : ι) 1) ∈ f.domain)
    (hpos : 0 < f ⟨toLex (Finsupp.single (⊥ : ι) 1), hbot⟩) :
    ∃ g : Lex (ιᵒᵈ →₀ ℝ) →ₗ.[ℝ] Z, f ≤ g ∧ StrictMono g ∧ g.domain = ⊤ := by
  obtain ⟨g, hmono, hg⟩ := colex_recursive_family hι hZ f hf hideal hbot hpos
  let U := LinearPMap.sSup (Set.range g) hmono.directed_le.directedOn_range
  have hU : HasIdealDomain U := idealDomain_sSup _ hmono.directed_le.directedOn_range
    (Set.range_nonempty g) (fun _ ⟨i, hi⟩ ↦ hi ▸ (hg i).2.2.1)
  have hle : ∀ i, g i ≤ U := fun i ↦ LinearPMap.le_sSup
    hmono.directed_le.directedOn_range (Set.mem_range_self i)
  exact ⟨U, (hg ⊥).1.trans (hle ⊥),
    strictMono_sSup_partial _ hmono.directed_le.directedOn_range
      (Set.range_nonempty g) (fun _ ⟨i, hi⟩ ↦ hi ▸ (hg i).2.1),
    top_unique (fun x _ ↦ colex_mem_of_coordinates (partialDomainIdeal U hU) x
      (fun i _ ↦ (hle i).1 (hg i).2.2.2))⟩

omit [WellFoundedLT ι] in
/-- Start a partial colexicographic embedding on the bottom coordinate by prescribing its
positive image. -/
private lemma colex_initial_partial_map (z : Z) (hz : 0 < z) :
    ∃ f : Lex (ιᵒᵈ →₀ ℝ) →ₗ.[ℝ] Z, StrictMono f ∧ HasIdealDomain f ∧
      ∃ hbot : toLex (Finsupp.single (⊥ : ι) 1) ∈ f.domain,
        f ⟨toLex (Finsupp.single (⊥ : ι) 1), hbot⟩ = z := by
  let e : ℕ → ι := fun _ ↦ ⊥
  obtain ⟨T, hT⟩ := colexStage_initial_map e z hz.le
  refine ⟨⟨(colexStage e 0).toSubmodule, T.toLinearMap⟩,
    T.monotone.strictMono_of_injective (colex_stage_map_injective _
      (colexStage_bot_mem e 0) T (hT.symm ▸ hz)), ?_, colexStage_bot_mem e 0, hT⟩
  have hs : (insert (⊥ : ι) (e '' Set.Iio 0)) = Set.Iic (⊥ : ι) := by
    ext k
    simp
  exact fun {x y} hx hy0 hyx ↦
    colex_supported_solid (ι := ι) _ (hs.symm ▸ isLowerSet_Iic (⊥ : ι)) hx hy0 hyx

/-- Well-ordered chains with countable initial segments embed with a prescribed first coordinate. -/
theorem exists_colex_embedding_of_isCountablePrimeInjective
    (hι : ∀ i : ι, (Set.Iic i).Countable) (hZ : IsCountablePrimeInjective Z)
    (z : Z) (hz : 0 < z) :
    ∃ T : VecLatHom (Lex (ιᵒᵈ →₀ ℝ)) Z, Function.Injective T ∧
      T (toLex (Finsupp.single (⊥ : ι) 1)) = z := by
  obtain ⟨f, hf, hideal, hbot, hval⟩ := colex_initial_partial_map (ι := ι) z hz
  obtain ⟨g, hfg, hg, hdom⟩ := colex_total_partial_map hι hZ f hf hideal hbot (hval.symm ▸ hz)
  let G : Lex (ιᵒᵈ →₀ ℝ) →ₗ[ℝ] Z := g.toFun.comp
    ((LinearMap.id : Lex (ιᵒᵈ →₀ ℝ) →ₗ[ℝ] Lex (ιᵒᵈ →₀ ℝ)).codRestrict g.domain
      (fun x ↦ hdom.ge (Submodule.mem_top)))
  have hG : StrictMono G := fun _ _ hxy ↦ hg hxy
  refine ⟨{ toLinearMap := G
            map_sup' := hG.monotone.map_sup
            map_inf' := hG.monotone.map_inf }, hG.injective, ?_⟩
  exact ((hfg.2 (x := ⟨_, hbot⟩) rfl).symm.trans hval)

end OrdinalChainExtension

/-- Every closed initial segment below the first uncountable ordinal is countable. -/
private lemma omega_one_initial_segment_countable
    (i : (Cardinal.aleph.{u} 1).ord.ToType) : (Set.Iic i).Countable := by
  have hlt : Cardinal.mk ↥(Set.Iio i) < Cardinal.aleph 1 := by
    simpa using Cardinal.mk_Iio_lt i (by simp)
  have hc : (Set.Iio i).Countable := Cardinal.le_aleph0_iff_set_countable.mp
    (Cardinal.lt_aleph_one_iff.mp hlt)
  simpa only [Set.Iio_union_right] using hc.union (Set.countable_singleton i)

/-- Every nonzero relatively injective lattice contains the chain indexed by the first
uncountable ordinal. -/
theorem exists_omega_one_colex_embedding {Z : Type u}
    [AddCommGroup Z] [Lattice Z] [IsOrderedAddMonoid Z] [VectorLattice Z] [Nontrivial Z]
    (hZ : IsCountablePrimeInjective Z) :
    ∃ T : VecLatHom (Lex (((Cardinal.aleph.{u} 1).ord.ToType)ᵒᵈ →₀ ℝ)) Z,
      Function.Injective T := by
  let : Nonempty (Cardinal.aleph.{u} 1).ord.ToType := by
    simpa only [Ordinal.nonempty_toType_iff, ne_eq, Cardinal.ord_eq_zero] using
      (Cardinal.aleph_pos 1).ne'
  let : OrderBot (Cardinal.aleph.{u} 1).ord.ToType := WellFoundedLT.toOrderBot _
  obtain ⟨z, hz⟩ := exists_ne (0 : Z)
  have hpos : 0 < |z| := lt_of_le_of_ne (abs_nonneg z)
    (fun h ↦ hz ((abs_eq_zero_iff_zero z).mp h.symm))
  exact (exists_colex_embedding_of_isCountablePrimeInjective
    omega_one_initial_segment_countable hZ |z| hpos).imp (fun _ h ↦ h.1)

end VectorLattice.CountableSpectra
