import FreeProducts.CountableSpectra.Basic

/-!
# An increasing union with uncountable prime spectrum

Functions on binary sequences depending on only finitely many initial coordinates
form an increasing family of lattices with finite prime spectra. Their union has at
least continuum many proper primes, distinguished by evaluations at binary sequences.
-/

noncomputable section

universe u

namespace VectorLattice.Counterexamples

open VectorLattice.CountableSpectra

/-- Functions on binary sequences depending only on the first finitely many coordinates. -/
def cylinderFunctions (n : ℕ) : VectorSublattice ((ℕ → Bool) → ℝ) where
  carrier := {f | ∀ x y, (∀ k < n, x k = y k) → f x = f y}
  zero_mem' := fun _ _ _ ↦ rfl
  add_mem' := fun hf hg x y hxy ↦ congrArg₂ (· + ·) (hf x y hxy) (hg x y hxy)
  smul_mem' := fun r _ hf x y hxy ↦ congrArg (r • ·) (hf x y hxy)
  sup_mem' := fun hf hg x y hxy ↦ congrArg₂ (· ⊔ ·) (hf x y hxy) (hg x y hxy)

/-- Functions depending on the first n Boolean coordinates are equivalent to a finite
coordinate function lattice. -/
private def cylinderEquiv (n : ℕ) :
    VecLatEquiv (cylinderFunctions n) ((Fin n → Bool) → ℝ) := by
  let extend (s : Fin n → Bool) (k : ℕ) := if h : k < n then s ⟨k, h⟩ else false
  refine
    { toFun := fun f s ↦ f.val (extend s)
      invFun := fun f ↦ ⟨fun x ↦ f (fun i : Fin n ↦ x i),
        fun x y hxy ↦ congrArg f (funext (fun i ↦ hxy i i.isLt))⟩
      left_inv := ?_
      right_inv := fun f ↦ funext (fun s ↦
        congrArg f (funext (fun i ↦ dite_eq_left i.isLt)))
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl
      map_sup' := fun _ _ ↦ rfl
      map_inf' := fun _ _ ↦ rfl }
  intro f
  refine Subtype.ext (funext (fun x ↦ f.property _ x (fun k hk ↦ ?_)))
  exact dite_eq_left hk

/-- The lattice generated by all finite-coordinate cylinder functions has at least continuum
many proper prime ideals. -/
private lemma cylinder_union_spectrum_cardinal :
    Cardinal.continuum ≤ Cardinal.mk ↥(properPrimeIdeals
      (VectorSublattice.generated (⋃ n, (cylinderFunctions n : Set ((ℕ → Bool) → ℝ))))) := by
  let U := VectorSublattice.generated (⋃ n, (cylinderFunctions n : Set ((ℕ → Bool) → ℝ)))
  let ev (x : ℕ → Bool) : VecLatHom U ℝ :=
    { toFun := fun f ↦ f.val x
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl
      map_sup' := fun _ _ ↦ rfl
      map_inf' := fun _ _ ↦ rfl }
  let unit : U := ⟨fun _ ↦ 1, VectorSublattice.subset_generated _
    (Set.mem_iUnion.mpr ⟨0, fun _ _ _ ↦ rfl⟩)⟩
  let J (x : ℕ → Bool) : properPrimeIdeals U :=
    ⟨OrderIdeal.ofKerVecLatHom (ev x), normalized_character_kernel_prime (ev x) unit rfl⟩
  have hcard : Cardinal.mk (ℕ → Bool) = Cardinal.continuum := by
    simp only [Cardinal.mk_arrow, Cardinal.mk_bool, Cardinal.mk_nat, Cardinal.lift_id,
      Cardinal.two_power_aleph0]
  refine hcard.symm.trans_le (Cardinal.mk_le_of_injective (f := J) (fun x y hxy ↦ ?_))
  funext n
  let f : U := ⟨fun z ↦ if z n then 1 else 0, VectorSublattice.subset_generated _
    (Set.mem_iUnion.mpr ⟨n + 1, fun s t hst ↦
      congrArg (fun b : Bool ↦ if b then (1 : ℝ) else 0) (hst n (Nat.lt_succ_self n))⟩)⟩
  have hm : (if x n then (1 : ℝ) else 0) = 0 ↔ (if y n then (1 : ℝ) else 0) = 0 :=
    (congrArg (fun I : properPrimeIdeals U ↦ f ∈ I.val) hxy).to_iff
  cases hx : x n <;> cases hy : y n <;> simp [hx, hy] at hm ⊢

/-- An increasing sequence of lattices with finite spectra can have
a union with at least continuum many proper primes. -/
theorem cylinder_union_uncountable_spectrum :
    Monotone cylinderFunctions ∧
      (∀ n, (properPrimeIdeals (cylinderFunctions n)).Finite) ∧
      Cardinal.continuum ≤ Cardinal.mk ↥(properPrimeIdeals
        (VectorSublattice.generated
          (⋃ n, (cylinderFunctions n : Set ((ℕ → Bool) → ℝ))))) := by
  exact ⟨fun n m hnm f hf x y hxy ↦
    hf x y (fun k hk ↦ hxy k (hk.trans_le hnm)),
    fun n ↦ finite_spectrum_of_equiv (cylinderEquiv n) (finite_pi_spectrum _),
    cylinder_union_spectrum_cardinal⟩

end VectorLattice.Counterexamples
